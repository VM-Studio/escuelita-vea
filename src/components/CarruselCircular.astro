---
/*
 * Carrusel circular (cilindro 3D con CSS) — basado en "CircularCarousel" de React Bits (David Haz,
 * MIT + Commons Clause). La geometría se calcula acá (build) y la animación en scripts/reactbits/carrusel-circular.ts.
 * Sin JS o en modo liviano: se muestra una tira de fotos simple.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { geometria, type Preset } from '../scripts/reactbits/carrusel-circular';
import { fotos as registro } from '../data/fotos.mjs';
import Foto from './Foto.astro';

interface Props {
  ids: string[];
  preset?: Preset;
  cardWidth?: number;
  aspectRatio?: number;
  gap?: number;
  alto?: string;
  fadeColor?: string;
  cornerRadius?: number;
  etiqueta?: string;
  class?: string;
  speed?: number;
  intro?: 'rise' | 'assemble' | 'spin' | 'none';
}
const { ids, preset = 'cylinder', cardWidth = 210, aspectRatio = 0.8, gap = 24, alto = 'clamp(18rem, 32vw, 27rem)', fadeColor = '#faf6ee', cornerRadius = 8, etiqueta = 'Galería de fotos', class: clase = '', speed = 20, intro = 'rise' } = Astro.props;

const masters = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos/*.jpg', { eager: true });
const items = await Promise.all(ids.map(async (id) => {
  const src = masters[`../assets/fotos/${id}.jpg`]?.default;
  const img = src ? await getImage({ src, width: Math.round(cardWidth * 2.2), height: Math.round((cardWidth / aspectRatio) * 2.2), fit: 'cover', format: 'webp' }) : null;
  return { id, src: img?.src ?? '', alt: registro.find((f) => f.id === id)?.alt ?? '' };
}));
const g = geometria({ count: items.length, preset, cardWidth, aspectRatio, gap });
const config = {
  count: items.length, preset, cardWidth, aspectRatio, gap,
  intro, autoplay: 'drift', speed, interval: 3, direction: 'left',
  draggable: true, momentum: 0.6, snap: true, pauseOnHover: false, focusOnClick: false,
  parallax: 0.3, stretch: 0.5, depthFade: 0.55,
};
const { axis } = g;
---
<div class:list={['cc-envoltura', clase]} style={`--cc-alto:${alto}`}>
  <div
    class="circular-carousel"
    data-carrusel-circular
    data-config={JSON.stringify(config)}
    data-axis={axis}
    data-shape={preset}
    data-draggable
    style={`--cc-fade:${fadeColor};--cc-radius:${cornerRadius}px;--cc-inner:0.4`}
    role="region"
    aria-roledescription="carrusel"
    aria-label={`${etiqueta}. Arrastrá o usá las flechas del teclado para girar.`}
    tabindex="0"
  >
    <div class="circular-carousel__view">
      <div class="circular-carousel__stage" data-cc-stage>
        <div class="circular-carousel__camera" data-cc-camera>
          <div class="circular-carousel__ring" data-cc-ring>
            {items.map((item, index) => (
              <div class="circular-carousel__card" data-cc-index={index} data-src={item.src} role="group" aria-roledescription="diapositiva" aria-label={`${item.alt} (${index + 1} de ${items.length})`}></div>
            ))}
          </div>
        </div>
      </div>
    </div>
    <div class="circular-carousel__live" aria-live="polite" aria-atomic="true" data-cc-live></div>
  </div>

  {/* Sin JS / modo liviano: tira simple con las mismas fotos */}
  <div class="cc-simple" aria-label={etiqueta}>
    {ids.slice(0, 6).map((id) => <Foto id={id} ratio="4/5" sizes="(min-width: 48em) 16vw, 40vw" />)}
  </div>
</div>

<script>
  import { iniciarCarruselesCirculares } from '../scripts/reactbits/carrusel-circular';
  if (!document.documentElement.classList.contains('liviano')) iniciarCarruselesCirculares();
</script>

<style is:global>
  .cc-envoltura { position: relative; }
  .circular-carousel { display: none; }
  html.js:not(.liviano) .circular-carousel { display: block; }
  html.js:not(.liviano) .cc-simple { display: none; }
  .cc-simple { display: grid; grid-template-columns: repeat(3, 1fr); grid-gap: 0.75rem; gap: 0.75rem; }
  @media (min-width: 48em) { .cc-simple { grid-template-columns: repeat(6, 1fr); } }
  .cc-simple .foto { border-radius: 6px; }

  /* --- CSS original de CircularCarousel (React Bits), adaptado --- */
  .circular-carousel {
    position: relative;
    width: 100%;
    height: var(--cc-alto);
    overflow: hidden;
    outline: none;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    cursor: grab;
  }
  .circular-carousel[data-dragging] { cursor: grabbing; }
  .circular-carousel:focus-visible { box-shadow: inset 0 0 0 2px var(--rojo); border-radius: 8px; }
  .circular-carousel__view { position: absolute; top: 0; left: 0; right: 0; bottom: 0; }
  .circular-carousel__stage {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    display: flex; align-items: center; justify-content: center;
    opacity: 0; transition: opacity 0.45s ease;
  }
  .circular-carousel[data-ready] .circular-carousel__stage { opacity: 1; }
  .circular-carousel__camera, .circular-carousel__ring, .circular-carousel__card { width: 0; height: 0; transform-style: preserve-3d; }
  .circular-carousel__camera { position: relative; }
  .circular-carousel__ring, .circular-carousel__card { position: absolute; left: 0; top: 0; }
  .circular-carousel__tile { position: absolute; outline: 1px solid transparent; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .circular-carousel__frame { position: absolute; left: 0; top: 0; width: 100%; overflow: hidden; }
  .circular-carousel__photo { position: absolute; display: block; max-width: none; object-fit: cover; pointer-events: none; user-select: none; -webkit-user-drag: none; }
  .circular-carousel__shade, .circular-carousel__inner { position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none; }
  .circular-carousel__shade { background: var(--cc-fade); opacity: var(--cc-depth, 0); }
  .circular-carousel__inner { background: #000; opacity: var(--cc-inner); }
  .circular-carousel__live { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { .circular-carousel__stage { transition: none; } }
</style>
