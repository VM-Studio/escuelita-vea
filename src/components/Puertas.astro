---
import { acento } from '../lib/texto';
// Dos puertas: Jardín y Primaria. Paneles grandes con foto, una línea (texto institucional) y botón.
import Foto from './Foto.astro';
import Trazo from './Trazo.astro';
import { jardin } from '../content/jardin';
import { primaria } from '../content/primaria';
interface Props { titulo?: string; fotoJardin?: string; fotoPrimaria?: string }
const { titulo, fotoJardin = 'jardin-risas-patio', fotoPrimaria = 'primaria-leyenda-quillangos' } = Astro.props;
const puertas = [
  { nivel: 'jardin', nombre: 'Jardín', linea: jardin.portada.titulo, href: '/jardin/', boton: 'Conocé el Jardín', foto: fotoJardin, trazo: 'sol' as const, color: 'ocre' as const },
  { nivel: 'primaria', nombre: 'Primaria', linea: primaria.portada.subtitulo, href: '/primaria/', boton: 'Conocé la Primaria', foto: fotoPrimaria, trazo: 'hoja' as const, color: 'verde' as const },
];
---
<section class="puertas seccion" aria-label={titulo ?? 'Jardín y Primaria'}>
  <div class="contenedor">
    {titulo && <h2 class="puertas__titulo" data-titulo-lineas set:html={acento(titulo)} />}
    <div class="puertas__grilla">
      {puertas.map((p) => (
        <a href={p.href} class:list={['puerta', `puerta--${p.nivel}`]} data-revelar data-inclinar='{"amplitude":7,"scale":1.02}'>
          <div class="puerta__foto">
            <Foto id={p.foto} ratio="4/3" sizes="(min-width: 48em) 40vw, 94vw" />
          </div>
          <div class="puerta__velo" aria-hidden="true"></div>
          <div class="puerta__brillo" aria-hidden="true"></div>
          <div class="puerta__texto">
            <Trazo nombre={p.trazo} color="arena" class="puerta__trazo" grosor={2.2} />
            <span class="puerta__nivel">{p.nombre}</span>
            <span class="puerta__linea">{p.linea}</span>
            <span class="boton boton--claro puerta__boton">
              <span>{p.boton}</span>
              <svg class="boton__flecha" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5 C 9 12, 14 12.2, 19 12 M14 6.5 C 16 9, 18 11, 19.5 12 C 18 13.2, 16 15, 14 17.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  import { iniciarInclinaciones } from '../scripts/reactbits/inclinacion';
  iniciarInclinaciones();
</script>

<style>
  .puertas__titulo { margin-bottom: 1.7rem; max-width: 18ch; }
  .puertas__grilla { display: grid; grid-template-columns: 1fr; grid-gap: 1.25rem; gap: 1.25rem; }
  @media (min-width: 48em) { .puertas__grilla { grid-template-columns: 1fr 1fr; grid-gap: 1.275rem; gap: 1.275rem; } }
  .puerta {
    position: relative; display: block; overflow: hidden;
    border-radius: var(--radio-lg);
    color: var(--papel); text-decoration: none;
    isolation: isolate;
  }
  .puerta { transform-style: preserve-3d; will-change: transform; }
  .puerta__brillo { position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none; opacity: var(--tc-glare, 0); background: radial-gradient(circle at var(--tc-gx, 50%) var(--tc-gy, 50%), rgba(255, 250, 240, 0.55), rgba(255, 250, 240, 0) 55%); mix-blend-mode: soft-light; }
  .puerta__foto :global(img) { transition: transform 1.6s var(--ease-out), opacity 0.7s var(--ease-suave); }
  .puerta__velo {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to top, rgba(20, 16, 12, 0.78) 0%, rgba(20, 16, 12, 0.3) 45%, rgba(20, 16, 12, 0) 72%);
  }
  .puerta--jardin .puerta__velo { background: linear-gradient(to top, rgba(60, 36, 8, 0.82) 0%, rgba(60, 36, 8, 0.3) 45%, rgba(60, 36, 8, 0) 72%); }
  .puerta--primaria .puerta__velo { background: linear-gradient(to top, rgba(20, 44, 22, 0.82) 0%, rgba(20, 44, 22, 0.3) 45%, rgba(20, 44, 22, 0) 72%); }
  .puerta__texto {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 1.275rem;
    padding: clamp(1.25rem, 2.1vw, 1.7rem);
    display: flex; flex-direction: column; align-items: flex-start;
  }
  .puerta__trazo { width: 2.4rem; height: 2.4rem; margin-bottom: 0.5rem; }
  .puerta__nivel {
    font-family: var(--f-titulo);
    font-size: 2.15rem;
    font-size: clamp(2.15rem, 1.312rem + 2.376vw, 3.135rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .puerta__linea { margin-top: 0.6rem; max-width: 28ch; font-family: var(--f-frase); font-style: italic; font-size: 0.978rem; font-size: clamp(0.978rem, 0.779rem + 0.42vw, 1.155rem); line-height: 1.35; }
  .puerta__boton { margin-top: 1.25rem; }
  @media (hover: hover) {
    .puerta:hover .puerta__foto :global(img) { transform: scale(1.045); }
    .puerta:hover .puerta__boton { color: var(--tinta); }
    .puerta:hover .puerta__boton::before { transform: translateX(0) skewX(-12deg); }
    .puerta:hover .boton__flecha { transform: translateX(4px); }
  }
  .puerta:focus-visible .puerta__boton { color: var(--tinta); }
  .puerta:focus-visible .puerta__boton::before { transform: translateX(0) skewX(-12deg); }
</style>
