---
// Galería de obras de los chicos (idea del "Hall of Fame" de cascos de landonorris.com, adaptada):
// fondo tinta, grilla de celdas finas, cada obra con su rótulo de taller/grado, hover que la levanta.
import Foto from './Foto.astro';
import Topografia from './Topografia.astro';
interface Obra { id: string; rotulo: string; detalle?: string }
interface Props { titulo: string; acento?: string; bajada?: string; obras: Obra[]; enlace?: { href: string; texto: string } }
const { titulo, acento, bajada, obras, enlace } = Astro.props;
---
<section class="obras" aria-labelledby="obras-titulo">
  <Topografia semilla={11} opacidad={0.08} />
  <div class="contenedor"><div class="obras__cabeza cabeza-regla">
    <h2 id="obras-titulo" class="obras__titulo" data-revelar>{titulo}{acento && <>{" "}<em class="acento">{acento}</em></>}</h2>
    {bajada && <p class="obras__bajada" data-revelar>{bajada}</p>}
  </div></div>
  <div class="contenedor">
    <ul class="obras__grilla">
      {obras.map((o) => (
        <li class="obra" data-revelar>
          <figure class="obra__tarjeta">
            <div class="obra__marco"><Foto id={o.id} ratio="1/1" sizes="(min-width: 64em) 22vw, 46vw" /></div>
            <figcaption class="obra__pie"><span class="obra__rotulo">{o.rotulo}</span>{o.detalle && <span class="obra__det">{o.detalle}</span>}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
    {enlace && <p class="obras__mas" data-revelar><a href={enlace.href} class="obras__enlace">{enlace.texto} <span aria-hidden="true">→</span></a></p>}
  </div>
</section>

<style>
  .obras { position: relative; overflow: hidden; background: var(--piedra); color: var(--tinta); padding: 3.5rem 0; padding: clamp(3rem, 2rem + 3vw, 5rem) 0; }
  .obras__cabeza { position: relative; border-bottom-color: rgba(35, 32, 28, 0.55); }
  .obras__titulo { color: var(--tinta); font-size: 1.8rem; font-size: clamp(1.7rem, 1.1rem + 2vw, 2.8rem); font-weight: 330; letter-spacing: -0.03em; line-height: 1; margin: 0 2rem 0 0; }
  
  .obras__bajada { max-width: 24rem; font-size: 0.875rem; color: var(--tinta-suave); margin-bottom: 0.75rem; }
  .obras__grilla { position: relative; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); grid-gap: 0.75rem; gap: 0.75rem; align-items: stretch; }
  @media (min-width: 48em) { .obras__grilla { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 64em) { .obras__grilla { grid-template-columns: repeat(4, 1fr); grid-gap: 1rem; gap: 1rem; } }
  .obra { display: flex; }
  .obra__tarjeta { width: 100%; margin: 0; overflow: hidden; background: #fff; box-shadow: 0 1px 2px rgba(35, 32, 28, 0.06), 0 18px 40px -26px rgba(35, 32, 28, 0.45); transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out); }
  .obra__marco { overflow: hidden; }
  .obra__marco :global(img) { transition: transform 0.8s var(--ease-out); }
  .obra__pie { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 1rem 0.75rem 1.15rem; }
  .obra__rotulo { font-family: var(--f-titulo); font-size: 1rem; font-size: clamp(0.95rem, 0.8rem + 0.5vw, 1.3rem); font-weight: 400; letter-spacing: 0.06em; text-transform: uppercase; line-height: 1.15; color: var(--tinta); }
  .obra__det { margin-top: 0.35rem; font-size: 0.8125rem; color: var(--tinta-suave); }
  @media (hover: hover) {
    .obra:hover .obra__tarjeta { transform: translateY(-4px); box-shadow: 0 1px 2px rgba(35, 32, 28, 0.06), 0 26px 50px -28px rgba(35, 32, 28, 0.55); }
    .obra:hover .obra__marco :global(img) { transform: scale(1.04); }
  }
  .obras__mas { margin-top: 2rem; }
  .obras__enlace { display: inline-flex; align-items: center; padding: 0.55rem 1rem; border-radius: 999px; background: var(--tinta); color: var(--papel); font-size: 0.8125rem; font-weight: 650; text-decoration: none; transition: transform 0.3s var(--ease-out); }
  .obras__enlace:hover { transform: translateX(3px); }
</style>
