---
import { NAV, NIVELES } from '../config/sitio';
import Logo from './Logo.astro';
import { hayLogoPrimaria } from '../lib/logos';

interface Props { sobreHero?: boolean }
const { sobreHero = false } = Astro.props;
const ruta = Astro.url.pathname.replace(/\/?$/, '/');
const activo = (href: string) => (href === '/' ? ruta === '/' : ruta.startsWith(href));
const activoItem = (item: (typeof NAV)[number]) => ('activoEn' in item ? item.activoEn.some((r) => (r === '/' ? ruta === '/' : ruta.startsWith(r))) : activo(item.href));
const idSub = (texto: string) => `submenu-${texto.toLowerCase().normalize('NFD').replace(/[^a-z]/g, '')}`;
const conPrimaria = hayLogoPrimaria();
---
<header class:list={['encabezado', { 'encabezado--hero': sobreHero }]} data-encabezado>
  <div class="encabezado__barra contenedor">
    {/* Logos del Jardín y de la Primaria juntos (llevan al Inicio); V.E.A. va al final de la botonera (rev. 25-11-2026) */}
    <a href="/" class="encabezado__logo" aria-label="La Escuelita · Inicio">
      <span class="marca"><Logo nivel="jardin" alto={84} decorativo prioridad />{conPrimaria && <><span class="marca__sep" aria-hidden="true"></span><Logo nivel="primaria" alto={64} decorativo prioridad /></>}</span>
    </a>

    <nav class="nav" aria-label="Principal">
      <ul class="nav__lista">
        {NAV.map((item) => (
          <li class:list={['nav__item', { 'nav__item--padre': 'hijos' in item }]}>
            {'hijos' in item ? (
              <>
                <a href={item.href} class="nav__enlace enlace-trazo" aria-current={activoItem(item) ? 'page' : undefined}>
                  {item.texto}
                </a>
                <button class="nav__flechita" type="button" aria-expanded="false" aria-controls={idSub(item.texto)} data-submenu-boton>
                  <span class="sr-only">Abrir submenú de {item.texto}</span>
                  <svg viewBox="0 0 12 8" width="12" height="8" aria-hidden="true"><path d="M1 1.5 L6 6.5 L11 1.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                </button>
                <ul class="submenu" id={idSub(item.texto)} data-submenu>
                  {item.hijos.map((h) => (
                    <li><a href={h.href} class="submenu__enlace" aria-current={ruta === h.href ? 'page' : undefined}>{h.texto}</a></li>
                  ))}
                </ul>
              </>
            ) : (
              <a href={item.href} class="nav__enlace enlace-trazo" aria-current={activoItem(item) ? 'page' : undefined}>{item.texto}</a>
            )}
          </li>
        ))}
        <li class="nav__item nav__item--vea"><Logo nivel="vea" alto={58} prioridad class="nav__vea" /></li>
      </ul>
    </nav>

    <button class="hamburguesa" type="button" aria-expanded="false" aria-controls="menu-movil" data-menu-boton>
      <span class="sr-only" data-menu-texto>Abrir menú</span>
      <span class="hamburguesa__lineas" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>
</header>

<div class="menu-movil" id="menu-movil" data-menu hidden>
  <div class="menu-movil__papel" aria-hidden="true"></div>
  <nav class="menu-movil__nav contenedor" aria-label="Menú">
    <ul class="menu-movil__lista">
      {NAV.map((item) => (
        <li data-menu-item>
          <a href={item.href} class="menu-movil__enlace" aria-current={activoItem(item) ? 'page' : undefined}>{item.texto}</a>
          {'hijos' in item && (
            <ul class="menu-movil__sub">
              {item.hijos.map((h) => <li><a href={h.href}>{h.texto}</a></li>)}
            </ul>
          )}
        </li>
      ))}
    </ul>
    <div class="menu-movil__vea" data-menu-item><Logo nivel="vea" alto={64} /></div>
    <div class="menu-movil__pie" data-menu-item>
      <div class="menu-movil__contactos">
        <a href={NIVELES.jardin.whatsapp} target="_blank" rel="noopener" class="menu-movil__wa">
          <span class="menu-movil__wa-nivel">WhatsApp Jardín</span>
          <span>{NIVELES.jardin.telefono}</span>
        </a>
        <a href={NIVELES.primaria.whatsapp} target="_blank" rel="noopener" class="menu-movil__wa">
          <span class="menu-movil__wa-nivel">WhatsApp Primaria</span>
          <span>{NIVELES.primaria.telefono}</span>
        </a>
      </div>
    </div>
  </nav>
</div>

<style>
  .encabezado {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    height: var(--header-h);
    padding-top: env(safe-area-inset-top);
    color: var(--tinta);
    transition: transform 0.5s var(--ease-out), background-color 0.4s, box-shadow 0.4s, color 0.4s;
  }
  .encabezado::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background-color: var(--papel);
    background-image: url('/textura-papel.png');
    opacity: 1;
    box-shadow: 0 1px 0 rgba(35, 32, 28, 0.08);
    transition: opacity 0.4s;
    z-index: -1;
  }
  .encabezado--hero { color: var(--papel); }
  .encabezado--hero::before { opacity: 0; }
  .encabezado--hero.is-solido { color: var(--tinta); }
  .encabezado--hero.is-solido::before { opacity: 1; }
  .encabezado.is-oculto { transform: translate3d(0, -110%, 0); }
  .encabezado.is-oculto :global(.submenu) { opacity: 0 !important; visibility: hidden !important; }
  .encabezado.is-menu-abierto { transform: none; color: var(--tinta); }
  .encabezado.is-menu-abierto::before { opacity: 0; }

  .encabezado__barra {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .marca { display: flex; align-items: center; }
  .marca__sep { width: 1px; height: 36px; background: rgba(35, 32, 28, 0.25); margin: 0 0.7rem; }
  /* Logos más grandes (pedido de la escuela, rev. 19-11-2026). En celulares, un poco más chicos para que entre la barra. */
  .marca :global(.logo--jardin) { height: 62px !important; }
  .marca :global(.logo--primaria) { height: 46px !important; }
  @media (min-width: 48em) {
    .marca :global(.logo--jardin) { height: 84px !important; }
    .marca :global(.logo--primaria) { height: 62px !important; }
    .marca__sep { height: 48px; margin: 0 0.9rem; }
  }
  .encabezado__logo {
    display: block;
    flex: none;
    padding: 0.2rem 0.4rem;
    margin-left: -0.4rem;
    border-radius: 0.4rem;
    background: rgba(250, 246, 238, 0);
    transition: background-color 0.4s;
  }
  /* Sobre la foto, el logo (rojo sobre transparente) va sobre una plaquita de papel para leerse siempre */


  .nav { display: none; }

  @media (min-width: 75em) {
    .nav { display: block; margin-left: auto; margin-right: -0.2rem; }
    .nav__lista { display: flex; align-items: center; }
    .nav__item { position: relative; margin-left: 1.5rem; display: flex; align-items: center; }
    .nav__enlace {
      font-size: 1rem;
      font-weight: 550;
      letter-spacing: 0.005em;
      text-decoration: none;
      padding: 0.6rem 0;
      white-space: nowrap;
    }
    .nav__flechita {
      display: inline-flex; align-items: center; justify-content: center;
      width: 1.4rem; height: 2.2rem;
      margin-left: 0.1rem;
      border: 0; background: none; padding: 0;
      transition: transform 0.3s;
    }
    .nav__flechita[aria-expanded='true'] { transform: rotate(180deg); }
    .submenu {
      position: absolute;
      top: 100%; left: -1rem;
      min-width: 14rem;
      padding: 0.5rem;
      background: var(--papel);
      background-image: url('/textura-papel.png');
      border-radius: var(--radio-lg);
      box-shadow: var(--sombra-papel-alta);
      color: var(--tinta);
      opacity: 0; visibility: hidden;
      transform: translate3d(0, 6px, 0);
      transition: opacity 0.25s, transform 0.35s var(--ease-out), visibility 0s 0.35s;
    }
    .submenu.is-abierto, .nav__item--padre:focus-within .submenu {
      opacity: 1; visibility: visible; transform: none;
      transition: opacity 0.25s, transform 0.35s var(--ease-out), visibility 0s;
    }
    @media (hover: hover) {
      .nav__item--padre:hover .submenu { opacity: 1; visibility: visible; transform: none; transition: opacity 0.25s, transform 0.35s var(--ease-out), visibility 0s; }
    }
    .submenu__enlace {
      display: block;
      padding: 0.7rem 0.9rem;
      border-radius: var(--radio);
      text-decoration: none;
      font-weight: 550;
      font-size: 1.0625rem;
    }
    .submenu__enlace:hover, .submenu__enlace[aria-current='page'] { background: var(--papel-oscuro); }
    .hamburguesa { display: none !important; }
    /* V.E.A. al final de la botonera, al lado de Contacto / Admisión. No es un enlace. */
    .nav__item--vea { margin-left: 1.6rem; padding-left: 1.6rem; border-left: 1px solid rgba(35, 32, 28, 0.2); }
    .nav__item--vea :global(.nav__vea) { height: 52px !important; }
  }
  @media (min-width: 75em) and (max-width: 86em) {
    .nav__item { margin-left: 1.1rem; }
    .nav__enlace { font-size: 0.9375rem; }
  }

  /* Hamburguesa con morph a × */
  .hamburguesa {
    display: inline-flex; align-items: center; justify-content: center;
    width: 3rem; height: 3rem;
    margin-right: -0.6rem;
    border: 0; background: none; color: inherit;
    -webkit-tap-highlight-color: transparent;
  }
  .hamburguesa__lineas { position: relative; display: block; width: 1.28rem; height: 1rem; }
  .hamburguesa__lineas span {
    position: absolute; left: 0; height: 2px; width: 100%;
    background: currentColor; border-radius: 2px;
    transition: transform 0.45s var(--ease-out), opacity 0.25s, width 0.3s;
  }
  .hamburguesa__lineas span:nth-child(1) { top: 0; }
  .hamburguesa__lineas span:nth-child(2) { top: 7px; width: 72%; }
  .hamburguesa__lineas span:nth-child(3) { top: 14px; }
  .hamburguesa[aria-expanded='true'] .hamburguesa__lineas span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburguesa[aria-expanded='true'] .hamburguesa__lineas span:nth-child(2) { opacity: 0; width: 0; }
  .hamburguesa[aria-expanded='true'] .hamburguesa__lineas span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Menú móvil a pantalla completa */
  .menu-movil {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 45;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    padding-top: calc(var(--header-h) + 1rem + env(safe-area-inset-top));
    padding-bottom: calc(1.7rem + env(safe-area-inset-bottom));
    color: var(--tinta);
  }
  .menu-movil[hidden] { display: none; }
  .menu-movil__papel {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background-color: var(--papel);
    background-image: url('/textura-papel.png');
    z-index: -1;
    transform-origin: 50% 0;
  }
  .menu-movil__nav { position: relative; min-height: 100%; display: flex; flex-direction: column; }
  .menu-movil__lista { margin-bottom: 1.7rem; }
  .menu-movil__lista > li { border-bottom: 1px solid rgba(35, 32, 28, 0.1); }
  .menu-movil__enlace {
    display: block;
    padding: 0.7rem 0;
    min-height: 44px;
    font-family: var(--f-titulo);
    font-size: 1.505rem;
    font-size: clamp(1.505rem, 0.984rem + 2.22vw, 1.85rem);
    line-height: 1.15;
    text-decoration: none;
    letter-spacing: -0.015em;
  }
  .menu-movil__enlace[aria-current='page'] { color: var(--bordo); font-style: italic; }
  .menu-movil__sub { padding: 0 0 0.9rem; margin-top: -0.25rem; }
  .menu-movil__sub li { display: inline-block; margin-right: 1.25rem; }
  .menu-movil__sub a { display: inline-block; padding: 0.55rem 0; font-weight: 600; color: var(--tinta-suave); text-decoration: none; min-height: 44px; }
  .menu-movil__vea { margin: 0 0 1.4rem; }
  .menu-movil__pie { margin-top: auto; }
  .menu-movil__contactos { display: grid; grid-template-columns: 1fr 1fr; grid-gap: 0.75rem; gap: 0.75rem; margin-top: 1rem; }
  .menu-movil__wa {
    display: flex; flex-direction: column;
    padding: 0.8rem 0.9rem;
    border: 1px solid rgba(35, 32, 28, 0.18);
    border-radius: var(--radio-lg);
    text-decoration: none;
    font-size: 0.875rem;
    line-height: 1.35;
  }
  .menu-movil__wa-nivel { font-weight: 700; color: var(--bordo); }
  .menu-movil__sol { position: absolute; right: -1rem; top: -1rem; width: 5.6rem; height: 5.6rem; opacity: 0.6; }
  @media (min-width: 75em) { .menu-movil { display: none !important; } }
  @media (max-width: 22em) { .menu-movil__contactos { grid-template-columns: 1fr; } }
</style>
