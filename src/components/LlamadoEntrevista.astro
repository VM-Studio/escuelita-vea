---
// Cierre con llamado a entrevista. Texto de interfaz (microcopy) a aprobar por la escuela.
import Foto from './Foto.astro';
import Trazo from './Trazo.astro';
import Boton from './Boton.astro';
import { NIVELES } from '../config/sitio';
interface Props { nivel?: 'jardin' | 'primaria'; foto?: string; titulo?: string }
const { nivel, foto, titulo = 'Vení a conocer La Escuelita' } = Astro.props;
const href = nivel ? `/contacto/?nivel=${nivel}#entrevista` : '/contacto/#entrevista';
---
<section class:list={['llamado seccion', { 'llamado--sin-foto': !foto }]} aria-labelledby="llamado-titulo">
  <div class="contenedor llamado__grilla">
    {foto && (
      <div class="llamado__foto pegada" style="--rot:2deg" data-revelar>
        <span class="cinta" aria-hidden="true"></span>
        <Foto id={foto} ratio="1/1" sizes="(min-width: 56em) 30vw, 70vw" />
      </div>
    )}
    <div class="llamado__texto">
      <h2 id="llamado-titulo" class="llamado__titulo" data-titulo-lineas>
        {titulo}
      </h2>
      <Trazo nombre="subrayado-doble" class="llamado__trazo" grosor={3} />
      <p class="llamado__bajada t-lead" data-revelar>
        Escribinos y coordinamos una entrevista{nivel ? ` en el ${NIVELES[nivel].nombre === 'Jardín' ? 'Jardín' : 'nivel Primario'}` : ''}.
      </p>
      <div class="llamado__acciones" data-revelar>
        <Boton href={href} variante="rojo" tamano="grande">Pedí una entrevista</Boton>
        <a class="enlace-trazo llamado__wa" href={nivel ? NIVELES[nivel].whatsapp : '/contacto/'} target={nivel ? '_blank' : undefined} rel={nivel ? 'noopener' : undefined}>
          {nivel ? `O escribinos por WhatsApp` : 'Ver datos de contacto'}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .llamado { background: var(--acento-suave); overflow: hidden; }
  .llamado__grilla { display: grid; grid-template-columns: 1fr; grid-gap: 3rem; gap: 3rem; align-items: center; }
  .llamado__foto { position: relative; width: 70%; max-width: 22rem; margin: 0 auto; }
  .llamado__titulo { font-size: 2.25rem; font-size: var(--t-2xl); max-width: 16ch; }
  .llamado__trazo { width: 14rem; height: 1.2rem; margin: 0.6rem 0 1.5rem; }
  .llamado__bajada { max-width: 34ch; }
  .llamado__acciones { display: flex; flex-wrap: wrap; align-items: center; margin-top: 2rem; }
  .llamado__acciones > :global(*) { margin: 0 1.5rem 0.75rem 0; }
  .llamado__wa { font-weight: 600; padding: 0.5rem 0; }
  .llamado--sin-foto .llamado__grilla { text-align: center; }
  .llamado--sin-foto .llamado__titulo, .llamado--sin-foto .llamado__bajada { margin-left: auto; margin-right: auto; }
  .llamado--sin-foto .llamado__trazo { margin-left: auto; margin-right: auto; }
  .llamado--sin-foto .llamado__acciones { justify-content: center; }
  .llamado--sin-foto .llamado__acciones > :global(*) { margin: 0 0.75rem 0.75rem; }
  @media (min-width: 56em) {
    .llamado:not(.llamado--sin-foto) .llamado__grilla { grid-template-columns: 4fr 7fr; grid-gap: 5rem; gap: 5rem; }
    .llamado__foto { width: 100%; }
  }
</style>
