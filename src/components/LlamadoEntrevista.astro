---
// Cierre con llamado a entrevista: composición centrada, tipográfica, con la foto intercalada en el título.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Boton from './Boton.astro';
import { NIVELES } from '../config/sitio';
interface Props { nivel?: 'jardin' | 'primaria'; foto?: string; titulo?: string }
const { nivel, foto, titulo = 'Vení a conocer La Escuelita' } = Astro.props;
const href = nivel ? `/contacto/?nivel=${nivel}#entrevista` : '/contacto/#entrevista';
const masters = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos/*.jpg', { eager: true });
const src = foto ? masters[`../assets/fotos/${foto}.jpg`]?.default : undefined;
const img = src ? await getImage({ src, width: 360, height: 220, fit: 'cover', format: 'webp' }) : null;
const palabras = titulo.split(' ');
const corte = Math.max(1, Math.floor(palabras.length / 2));
---
<section class="llamado" aria-labelledby="llamado-titulo">
  <div class="contenedor llamado__caja">
    <p class="rotulo llamado__rotulo" data-revelar>Admisión {nivel ? `· ${NIVELES[nivel].nombre}` : ''}</p>
    <h2 id="llamado-titulo" class="llamado__titulo" data-revelar>
      {palabras.slice(0, corte).join(' ')}{' '}
      {img && <span class="llamado__img" aria-hidden="true"><img src={img.src} alt="" width="360" height="220" loading="lazy" decoding="async" /></span>}{' '}
      <em class="acento">{palabras.slice(corte).join(' ')}</em>
    </h2>
    <p class="llamado__bajada" data-revelar>
      Escribinos y coordinamos una entrevista{nivel ? ` en el ${nivel === 'jardin' ? 'Jardín' : 'nivel Primario'}` : ''}.
    </p>
    <div class="llamado__acciones" data-revelar>
      <Boton href={href} variante="rojo" tamano="grande">Pedí una entrevista</Boton>
      {nivel
        ? <a class="enlace-flecha" href={NIVELES[nivel].whatsapp} target="_blank" rel="noopener">O escribinos por WhatsApp</a>
        : <a class="enlace-flecha" href="/contacto/">Ver datos de contacto</a>}
    </div>
  </div>
</section>

<style>
  .llamado { padding: 4.5rem 0; padding: clamp(3.5rem, 2rem + 5vw, 7.5rem) 0; border-top: 1px solid rgba(35, 32, 28, 0.12); text-align: center; }
  .llamado__caja { display: flex; flex-direction: column; align-items: center; }
  .llamado__titulo { font-size: 2.3rem; font-size: clamp(2.3rem, 1rem + 4.6vw, 5.6rem); font-weight: 300; line-height: 1; letter-spacing: -0.04em; max-width: 14ch; margin-top: 1rem; }
  .llamado__img { display: inline-block; vertical-align: middle; width: 1.6em; height: 0.95em; border-radius: 999px; overflow: hidden; margin: -0.15em 0.08em 0; transform: rotate(-3deg); box-shadow: 0 10px 22px -12px rgba(60, 40, 20, 0.55); }
  .llamado__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .llamado__bajada { margin: 1.5rem auto 0; color: var(--tinta-suave); }
  .llamado__acciones { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; margin-top: 1.75rem; }
  .llamado__acciones > :global(*) { margin: 0 0.9rem 0.75rem; }
</style>
