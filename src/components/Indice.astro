---
// Índice editorial (idea de Olivia Plender / Albers en SiteInspire): lista de títulos grandes en filas,
// con el texto completo en una columna y la foto que aparece siguiendo al cursor (desktop).
// En pantallas chicas y sin JS, la foto se ve como miniatura de cada fila.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { parrafos } from '../lib/texto';
interface Item { titulo: string; texto?: string | string[]; foto?: string; href?: string; id?: string; rotulo?: string }
interface Props { items: Item[]; class?: string; tituloComo?: 'h2' | 'h3' }
const { items, class: clase = '', tituloComo = 'h3' } = Astro.props;
const masters = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos/*.jpg', { eager: true });
const filas = await Promise.all(items.map(async (it) => {
  const src = it.foto ? masters[`../assets/fotos/${it.foto}.jpg`]?.default : undefined;
  const img = src ? await getImage({ src, width: 560, height: 700, fit: 'cover', format: 'webp' }) : null;
  return { ...it, img: img?.src };
}));
const T = tituloComo;
---
<ol class:list={['indice', clase]} data-indice>
  {filas.map((f) => (
    <li class="indice__fila" id={f.id} data-indice-fila data-img={f.img} data-revelar>
      {f.img && <span class="indice__mini" aria-hidden="true"><img src={f.img} alt="" loading="lazy" decoding="async" width="560" height="700" /></span>}
      <div class="indice__cabeza">
        {f.rotulo && <p class="rotulo">{f.rotulo}</p>}
        <T class="indice__titulo">{f.href ? <a href={f.href}>{f.titulo}</a> : f.titulo}</T>
      </div>
      {f.texto && <div class="indice__texto prosa" set:html={parrafos(f.texto)} />}
    </li>
  ))}
</ol>
<div class="indice__flotante" aria-hidden="true" data-indice-flotante><img alt="" /></div>

<script>
  const fino = window.matchMedia('(hover: hover) and (pointer: fine)').matches && !document.documentElement.classList.contains('liviano');
  if (fino) {
    document.querySelectorAll<HTMLElement>('[data-indice]').forEach((lista) => {
      const flot = lista.nextElementSibling as HTMLElement;
      const img = flot.querySelector('img') as HTMLImageElement;
      let x = 0, y = 0, cx = 0, cy = 0, raf = 0, on = false;
      const loop = () => { cx += (x - cx) * 0.14; cy += (y - cy) * 0.14; flot.style.transform = `translate3d(${cx}px, ${cy}px, 0) translate(-50%, -50%) rotate(${(x - cx) * 0.04}deg)`; raf = on || Math.abs(x - cx) > 0.5 ? requestAnimationFrame(loop) : 0; };
      lista.querySelectorAll<HTMLElement>('[data-indice-fila]').forEach((fila) => {
        fila.addEventListener('mouseenter', () => { const s = fila.dataset.img; if (!s) return; img.src = s; on = true; flot.classList.add('is-visible'); if (!raf) raf = requestAnimationFrame(loop); });
        fila.addEventListener('mouseleave', () => { on = false; flot.classList.remove('is-visible'); });
        fila.addEventListener('mousemove', (e) => { x = e.clientX + 170; y = e.clientY; if (!raf) raf = requestAnimationFrame(loop); });
      });
      lista.classList.add('is-flotante');
    });
  }
</script>

<style>
  .indice { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(35, 32, 28, 0.18); }
  .indice__fila {
    position: relative;
    display: grid; grid-template-columns: 1fr; grid-gap: 0.75rem 3rem; gap: 0.75rem 3rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid rgba(35, 32, 28, 0.18);
    transition: background-color 0.4s;
  }
  @media (min-width: 56em) { .indice__fila { grid-template-columns: 5fr 7fr; padding: 2.25rem 0; } }
  .indice__titulo { font-family: var(--f-titulo); font-weight: 330; font-size: 1.6rem; font-size: clamp(1.5rem, 1rem + 1.8vw, 2.7rem); line-height: 1.05; letter-spacing: -0.03em; transition: transform 0.5s var(--ease-out), color 0.3s; }
  .indice__titulo a { text-decoration: none; }
  .indice__cabeza .rotulo { margin-bottom: 0.5rem; }
  .indice__texto { font-size: 0.98rem; color: var(--tinta-suave); }
  .indice__mini { display: block; width: 100%; max-width: 22rem; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 4px; margin-bottom: 0.25rem; }
  .indice__mini img { width: 100%; height: 100%; object-fit: cover; }
  @supports not (aspect-ratio: 1) { .indice__mini { height: 14rem; } }
  .indice.is-flotante .indice__mini { display: none; }
  @media (hover: hover) {
    .indice__fila:hover .indice__titulo { transform: translateX(10px); color: var(--rojo); }
  }
  .indice__flotante {
    position: fixed; left: 0; top: 0; z-index: 30;
    width: 15rem; aspect-ratio: 4 / 5; border-radius: 6px; overflow: hidden;
    pointer-events: none;
    opacity: 0; transition: opacity 0.35s;
    box-shadow: 0 30px 60px -24px rgba(35, 32, 28, 0.55);
  }
  .indice__flotante.is-visible { opacity: 1; }
  .indice__flotante img { width: 100%; height: 100%; object-fit: cover; }
</style>
