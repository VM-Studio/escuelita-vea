---
// Texto que corre sobre una curva y se puede arrastrar — "CurvedLoop" de React Bits (MIT + Commons Clause).
interface Props { items: string[]; separador?: string; curva?: number; tamano?: number; velocidad?: number; class?: string; etiqueta?: string }
const { items, separador = '✳', curva = 160, tamano = 58, velocidad = 1.2, class: clase = '', etiqueta } = Astro.props;
const unidad = items.map((t) => `${t} ${separador} `).join('');
const id = `curva-${Math.random().toString(36).slice(2, 8)}`;
const base = curva < 0 ? 40 + Math.abs(curva) * 0.62 : 40;
const d = `M-100,${base} Q500,${base + curva} 1540,${base}`;
---
<div class:list={['curva', clase]} data-curva data-speed={velocidad} role="img" aria-label={etiqueta ?? items.join(', ')}>
  <svg class="curva__svg" viewBox={`0 0 1440 ${Math.round(80 + Math.abs(curva) * 0.62)}`} style={`font-size:${tamano}px`} aria-hidden="true">
    <text data-medir xml:space="preserve" style="visibility:hidden;opacity:0">{unidad}</text>
    <defs><path id={id} d={d} fill="none" /></defs>
    <text xml:space="preserve" class="curva__texto"><textPath href={`#${id}`} data-unidad={unidad} data-separador={separador}>{unidad}</textPath></text>
  </svg>
  <p class="curva__estatico" aria-hidden="true">{items.join(' · ')}</p>
</div>
<script>
  import { iniciarCurva } from '../scripts/reactbits/curva-texto';
  const curvas = document.querySelectorAll<HTMLElement>('[data-curva]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { io.unobserve(e.target); iniciarCurva(e.target as HTMLElement); } }), { rootMargin: '400px' });
    curvas.forEach((c) => io.observe(c));
  } else curvas.forEach((c) => iniciarCurva(c));
</script>
<style>
  .curva { position: relative; width: 100%; overflow: hidden; cursor: grab; touch-action: pan-y; padding: 0.5rem 0 0; }
  .curva[data-dragging] { cursor: grabbing; }
  .curva__svg { display: block; width: 100%; height: auto; overflow: visible; user-select: none; -webkit-user-select: none; }
  .curva__svg :global(.sep) { fill: var(--rojo-vivo); font-style: normal; }
  .curva__svg text { font-family: var(--f-titulo); font-style: italic; font-weight: 340; letter-spacing: -0.01em; fill: var(--tinta); }
  .curva__estatico { display: none; text-align: center; font-family: var(--f-titulo); font-style: italic; font-size: 1.75rem; padding: 1.5rem var(--gutter); max-width: none; }
  :global(html:not(.js)) .curva__svg { display: none; }
  :global(html:not(.js)) .curva__estatico { display: block; }
  :global(html.js) .curva { visibility: hidden; }
</style>
