---
// Acordeón sobre <details>/<summary> nativo (funciona sin JS). Con JS: altura animada, "+" gira a "×",
// grupo que abre de a uno y URL propia (#id) para compartir.
interface Props { id: string; titulo: string; grupo?: string; abierto?: boolean; nivelTitulo?: 'h3' | 'h4'; class?: string; subtitulo?: string }
const { id, titulo, grupo = '', abierto = false, nivelTitulo = 'h3', class: clase = '', subtitulo } = Astro.props;
const H = nivelTitulo;
---
<details class:list={['acordeon', clase]} id={id} data-acordeon={grupo} open={abierto} data-revelar>
  <summary class="acordeon__resumen">
    <H class="acordeon__titulo">{titulo}{subtitulo && <span class="acordeon__sub">{subtitulo}</span>}</H>
    <span class="acordeon__signo" aria-hidden="true"></span>
  </summary>
  <div class="acordeon__cuerpo" data-acordeon-cuerpo>
    <div class="acordeon__interior"><slot /></div>
  </div>
</details>

<style>
  .acordeon { border-top: 1px solid rgba(35, 32, 28, 0.16); }
  .acordeon:last-of-type { border-bottom: 1px solid rgba(35, 32, 28, 0.16); }
  .acordeon__resumen {
    display: flex; align-items: center; justify-content: space-between;
    min-height: 44px;
    padding: 1.35rem 0;
    cursor: pointer;
    list-style: none;
    -webkit-tap-highlight-color: transparent;
  }
  .acordeon__resumen::-webkit-details-marker { display: none; }
  .acordeon__resumen::marker { content: ''; }
  .acordeon__titulo {
    font-family: var(--f-titulo);
    font-size: 1.265rem;
    font-size: clamp(1.265rem, 0.902rem + 1.008vw, 1.785rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
    transition: color 0.3s, transform 0.4s var(--ease-out);
  }
  .acordeon__sub { display: block; margin-top: 0.3rem; font-family: var(--f-texto); font-size: 0.9375rem; font-weight: 500; color: var(--tinta-suave); letter-spacing: 0; }
  @media (hover: hover) { .acordeon__resumen:hover .acordeon__titulo { color: var(--acento-texto); transform: translateX(4px); } }
  .acordeon__signo {
    position: relative; flex: none;
    width: 2.2rem; height: 2.2rem;
    margin-left: 1rem;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    transition: transform 0.5s var(--ease-out), background-color 0.3s, color 0.3s;
  }
  .acordeon__signo::before, .acordeon__signo::after {
    content: ''; position: absolute; top: 50%; left: 50%;
    width: 0.95rem; height: 1.5px; margin-left: -0.475rem; margin-top: -0.75px;
    background: currentColor; border-radius: 2px;
  }
  .acordeon__signo::after { transform: rotate(90deg); }
  .acordeon[open]:not(.is-cerrando) .acordeon__signo { transform: rotate(135deg); background: var(--tinta); color: var(--papel); }
  .acordeon__cuerpo { overflow: hidden; }
  .acordeon__interior { padding-bottom: 1.912rem; }
</style>
