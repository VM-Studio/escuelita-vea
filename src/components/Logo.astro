---
// Logos oficiales de la escuela (entregados en alta calidad, recortados y optimizados en public/logos/).
//  · jardin   → La Escuelita (la nena con flores) — Primer Jardín Argentino de Educación por el Arte
//  · primaria → Instituto La Escuelita · V.E.A. (Jardín - Primaria)
//  · vea      → mismo logo V.E.A.
// Versiones: "sinfondo" (transparente: navbar, secciones claras) y "blanco" (con fondo blanco: sobre fondos oscuros o fotos).
// Originales en _material/logos/originales/. No redibujar, no recolorear, no deformar.
interface Props {
  nivel: 'jardin' | 'primaria' | 'vea';
  version?: 'sinfondo' | 'blanco';
  alto?: number;
  class?: string;
  decorativo?: boolean;
  prioridad?: boolean;
}
const LOGOS = {
  jardin: { archivo: 'la-escuelita', w: 900, h: 1060, wb: 1116, hb: 1276, alt: 'La Escuelita — Primer Jardín Argentino de Educación por el Arte' },
  primaria: { archivo: 'vea', w: 900, h: 717, wb: 1116, hb: 933, alt: 'Instituto La Escuelita — Jardín y Primaria (V.E.A.)' },
  vea: { archivo: 'vea', w: 900, h: 717, wb: 1116, hb: 933, alt: 'V.E.A. — Instituto La Escuelita, Jardín y Primaria' },
} as const;
const { nivel, version = 'sinfondo', alto = 64, class: clase = '', decorativo = false, prioridad = false } = Astro.props;
const l = LOGOS[nivel];
const [w, h] = version === 'blanco' ? [l.wb, l.hb] : [l.w, l.h];
const ancho = Math.round((w / h) * alto);
---
<img
  class:list={['logo', `logo--${nivel}`, `logo--${version}`, clase]}
  src={`/logos/${l.archivo}-${version}${version === 'sinfondo' && alto <= 60 ? '-sm' : ''}.png`}
  width={ancho}
  height={alto}
  alt={decorativo ? '' : l.alt}
  decoding="async"
  loading={prioridad ? 'eager' : 'lazy'}
  style={`height:${alto}px;width:auto`}
/>

<style>
  .logo { display: block; max-width: 100%; }
  .logo--blanco { border-radius: 6px; }
</style>
