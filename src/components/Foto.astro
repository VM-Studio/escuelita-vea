---
// Foto optimizada: <picture> con AVIF + WebP + JPEG de respaldo, srcset 480–2000,
// width/height siempre, LQIP (desenfoque que se aclara al cargar), recorte opcional.
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { fotos } from '../data/fotos.mjs';
import lqipData from '../data/fotos-lqip.json';

interface Props {
  id: string;
  /** Proporción del recorte, ej. "4/5", "16/9". Sin valor: proporción natural. */
  ratio?: string;
  sizes?: string;
  alt?: string;
  prioridad?: boolean;
  class?: string;
  foco?: string;
  revelar?: boolean;
  anchoMax?: number;
  pie?: string;
  /** Si existe una versión para celular (src/assets/fotos-celular/<id>.jpg), se usa en pantallas verticales.
   *  Solo donde el recuadro también es vertical en el celular (fondos fijos a pantalla completa, portadas). */
  celular?: boolean;
}

const { id, ratio, sizes = '100vw', alt, prioridad = false, class: clase = '', foco, revelar = false, anchoMax = 2400, pie, celular = false } = Astro.props;
const masters = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos/*.jpg', { eager: true });
const img = masters[`../assets/fotos/${id}.jpg`]?.default;
const meta = fotos.find((f) => f.id === id);
const lqip = (lqipData as Record<string, { lqip: string }>)[id]?.lqip;
const esDev = import.meta.env.DEV;

if (!meta && esDev) console.warn(`[Foto] id no registrado: ${id}`);

const widths = [480, 720, 960, 1280, 1600, 2000, 2400].filter((w) => w <= Math.min(anchoMax, img?.width ?? 2400));
if (img && !widths.includes(Math.min(img.width, anchoMax)) && img.width < anchoMax) widths.push(img.width);

let pt: string | undefined;
if (ratio) {
  const [a, b] = ratio.split('/').map(Number);
  pt = `${((b / a) * 100).toFixed(3)}%`;
}
const posicion = foco ?? meta?.foco ?? '50% 50%';

// Dirección de arte: versión vertical para celulares (si la escuela la entregó)
const cels = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos-celular/*.jpg', { eager: true });
const cel = celular ? cels[`../assets/fotos-celular/${id}.jpg`]?.default : undefined;
const MEDIA_CEL = '(max-aspect-ratio: 3/4)';
let fuentes: { media?: string; type: string; srcset: string }[] = [];
let respaldo = '';
if (img && cel) {
  const juego = async (src: ImageMetadata, anchos: number[], format: 'avif' | 'webp' | 'jpg') => {
    const w = anchos.filter((a) => a < src.width).concat(Math.min(src.width, anchos[anchos.length - 1]));
    return (await getImage({ src, widths: [...new Set(w)], format, quality: format === 'avif' ? 66 : 85 })).srcSet.attribute;
  };
  const AC = [480, 720, 960, 1200, 1600];
  fuentes = [
    { media: MEDIA_CEL, type: 'image/avif', srcset: await juego(cel, AC, 'avif') },
    { media: MEDIA_CEL, type: 'image/webp', srcset: await juego(cel, AC, 'webp') },
    { media: MEDIA_CEL, type: 'image/jpeg', srcset: await juego(cel, AC, 'jpg') },
    { type: 'image/avif', srcset: await juego(img, widths, 'avif') },
    { type: 'image/webp', srcset: await juego(img, widths, 'webp') },
  ];
  respaldo = (await getImage({ src: img, width: Math.min(img.width, 1600), format: 'jpg', quality: 85 })).src;
}
const textoAlt = alt ?? meta?.alt ?? '';
---
{img ? (
  <figure
    class:list={['foto', ratio ? 'foto--recorte' : 'foto--natural', { 'foto--prioridad': prioridad }, clase]}
    style={pt ? `--pt:${pt}` : undefined}
    data-revelar-img={revelar ? '' : undefined}
  >
    {lqip && !prioridad && <span class="foto__lqip" style={`background-image:url(${lqip})`} aria-hidden="true"></span>}
    {cel ? (
      <picture>
        {fuentes.map((f) => <source media={f.media} type={f.type} srcset={f.srcset} sizes={sizes} />)}
        <img
          src={respaldo}
          alt={textoAlt}
          width={img.width}
          height={img.height}
          loading={prioridad ? 'eager' : 'lazy'}
          decoding={prioridad ? 'sync' : 'async'}
          fetchpriority={prioridad ? 'high' : 'auto'}
          style={`object-position:${posicion}`}
          draggable="false"
        />
      </picture>
    ) : (
    <Picture
      src={img}
      alt={textoAlt}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={widths}
      sizes={sizes}
      loading={prioridad ? 'eager' : 'lazy'}
      decoding={prioridad ? 'sync' : 'async'}
      fetchpriority={prioridad ? 'high' : 'auto'}
      style={`object-position:${posicion}`}
      draggable="false"
    />
    )}
    {pie && <figcaption>{pie}</figcaption>}
  </figure>
) : (
  <div class:list={['foto foto-pendiente', ratio ? 'foto--recorte' : '', clase]} style={pt ? `--pt:${pt}` : 'min-height:14rem'} aria-hidden="true">
    {esDev && <span class="foto-pendiente__rotulo" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%)">Foto pendiente · {id}</span>}
  </div>
)}
