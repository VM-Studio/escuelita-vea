---
// Galería escalonada con rótulos tipo museo (idea de Jon Pilkington / Albers en SiteInspire).
// Columnas desparejas, mucho aire, pie chico: nivel · carpeta.
import Foto from './Foto.astro';
import { fotos as registro } from '../data/fotos.mjs';
interface Props { ids: string[]; rotulos?: string[]; class?: string; columnas?: 2 | 3 }
const { ids, rotulos, class: clase = '', columnas = 3 } = Astro.props;
const rot = (id: string, i: number) => {
  if (rotulos?.[i]) return rotulos[i];
  const f = registro.find((x) => x.id === id);
  if (!f) return '';
  const carpeta = f.carpeta.split('(')[0].split('/')[0].trim().toLowerCase().replace(/^./, (c: string) => c.toUpperCase());
  return `${f.nivel === 'jardin' ? 'Jardín' : 'Primaria'} — ${carpeta}`;
};
const ratios = ['4/5', '1/1', '3/4', '4/3', '4/5', '5/4'];
---
<div class:list={['escalonada', `escalonada--${columnas}`, clase]}>
  {ids.map((id, i) => (
    <figure class="escalonada__item" data-revelar>
      <Foto id={id} ratio={ratios[i % ratios.length]} sizes={`(min-width: 56em) ${columnas === 3 ? 30 : 44}vw, 90vw`} revelar />
      <figcaption class="rotulo escalonada__pie">{rot(id, i)}</figcaption>
    </figure>
  ))}
</div>

<style>
  .escalonada { display: grid; grid-template-columns: 1fr 1fr; grid-gap: 2.5rem 1rem; gap: 2.5rem 1rem; align-items: start; }
  .escalonada__item { margin: 0; }
  .escalonada__item :global(.foto) { border-radius: 3px; }
  .escalonada__pie { margin-top: 0.6rem; }
  .escalonada__item:nth-child(2n) { margin-top: 3rem; }
  @media (min-width: 56em) {
    .escalonada--3 { grid-template-columns: repeat(3, 1fr); grid-gap: 4rem 2.5rem; gap: 4rem 2.5rem; }
    .escalonada--3 .escalonada__item:nth-child(2n) { margin-top: 0; }
    .escalonada--3 .escalonada__item:nth-child(3n + 2) { margin-top: 6rem; }
    .escalonada--3 .escalonada__item:nth-child(3n) { margin-top: 2.5rem; padding: 0 1.5rem; }
    .escalonada--2 { grid-gap: 4rem 4rem; gap: 4rem 4rem; }
    .escalonada--2 .escalonada__item:nth-child(2n) { margin-top: 7rem; }
    .escalonada--2 .escalonada__item:nth-child(4n + 1) { padding-right: 3rem; }
  }
</style>
