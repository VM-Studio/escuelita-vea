---
// Declaración tipográfica grande con fotos intercaladas entre las palabras ("título con imágenes").
// El texto NO cambia: las fotos se insertan después de la palabra indicada (decorativas, aria-hidden).
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  texto: string;
  imagenes?: { id: string; despues: string; forma?: 'pastilla' | 'circulo' | 'arco' }[];
  etiqueta?: string; // rótulo chico arriba
  tamano?: 'xl' | 'l' | 'm';
  centrado?: boolean;
  como?: 'p' | 'h2';
  class?: string;
}
const { texto, imagenes = [], etiqueta, tamano = 'l', centrado = false, como = 'p', class: clase = '' } = Astro.props;
const masters = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos/*.jpg', { eager: true });
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
let html = esc(texto);
for (const im of imagenes) {
  const src = masters[`../assets/fotos/${im.id}.jpg`]?.default;
  if (!src) continue;
  const forma = im.forma ?? 'pastilla';
  const [w, h] = forma === 'circulo' ? [220, 220] : forma === 'arco' ? [180, 230] : [320, 180];
  const img = await getImage({ src, width: w, height: h, fit: 'cover', format: 'webp' });
  const pill = `<span class="decl__img decl__img--${forma}" aria-hidden="true"><img src="${img.src}" alt="" width="${w}" height="${h}" loading="lazy" decoding="async"></span>`;
  const i = html.indexOf(esc(im.despues));
  // Se inserta ANTES de la palabra indicada (así nunca separa una palabra de su puntuación)
  if (i > -1) html = `${html.slice(0, i)}${pill} ${html.slice(i)}`;
}
const Tag = como;
---
<div class:list={['decl', `decl--${tamano}`, { 'decl--centro': centrado }, clase]}>
  {etiqueta && <p class="rotulo decl__etiqueta" data-revelar>{etiqueta}</p>}
  <Tag class="decl__texto" data-revelar set:html={html} />
</div>

<style>
  .decl__etiqueta { margin-bottom: 1.25rem; }
  .decl__texto {
    font-family: var(--f-titulo);
    font-weight: 330;
    letter-spacing: -0.022em;
    color: var(--tinta);
    max-width: none;
    text-wrap: pretty;
  }
  .decl--xl .decl__texto { font-size: 2rem; font-size: clamp(2rem, 1rem + 3.4vw, 4.6rem); line-height: 1.08; }
  .decl--l .decl__texto { font-size: 1.6rem; font-size: clamp(1.55rem, 0.95rem + 2.2vw, 3.1rem); line-height: 1.16; }
  .decl--m .decl__texto { font-size: 1.3rem; font-size: clamp(1.25rem, 0.95rem + 1.1vw, 2rem); line-height: 1.3; }
  .decl--centro { text-align: center; }
  .decl--centro .decl__texto { margin-left: auto; margin-right: auto; }
  .decl__texto :global(.decl__img) {
    display: inline-block;
    vertical-align: middle;
    overflow: hidden;
    margin: -0.1em 0.12em 0;
    box-shadow: 0 8px 18px -10px rgba(60, 40, 20, 0.5);
    transform: rotate(-2deg);
    transition: transform 0.6s var(--ease-out);
  }
  .decl__texto :global(.decl__img:nth-of-type(2n)) { transform: rotate(2.5deg); }
  .decl__texto :global(.decl__img img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .decl__texto :global(.decl__img--pastilla) { width: 1.9em; height: 0.95em; border-radius: 999px; }
  .decl__texto :global(.decl__img--circulo) { width: 0.95em; height: 0.95em; border-radius: 50%; }
  .decl__texto :global(.decl__img--arco) { width: 0.8em; height: 1.02em; border-radius: 999px 999px 0.1em 0.1em; }
  @media (hover: hover) { .decl__texto :global(.decl__img:hover) { transform: rotate(0) scale(1.12); } }
</style>
