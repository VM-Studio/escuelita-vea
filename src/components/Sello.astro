---
// Sello circular con texto que gira lento (recurso gráfico de "taller de arte"). Texto institucional.
interface Props { texto?: string; class?: string; color?: 'papel' | 'tinta' | 'rojo'; tamano?: number }
const { texto = 'Primer Jardín Argentino de Educación por el Arte · 1959 · ', class: clase = '', color = 'papel', tamano = 128 } = Astro.props;
const id = `sello-${Math.random().toString(36).slice(2, 8)}`;
---
<div class:list={['sello', `sello--${color}`, clase]} style={`--tam:${tamano}px`} aria-hidden="true">
  <svg viewBox="0 0 200 200" class="sello__giro">
    <defs><path id={id} d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" /></defs>
    <text><textPath href={`#${id}`} textLength="488" lengthAdjust="spacing">{texto}</textPath></text>
  </svg>
  <svg viewBox="0 0 120 120" class="sello__sol">
    <g filter="url(#crayon)" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="5">
      <path d="M62 37 C 77 36, 86 48, 85 61 C 84 76, 72 86, 58 85 C 44 84, 35 73, 36 59 C 37 46, 47 37, 63 38" />
      <path d="M60 8 L 61 24M96 22 L 86 33M112 60 L 97 61M96 98 L 86 88M60 112 L 60 97M24 98 L 34 87M8 60 L 23 60M24 22 L 34 33" />
    </g>
  </svg>
</div>
<style>
  .sello { position: relative; width: var(--tam); height: var(--tam); flex: none; }
  .sello__giro { position: absolute; top: 0; left: 0; width: 100%; height: 100%; overflow: visible; animation: sello-giro 38s linear infinite; }
  .sello text { font-family: var(--f-texto); font-size: 14.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; fill: currentColor; }
  .sello__sol { position: absolute; top: 31%; left: 31%; width: 38%; height: 38%; color: var(--rojo-vivo); }
  .sello--papel { color: var(--papel); }
  .sello--tinta { color: var(--tinta); }
  .sello--rojo { color: var(--rojo); }
  @keyframes sello-giro { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .sello__giro { animation: none; } }
  :global(html.liviano) .sello__giro { animation: none; }
</style>
