---
import { NIVELES, REDES, SITIO } from '../config/sitio';
import Logo from './Logo.astro';
import LogoCircular from './LogoCircular.astro';
import IconoRed from './IconoRed.astro';
import { hayLogoPrimaria } from '../lib/logos';
const redes = REDES.filter((r) => r.url);
const anio = new Date().getFullYear();
const maps = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(SITIO.direccion.mapsQuery)}`;
---
<footer class="pie-sitio">
  <div class="contenedor pie-sitio__arriba">
    <div class="pie-sitio__marca">
      {/* Los logos no llevan a ningún lado (pedido de la escuela, rev. 25-11-2026) */}
      <span class="pie-sitio__logo"><Logo nivel="jardin" alto={78} /></span>
      {hayLogoPrimaria() && <span class="pie-sitio__logo"><Logo nivel="primaria" alto={64} /></span>}
      <span class="pie-sitio__logo"><Logo nivel="vea" alto={60} /></span>
      {/* Tercer logo: el circular del navbar (rev. 25-11-2026, solo acá en el pie) */}
      <span class="pie-sitio__logo pie-sitio__logo--circular"><LogoCircular alto={76} /></span>
    </div>
    <div class="pie-sitio__frase">
      <p class="t-frase">El niño es cuerpo que siente y al sentir, piensa.</p>
    </div>
  </div>

  <div class="contenedor pie-sitio__grilla">
    <div class="pie-sitio__col">
      <h2 class="pie-sitio__titulo">Jardín</h2>
      <ul class="pie-sitio__lista">
        <li><a href={NIVELES.jardin.whatsapp} target="_blank" rel="noopener">WhatsApp <span class="nowrap">{NIVELES.jardin.telefono}</span></a></li>
        <li><a href={`mailto:${NIVELES.jardin.mail}`} set:html={NIVELES.jardin.mail.replace('@', '@<wbr>')} /></li>
      </ul>
    </div>
    <div class="pie-sitio__col">
      <h2 class="pie-sitio__titulo">Primaria</h2>
      <ul class="pie-sitio__lista">
        <li><a href={NIVELES.primaria.whatsapp} target="_blank" rel="noopener">WhatsApp <span class="nowrap">{NIVELES.primaria.telefono}</span></a></li>
        <li><a href={`mailto:${NIVELES.primaria.mail}`} set:html={NIVELES.primaria.mail.replace('@', '@<wbr>')} /></li>
      </ul>
    </div>
    <div class="pie-sitio__col">
      <h2 class="pie-sitio__titulo">Dirección</h2>
      <address class="pie-sitio__direccion"><a href={maps} target="_blank" rel="noopener">{SITIO.direccion.texto}</a></address>
      {redes.length > 0 && (
        <ul class="pie-sitio__redes" aria-label="Redes sociales">
          {redes.map((r) => <li><a href={r.url} target="_blank" rel="noopener" aria-label={r.nombre}><IconoRed red={r.nombre} /></a></li>)}
        </ul>
      )}
    </div>
  </div>

  <div class="contenedor pie-sitio__base">
    <p>© {anio} La Escuelita · Asociación Civil V.E.A. (Visión Educacional Antropológica)</p>
    <a href="#top" class="pie-sitio__subir" data-volver-arriba>Volver arriba ↑</a>
  </div>
</footer>

<style>
  .pie-sitio {
    position: relative;
    background-color: #efe4cf;
    background-image: url('/textura-papel.png');
    color: var(--tinta);
    padding-top: 2.5rem;
    padding-bottom: calc(1rem + env(safe-area-inset-bottom));
    font-size: 0.875rem;
    border-top: 1px solid rgba(35, 32, 28, 0.08);
  }
  .pie-sitio a { color: inherit; text-decoration: none; }
  .pie-sitio a:hover { color: var(--rojo); }
  .pie-sitio__arriba { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; padding-bottom: 1.75rem; border-bottom: 1px solid rgba(35, 32, 28, 0.12); }
  .pie-sitio__marca { display: flex; align-items: center; margin: 0 2rem 1rem 0; }
  .pie-sitio__logo { display: block; margin-right: 1.25rem; }
  .pie-sitio__logo:last-child { margin-right: 0; }
  /* Los tres logos uno al lado del otro, siempre en la misma fila */
  .pie-sitio__marca { flex-wrap: nowrap; }
  @media (max-width: 26em) {
    .pie-sitio__logo { margin-right: 0.9rem; }
    .pie-sitio__logo--circular :global(img) { width: 64px !important; height: 64px !important; }
  }
  .pie-sitio__frase { margin-bottom: 1rem; }
  .pie-sitio__frase .t-frase { font-size: 1.25rem; font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem); max-width: 26ch; color: var(--tinta); }
  .pie-sitio__paleta { width: 6rem; margin-bottom: 0.6rem; }
  .pie-sitio__grilla { display: grid; grid-template-columns: 1fr; grid-gap: 1.25rem 2rem; gap: 1.25rem 2rem; padding-top: 1.5rem; }
  @media (min-width: 40em) { .pie-sitio__grilla { grid-template-columns: repeat(3, 1fr); } }
  .pie-sitio__titulo { font-family: var(--f-texto); font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--bordo); margin-bottom: 0.5rem; }
  .pie-sitio__lista li + li { margin-top: 0.25rem; }
  .pie-sitio__lista a, .pie-sitio__direccion a { display: inline-block; padding: 0.15rem 0; }
  .pie-sitio__direccion { font-style: normal; }
  .nowrap { white-space: nowrap; }
  .pie-sitio__redes { display: flex; margin-top: 0.75rem; }
  .pie-sitio__redes li + li { margin-left: 0.4rem; }
  .pie-sitio__redes a { display: inline-flex; width: 40px; height: 40px; align-items: center; justify-content: center; border: 1px solid rgba(35, 32, 28, 0.25); border-radius: 50%; }
  .pie-sitio__base { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid rgba(35, 32, 28, 0.12); font-size: 0.75rem; color: var(--tinta-suave); }
  .pie-sitio__base p { margin-right: 1rem; }
  .pie-sitio__subir { display: inline-block; padding: 0.5rem 0; }
</style>
