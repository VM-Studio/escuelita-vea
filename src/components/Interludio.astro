---
// Interludio emotivo: frase en cursiva. Dos variantes, ninguna en "foto a un costado / texto al otro":
//  · sobre  → foto a sangre con la frase grande encima (banda cinematográfica)
//  · lado / centro → frase centrada enorme sobre papel, con la foto chica "colgada" debajo
import Foto from './Foto.astro';
import Paleta from './Paleta.astro';
interface Props {
  foto: string;
  frase: string;
  firma?: string;
  variante?: 'sobre' | 'lado' | 'centro';
  ratio?: string;
  trazo?: string;
}
const { foto, frase, firma, variante = 'sobre' } = Astro.props;
---
{variante === 'sobre' ? (
  <section class="interludio interludio--sobre" aria-label="Frase">
    <div class="interludio__foto">
      <div data-parallax="6" class="interludio__parallax">
        <Foto id={foto} ratio="16/9" sizes="100vw" />
      </div>
    </div>
    <div class="interludio__velo" aria-hidden="true"></div>
    <figure class="interludio__texto contenedor">
      <blockquote><p class="t-frase interludio__frase" data-frase>{frase}</p></blockquote>
      {firma && <figcaption class="rotulo rotulo--claro interludio__firma">— {firma}</figcaption>}
    </figure>
  </section>
) : (
  <section class="interludio interludio--centro" aria-label="Frase">
    <figure class="contenedor interludio__caja">
      <Paleta class="interludio__paleta" />
      <blockquote><p class="t-frase interludio__frase interludio__frase--tinta" data-frase>{frase}</p></blockquote>
      {firma && <figcaption class="rotulo interludio__firma">— {firma}</figcaption>}
      <div class="pegada interludio__pegada" data-revelar>
        <span class="cinta" aria-hidden="true"></span>
        <Foto id={foto} ratio="4/3" sizes="(min-width: 48em) 22rem, 70vw" />
      </div>
    </figure>
  </section>
)}

<style>
  .interludio--sobre { position: relative; overflow: hidden; color: var(--papel); min-height: 64vh; display: flex; align-items: flex-end; }
  .interludio__foto { position: absolute; top: 0; left: 0; right: 0; bottom: 0; overflow: hidden; }
  .interludio__parallax { position: absolute; top: -8%; left: 0; right: 0; bottom: -8%; }
  .interludio__parallax :global(.foto) { height: 100%; }
  .interludio__parallax :global(.foto--recorte::before) { display: none; }
  .interludio__velo { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(to top, rgba(16, 12, 9, 0.72) 0%, rgba(16, 12, 9, 0.25) 45%, rgba(16, 12, 9, 0) 75%); }
  .interludio__texto { position: relative; padding-top: 28vh; padding-bottom: 2.5rem; padding-bottom: clamp(2rem, 5vw, 4.5rem); }
  .interludio__frase { max-width: 22ch; font-size: 2rem; font-size: clamp(2rem, 1rem + 4vw, 5rem); line-height: 1.02; color: var(--papel); }
  .interludio__firma { margin-top: 1rem; }

  .interludio--centro { padding: 4rem 0 4.5rem; padding: clamp(3.5rem, 2rem + 5vw, 7rem) 0; overflow: hidden; }
  .interludio__caja { margin: 0 auto; text-align: center; display: flex; flex-direction: column; align-items: center; }
  .interludio__paleta { margin-bottom: 1.5rem; }
  .interludio__frase--tinta { color: var(--tinta); max-width: 20ch; margin: 0 auto; font-size: 2rem; font-size: clamp(1.9rem, 1rem + 3.6vw, 4.4rem); line-height: 1.06; }
  .interludio--centro .interludio__firma { margin-top: 1rem; }
  .interludio__pegada { position: relative; width: 72%; max-width: 22rem; margin-top: 2.5rem; --rot: -2deg; }
</style>
