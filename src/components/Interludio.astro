---
// Interludio emotivo: foto grande + frase en cursiva (recurso pedido por la escuela).
import Foto from './Foto.astro';
import Trazo from './Trazo.astro';
interface Props {
  foto: string;
  frase: string;
  firma?: string;
  variante?: 'sobre' | 'lado' | 'centro';
  ratio?: string;
  trazo?: 'sol' | 'hoja' | 'espiral' | 'estrella' | 'garabato' | 'corazon';
}
const { foto, frase, firma, variante = 'sobre', ratio, trazo = 'hoja' } = Astro.props;
---
<section class:list={['interludio', `interludio--${variante}`]} aria-label="Frase">
  {variante === 'sobre' ? (
    <div class="interludio__marco">
      <div class="interludio__foto" data-parallax-caja>
        <div data-parallax="6" class="interludio__parallax">
          <Foto id={foto} ratio={ratio ?? '16/9'} sizes="100vw" class="interludio__img" />
        </div>
      </div>
      <div class="interludio__velo" aria-hidden="true"></div>
      <figure class="interludio__texto contenedor">
        <blockquote><p class="t-frase interludio__frase" data-frase>{frase}</p></blockquote>
        {firma && <figcaption class="interludio__firma">— {firma}</figcaption>}
      </figure>
    </div>
  ) : (
    <div class="contenedor interludio__grilla">
      <div class="pegada interludio__pegada" style="--rot:-1.6deg" data-revelar>
        <span class="cinta" aria-hidden="true"></span>
        <Foto id={foto} ratio={ratio ?? '4/5'} sizes="(min-width: 64em) 40vw, 90vw" />
      </div>
      <figure class="interludio__lado">
        <Trazo nombre={trazo} class="interludio__trazo" grosor={2.4} />
        <blockquote><p class="t-frase interludio__frase interludio__frase--tinta" data-frase>{frase}</p></blockquote>
        {firma && <figcaption class="interludio__firma interludio__firma--tinta">— {firma}</figcaption>}
      </figure>
    </div>
  )}
</section>

<style>
  .interludio { position: relative; }
  .interludio--sobre { padding: 0; }
  .interludio__marco { position: relative; overflow: hidden; color: var(--papel); min-height: 70vh; display: flex; align-items: flex-end; }
  .interludio__foto { position: absolute; top: 0; left: 0; right: 0; bottom: 0; overflow: hidden; }
  .interludio__parallax { position: absolute; top: -8%; left: 0; right: 0; bottom: -8%; }
  .interludio__parallax :global(.foto) { height: 100%; }
  .interludio__parallax :global(.foto--recorte::before) { display: none; }
  .interludio__velo {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to top, rgba(20, 16, 12, 0.72) 0%, rgba(20, 16, 12, 0.35) 38%, rgba(20, 16, 12, 0) 70%);
  }
  .interludio__texto { position: relative; padding-top: 30vh; padding-bottom: 3.5rem; padding-bottom: clamp(2.5rem, 6vw, 6rem); }
  .interludio__frase {
    max-width: 20ch;
    font-size: 2rem;
    font-size: clamp(1.875rem, 1.1rem + 3.6vw, 4.25rem);
    color: var(--papel);
    text-shadow: 0 1px 24px rgba(0, 0, 0, 0.25);
  }
  .interludio__firma { margin-top: 1rem; font-family: var(--f-texto); font-weight: 600; letter-spacing: 0.04em; color: #f1e9da; }

  .interludio--lado, .interludio--centro { padding-top: 4rem; padding-bottom: 4rem; padding-top: var(--seccion); padding-bottom: var(--seccion); }
  .interludio__grilla { display: grid; grid-template-columns: 1fr; grid-gap: 3rem; gap: 3rem; align-items: center; }
  .interludio__pegada { position: relative; max-width: 30rem; margin: 0 auto; width: 88%; }
  .interludio__lado { position: relative; }
  .interludio__trazo { width: 3.5rem; height: 3.5rem; margin-bottom: 1.25rem; }
  .interludio__frase--tinta {
    color: var(--tinta);
    max-width: 18ch;
    font-size: 2rem;
    font-size: clamp(1.875rem, 1.1rem + 3vw, 3.75rem);
    text-shadow: none;
  }
  .interludio__firma--tinta { color: var(--tinta-suave); }
  @media (min-width: 56em) {
    .interludio__grilla { grid-template-columns: 5fr 6fr; grid-gap: 5rem; gap: 5rem; }
    .interludio--centro .interludio__grilla { grid-template-columns: 6fr 5fr; }
    .interludio--centro .interludio__pegada { order: 2; }
  }
</style>
