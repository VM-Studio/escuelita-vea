---
// Portada de páginas internas: foto a pantalla completa con titular (o versión papel sin foto).
import Foto from './Foto.astro';
import Trazo from './Trazo.astro';
interface Props {
  titulo: string;
  volanta?: string;
  foto?: string;
  alto?: 'completo' | 'medio';
  nivel?: 'jardin' | 'primaria';
}
const { titulo, volanta, foto, alto = 'completo' } = Astro.props;
---
<section class:list={['portada', `portada--${alto}`, { 'portada--papel': !foto }]} data-hero>
  {foto && (
    <div class="portada__fondo" data-hero-fondo>
      <div class="portada__parallax" data-hero-parallax>
        <Foto id={foto} ratio="16/9" sizes="100vw" prioridad class="portada__foto" celular />
      </div>
    </div>
  )}
  {foto && <div class="portada__velo" aria-hidden="true"></div>}
  <div class="portada__contenido contenedor">
    {volanta && <p class="t-volanta portada__volanta" data-hero-resto>{volanta}</p>}
    <h1 class="portada__titulo" data-hero-titular>{titulo}</h1>
    <div class="portada__extra" data-hero-resto><slot /></div>
  </div>
  {foto && (
    <div class="portada__scroll" aria-hidden="true" data-hero-trazo>
      <Trazo nombre="scroll" color="actual" grosor={2} dibujar={false} crayon={false} />
    </div>
  )}
</section>

<style>
  .portada { position: relative; display: flex; align-items: flex-end; overflow: hidden; }
  .portada--completo { min-height: 100vh; min-height: 100svh; }
  @supports (height: 100dvh) { .portada--completo { min-height: 100dvh; } }
  .portada--completo { max-height: 1100px; }
  .portada--medio { min-height: 72vh; }
  .portada:not(.portada--papel) { color: var(--papel); background: var(--tinta); }
  .portada__fondo { position: absolute; top: 0; left: 0; right: 0; bottom: 0; overflow: hidden; }
  .portada__parallax { position: absolute; top: 0; left: 0; right: 0; bottom: -10%; }
  .portada__parallax :global(.foto) { height: 100%; }
  .portada__parallax :global(.foto--recorte::before) { display: none; }
  .portada__velo {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background:
      linear-gradient(to top, rgba(18, 14, 10, 0.62) 0%, rgba(18, 14, 10, 0.3) 32%, rgba(18, 14, 10, 0.04) 58%, rgba(18, 14, 10, 0) 72%),
      linear-gradient(to bottom, rgba(18, 14, 10, 0.22) 0%, rgba(18, 14, 10, 0) 20%);
  }
  .portada__contenido { position: relative; padding-top: calc(var(--header-h) + 2.04rem); padding-bottom: 3.06rem; padding-bottom: clamp(2.38rem, 8vh, 4.76rem); }
  .portada--papel .portada__contenido { padding-top: calc(var(--header-h) + 3.4rem); padding-bottom: 2.04rem; }
  .portada--papel { min-height: 0; }
  .portada__volanta { margin-bottom: 1.25rem; }
  .portada:not(.portada--papel) .portada__volanta { color: var(--arena); }
  .portada__titulo {
    max-width: 18ch;
    font-size: 1.65rem;
    font-size: var(--t-3xl);
    color: inherit;
    font-weight: 330;
  }
  .portada:not(.portada--papel) .portada__titulo { text-shadow: 0 2px 30px rgba(0, 0, 0, 0.25); }
  .portada__extra { margin-top: 1.488rem; max-width: 40rem; }
  .portada__scroll { position: absolute; right: var(--gutter); bottom: 1.5rem; width: 1.28rem; height: 2.88rem; color: var(--papel); opacity: 0.85; }
  .portada__scroll :global(svg) { width: 100%; height: 100%; }
  @media (max-width: 40em) { .portada__scroll { display: none; } }
</style>
