---
// Capa de "rastro de imágenes" (ImageTrail de React Bits, MIT + Commons Clause). Decorativa: aria-hidden.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { ids: string[]; size?: number; aspectRatio?: number; radius?: number; config?: Record<string, unknown>; class?: string }
const { ids, size = 170, aspectRatio = 0.8, radius = 6, config = {}, class: clase = '' } = Astro.props;
const masters = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos/*.jpg', { eager: true });
const urls = await Promise.all(ids.map(async (id) => {
  const src = masters[`../assets/fotos/${id}.jpg`]?.default;
  return src ? (await getImage({ src, width: size * 2, height: Math.round((size / aspectRatio) * 2), fit: 'cover', format: 'webp' })).src : '';
}));
---
<div class:list={['rastro', clase]} data-rastro data-config={JSON.stringify(config)} style={`--trail-size:${size}px;--trail-aspect:${aspectRatio};--trail-radius:${radius}px`} aria-hidden="true">
  {urls.map((u) => <div class="rastro__img" data-trail-image><div class="rastro__inner" data-bg={u}></div></div>)}
</div>
<script>
  import { iniciarRastro } from '../scripts/reactbits/rastro-imagenes';
  const ok = window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 1024px)').matches
    && !window.matchMedia('(prefers-reduced-motion: reduce)').matches
    && !document.documentElement.classList.contains('liviano');
  if (ok) document.querySelectorAll<HTMLElement>('[data-rastro]').forEach((c) => {
    const escucha = (c.closest('[data-hero]') as HTMLElement) || c.parentElement || c;
    const go = () => iniciarRastro(c, escucha);
    escucha.addEventListener('mousemove', go, { once: true });
  });
</script>
<style>
  .rastro { position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none; overflow: hidden; }
  .rastro__img {
    position: absolute; top: 0; left: 0;
    width: var(--trail-size); height: calc(var(--trail-size) / var(--trail-aspect));
    border-radius: var(--trail-radius);
    opacity: 0; overflow: hidden; pointer-events: none;
    will-change: transform, filter;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.45);
    border: 4px solid #fffdf8;
  }
  .rastro__inner { position: absolute; top: -10px; left: -10px; width: calc(100% + 20px); height: calc(100% + 20px); background-size: cover; background-position: 50% 50%; }
</style>
