---
// Lista con foto que cambia (idea "We [foto] crear / conectar…" de Fine Acts, Awwwards):
// a la izquierda una palabra, en el medio una foto que cambia según el ítem activo, a la derecha la lista.
// Cada ítem despliega su texto. Sin JS: todos los textos visibles y una foto por ítem.
import Foto from './Foto.astro';
interface Item { titulo: string; texto: string; foto: string }
interface Props { palabra: string; items: Item[]; id?: string }
const { palabra, items, id = 'lista-foto' } = Astro.props;
---
<div class="lf" data-lista-foto id={id}>
  <p class="lf__palabra" aria-hidden="true">{palabra}</p>
  <div class="lf__fotos" aria-hidden="true">
    {items.map((it, i) => (
      <div class:list={['lf__foto', { 'is-activa': i === 0 }]} data-lf-foto>
        <Foto id={it.foto} ratio="4/5" sizes="(min-width: 64em) 16rem, 60vw" alt="" />
      </div>
    ))}
  </div>
  <ol class="lf__lista">
    {items.map((it, i) => (
      <li class:list={['lf__item', { 'is-activo': i === 0 }]} data-lf-item>
        <h3 class="lf__titulo"><button type="button" class="lf__boton" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`${id}-${i}`}>{it.titulo}</button></h3>
        <div class="lf__texto" id={`${id}-${i}`}><p>{it.texto}</p></div>
        <div class="lf__mini"><Foto id={it.foto} ratio="16/9" sizes="90vw" /></div>
      </li>
    ))}
  </ol>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-lista-foto]').forEach((c) => {
    c.classList.add('is-js');
    const items = Array.prototype.slice.call(c.querySelectorAll<HTMLElement>('[data-lf-item]')) as HTMLElement[];
    const fotos = Array.prototype.slice.call(c.querySelectorAll<HTMLElement>('[data-lf-foto]')) as HTMLElement[];
    const activar = (n: number) => items.forEach((it, i) => {
      const on = i === n;
      it.classList.toggle('is-activo', on);
      it.querySelector('button')!.setAttribute('aria-expanded', String(on));
      fotos[i].classList.toggle('is-activa', on);
    });
    items.forEach((it, i) => {
      it.querySelector('button')!.addEventListener('click', () => activar(i));
      it.addEventListener('mouseenter', () => { if (window.matchMedia('(hover: hover)').matches) activar(i); });
    });
  });
</script>

<style>
  .lf { display: grid; grid-template-columns: 1fr; grid-gap: 1.5rem; gap: 1.5rem; align-items: start; }
  .lf__palabra { display: none; }
  .lf__fotos { display: none; }
  .lf__lista { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(35, 32, 28, 0.16); }
  .lf__item { border-bottom: 1px solid rgba(35, 32, 28, 0.16); }
  .lf__titulo { margin: 0; }
  .lf__boton { display: flex; width: 100%; align-items: center; justify-content: space-between; padding: 0.85rem 0; border: 0; background: none; text-align: left; font-family: var(--f-titulo); font-weight: 350; font-size: 1.35rem; font-size: clamp(1.25rem, 1rem + 0.9vw, 1.75rem); letter-spacing: -0.02em; color: var(--tinta-tenue); transition: color 0.3s, transform 0.4s var(--ease-out); cursor: pointer; }
  .lf__boton::after { content: '+'; font-family: var(--f-texto); font-size: 1rem; color: var(--tinta-tenue); transition: transform 0.4s var(--ease-out); }
  .lf__item.is-activo .lf__boton { color: var(--tinta); }
  .lf__item.is-activo .lf__boton::after { transform: rotate(45deg); color: var(--acento); }
  .lf__texto p { max-width: 34rem; font-size: 0.95rem; color: var(--tinta-suave); padding-bottom: 1rem; }
  .lf__mini { margin-bottom: 1rem; }
  .lf__mini :global(.foto) { border-radius: 4px; }
  /* Con JS: solo el activo abierto */
  .lf.is-js .lf__item:not(.is-activo) .lf__texto, .lf.is-js .lf__item:not(.is-activo) .lf__mini { display: none; }
  .lf.is-js .lf__item.is-activo .lf__texto { animation: lf-entra 0.5s var(--ease-out); }
  @keyframes lf-entra { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (min-width: 64em) {
    .lf { grid-template-columns: auto 16rem 1fr; grid-gap: 2.5rem; gap: 2.5rem; align-items: center; }
    .lf__palabra { display: block; font-family: var(--f-titulo); font-style: italic; font-weight: 300; font-size: 2.2rem; color: var(--acento-texto); }
    .lf__fotos { display: block; position: relative; width: 16rem; height: 20rem; aspect-ratio: 4 / 5; border-radius: 6px; overflow: hidden; box-shadow: 0 24px 40px -24px rgba(60, 40, 20, 0.55); }
    .lf__foto { position: absolute; top: 0; left: 0; right: 0; bottom: 0; opacity: 0; transform: scale(1.06); transition: opacity 0.6s var(--ease-suave), transform 0.9s var(--ease-out); }
    .lf__foto.is-activa { opacity: 1; transform: none; }
    .lf__foto :global(.foto) { height: 100%; }
    .lf__foto :global(.foto--recorte::before) { display: none; }
    .lf.is-js .lf__mini { display: none !important; }
    .lf__boton:hover { transform: translateX(6px); color: var(--tinta); }
  }
</style>
