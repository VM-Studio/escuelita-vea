---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITIO, NIVELES } from '../config/sitio';
import Encabezado from '../components/Encabezado.astro';
import PieSitio from '../components/PieSitio.astro';
import WhatsAppFlotante from '../components/WhatsAppFlotante.astro';
import Cargador from '../components/Cargador.astro';

interface Props {
  titulo: string;
  descripcion: string;
  nivel?: 'jardin' | 'primaria';
  heroOscuro?: boolean;
  fotoOg?: string;
  noIndexar?: boolean;
  progreso?: boolean;
  precargar?: { srcset: string; sizes: string; type: string }[];
}
const { titulo, descripcion, nivel, heroOscuro = false, fotoOg = 'patio-abrazo-arbol', noIndexar = false, progreso = false, precargar = [] } = Astro.props;

const tituloCompleto = Astro.url.pathname === '/' ? `${SITIO.nombre} · Educación por el Arte desde 1959` : `${titulo} · ${SITIO.nombre}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const masters = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos/*.jpg', { eager: true });
const og = masters[`../assets/fotos/${fotoOg}.jpg`]?.default;
const ogImg = og ? await getImage({ src: og, width: 1200, height: 630, fit: 'cover', format: 'jpg' }) : null;
const ogUrl = ogImg ? new URL(ogImg.src, Astro.site).href : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: 'La Escuelita',
  alternateName: ['La Escuelita V.E.A.', 'Instituto La Escuelita', 'Primer Jardín Argentino de Educación por el Arte'],
  url: SITIO.url,
  logo: new URL('/logos/escuelita-vea-provisorio.png', Astro.site).href,
  foundingDate: String(SITIO.anioFundacion),
  founder: { '@type': 'Person', name: 'Marta Calvo' },
  parentOrganization: { '@type': 'Organization', name: 'Asociación Civil V.E.A. (Visión Educacional Antropológica)' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITIO.direccion.calle,
    addressLocality: 'Ciudad Autónoma de Buenos Aires',
    postalCode: SITIO.direccion.cp,
    addressCountry: 'AR',
  },
  email: NIVELES.jardin.mail,
  telephone: NIVELES.jardin.tel,
  contactPoint: [
    { '@type': 'ContactPoint', contactType: 'admisión Jardín', telephone: NIVELES.jardin.tel, email: NIVELES.jardin.mail, availableLanguage: 'es' },
    { '@type': 'ContactPoint', contactType: 'admisión Primaria', telephone: NIVELES.primaria.tel, email: NIVELES.primaria.mail, availableLanguage: 'es' },
  ],
};
---
<!doctype html>
<html lang="es-AR" class="no-js" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    {noIndexar && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#faf6ee" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="La Escuelita" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/fonts/fraunces-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/figtree-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    {precargar.map((p) => <link rel="preload" as="image" imagesrcset={p.srcset} imagesizes={p.sizes} type={p.type} fetchpriority="high" />)}

    {/* Arranque: marca JS, detecta "modo liviano", movimiento reducido y si corresponde el loader. */}
    <script is:inline>
      (function (d, w) {
        var h = d.documentElement, n = w.navigator || {}, c = n.connection || {};
        h.className = h.className.replace('no-js', 'js');
        var basicas = 'IntersectionObserver' in w && 'Promise' in w && 'requestAnimationFrame' in w && w.CSS && CSS.supports && CSS.supports('--a', '0');
        var liviano = !basicas || c.saveData === true || (n.deviceMemory && n.deviceMemory <= 2) || (n.hardwareConcurrency && n.hardwareConcurrency <= 2);
        try { if (/[?&]liviano\b/.test(w.location.search)) liviano = true; } catch (e) {}
        var reducido = w.matchMedia && w.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (liviano) h.className += ' liviano';
        if (reducido) h.className += ' reducido';
        var visto = '1';
        try { visto = w.sessionStorage.getItem('le-cargador'); w.sessionStorage.setItem('le-cargador', '1'); } catch (e) { visto = '1'; }
        var grande = w.matchMedia && w.matchMedia('(min-width: 1024px)').matches; // en celulares no: el loader taparía la primera pintura (LCP)
        if (!visto && !liviano && basicas && grande) h.className += ' con-cargador';
      })(document, window);
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class:list={[nivel && `nivel-${nivel}`]}>
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    {/* Filtro de crayón compartido por todos los trazos (barato: solo SVG chicos) */}
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="crayon" x="-5%" y="-20%" width="110%" height="140%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="3" result="ruido" />
        <feDisplacementMap in="SourceGraphic" in2="ruido" scale="1.6" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <Cargador />
    {progreso && <div class="progreso-lectura" aria-hidden="true"><span data-progreso></span></div>}
    <Encabezado sobreHero={heroOscuro} />

    <main id="contenido" tabindex="-1">
      <slot />
    </main>

    <PieSitio />
    <WhatsAppFlotante />

    <script>
      import '../scripts/interfaz';
      import '../scripts/animaciones';
    </script>
  </body>
</html>

<style is:global>
  main:focus { outline: none; }
  .progreso-lectura {
    position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 60;
    pointer-events: none;
  }
  .progreso-lectura span {
    display: block; height: 100%; width: 100%;
    background: var(--acento);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  html.liviano .trazo g { filter: none; }
</style>
