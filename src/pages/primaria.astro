---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Trazo from '../components/Trazo.astro';
import PortadaPagina from '../components/PortadaPagina.astro';
import SubNav from '../components/SubNav.astro';
import Tabs from '../components/Tabs.astro';
import Desplegable from '../components/Desplegable.astro';
import Interludio from '../components/Interludio.astro';
import Galeria from '../components/Galeria.astro';
import TarjetaProyecto from '../components/TarjetaProyecto.astro';
import VideoLitio from '../components/VideoLitio.astro';
import LlamadoEntrevista from '../components/LlamadoEntrevista.astro';
import { primaria as p } from '../content/primaria';
import { parrafos, enLinea } from '../lib/texto';

const subnav = [
  { href: '#como-aprendemos', texto: 'Cómo aprendemos' },
  { href: '#areas', texto: 'Áreas de aprendizaje' },
  { href: '#proyectos', texto: 'Proyectos destacados' },
  { href: '#secundaria', texto: 'Preparación para la secundaria' },
];
---
<Base
  titulo="Primaria"
  descripcion="Instituto La Escuelita, Escuela Primaria de Educación a través del Arte (1997): aprendizaje por proyectos, la ronda pedagógica, áreas integradas y preparación para la secundaria."
  nivel="primaria"
  heroOscuro
  fotoOg={p.portada.foto}
  progreso
>
  <PortadaPagina titulo={p.portada.titulo} volanta="Primaria · Nivel Primario" foto={p.portada.foto}>
    <p class="portada-sub">{p.portada.subtitulo}</p>
  </PortadaPagina>

  <section class="seccion cita-nivel" aria-label="Presentación de la Primaria">
    <div class="contenedor cita-nivel__grilla">
      <figure class="cita-nivel__cita">
        <Trazo nombre="hoja" class="cita-nivel__trazo" grosor={2.2} color="verde" />
        <blockquote><p class="t-frase cita-nivel__texto" data-frase>{p.portada.cita}</p></blockquote>
        <figcaption class="cita-nivel__firma" data-revelar>— {p.portada.citaFirma}</figcaption>
      </figure>
      <p class="cita-nivel__parrafo" data-revelar>{p.portada.texto}</p>
    </div>
  </section>

  <SubNav items={subnav} etiqueta="Secciones de la Primaria" />

  <!-- Cómo aprendemos -->
  <section class="seccion ancla" id="como-aprendemos" aria-labelledby="ca-titulo">
    <div class="contenedor contenedor--ancho">
      <div class="cabecera-seccion">
        <h2 id="ca-titulo" data-titulo-lineas>{p.comoAprendemos.titulo}</h2>
      </div>
      <div class="copete" data-revelar>
        <h3 class="copete__titulo">{p.comoAprendemos.copeteTitulo}</h3>
        <p class="copete__texto">{p.comoAprendemos.copete}</p>
      </div>
      <div class="ca__desplegable" data-revelar>
        <Desplegable id="convivencia" boton="Seguir leyendo" botonCerrar="Cerrar" centrado={false}>
          <div class="convivencia">
            <div class="convivencia__col">
              <h3 class="convivencia__titulo">{p.comoAprendemos.convivenciaTitulo}</h3>
              <div class="prosa" set:html={parrafos(p.comoAprendemos.convivencia)} />
            </div>
            <aside class="ronda-caja">
              <Trazo nombre="ronda" class="ronda-caja__trazo" grosor={2.2} color="verde" />
              <h3 class="ronda-caja__titulo">{p.comoAprendemos.ronda.etiqueta}</h3>
              <p>{p.comoAprendemos.ronda.texto}</p>
            </aside>
          </div>
        </Desplegable>
      </div>
    </div>
  </section>

  <Interludio foto={p.interludioGrupal.foto} frase={p.interludioGrupal.frase} variante="lado" trazo="ronda" ratio="1/1" />

  <!-- Áreas de aprendizaje -->
  <section class="seccion seccion--acento ancla" id="areas" aria-labelledby="areas-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <h2 id="areas-titulo" data-titulo-lineas>{p.areas.titulo}</h2>
      </div>
      <div class="areas-intro">
        <p class="areas-intro__texto" data-revelar>{p.areas.intro}</p>
        <div class="ciclos">
          {p.areas.ciclos.map((c, i) => (
            <div class="ciclo" data-revelar>
              <Trazo nombre={i ? 'espiral' : 'sol'} class="ciclo__trazo" grosor={2.2} color="verde" />
              <h3 class="ciclo__titulo">{c.etiqueta}</h3>
              <p>{c.texto}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="areas-botonera">
        <Tabs items={p.areas.items.map((a) => ({ id: a.id, texto: a.boton }))} etiqueta="Áreas" variante="chips">
          {p.areas.items.map((a) => (
            <section class="tabs__panel area" id={a.id} data-panel aria-labelledby={`${a.id}-h`}>
              <div class:list={['area__grilla', { 'area__grilla--sin-foto': !a.fotos.length && !('penas' in a) }]}>
                <div class="area__texto">
                  <h3 class="area__titulo" id={`${a.id}-h`}>{a.titulo}</h3>
                  <div class="prosa" set:html={parrafos(a.texto)} />
                  {'lista' in a && a.lista && (
                    <ul class="area__lista">
                      {a.lista.map((l) => <li><strong>{l.etiqueta}:</strong> <span set:html={enLinea(l.texto)} /></li>)}
                    </ul>
                  )}
                  {'rap' in a && a.rap && (
                    <div class="area__rap">
                      <p><strong>{a.rap.etiqueta}:</strong> {a.rap.texto}</p>
                      <VideoLitio titulo={a.rap.etiqueta} />
                    </div>
                  )}
                </div>
                {a.fotos.length > 0 && (
                  <div class:list={['area__fotos', { 'area__fotos--dos': a.fotos.length > 1 }]}>
                    {a.fotos.map((f, k) => (
                      <Foto id={f} ratio={a.fotos.length > 1 ? (k ? '4/3' : '4/5') : '4/3'} sizes="(min-width: 56em) 40vw, 90vw" pie={k === 0 && 'frase' in a ? a.frase : undefined} />
                    ))}
                  </div>
                )}
                {'penas' in a && a.penas && (
                  <div class="area__penas">
                    <h4 class="area__penas-titulo">{a.penas.titulo}</h4>
                    <Galeria ids={a.penas.fotos} variante="pegadas" sizes="(min-width: 56em) 20vw, 45vw" ratio="4/3" class="area__penas-galeria" />
                  </div>
                )}
              </div>
            </section>
          ))}
        </Tabs>
      </div>
    </div>
  </section>

  <Interludio foto={p.interludioAcontecimiento.foto} frase={p.interludioAcontecimiento.frase} />

  <!-- Proyectos destacados -->
  <section class="seccion ancla" id="proyectos" aria-labelledby="proy-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <h2 id="proy-titulo" data-titulo-lineas>{p.proyectos.titulo}</h2>
      </div>
      <div class="proyectos">
        {p.proyectos.items.map((pr, i) => <TarjetaProyecto id={pr.id} titulo={pr.titulo} texto={pr.texto} foto={pr.foto} trazo={pr.trazo} indice={i} />)}
      </div>
    </div>
  </section>

  <Interludio foto={p.interludioArboles.foto} frase={p.interludioArboles.frase} variante="lado" trazo="hoja" ratio="4/5" />

  <!-- Preparación para la secundaria -->
  <section class="seccion ancla" id="secundaria" aria-labelledby="sec-titulo">
    <div class="contenedor">
      <div class="secundaria">
        <Trazo nombre="flecha" class="secundaria__flecha" grosor={2.6} color="verde" />
        <h2 id="sec-titulo" class="secundaria__h2" data-titulo-lineas>{p.secundaria.titulo}</h2>
        <h3 class="secundaria__pregunta" data-revelar>{p.secundaria.pregunta}</h3>
        <p class="sr-only">{p.secundaria.habilidadesTexto}</p>
        <ul class="habilidades" data-de-a-una aria-hidden="true">
          {p.secundaria.habilidades.map((h, i) => (
            <li class:list={['habilidad', { 'habilidad--cursiva': i % 2 === 1 }]} data-palabra>{h}{i < p.secundaria.habilidades.length - 1 ? (i === p.secundaria.habilidades.length - 2 ? ' y' : ',') : '.'}</li>
          ))}
        </ul>
        <div class="secundaria__texto prosa" data-revelar set:html={parrafos(p.secundaria.texto)} />
      </div>
    </div>
  </section>

  <LlamadoEntrevista nivel="primaria" foto="primaria-escribiendo-juntos" titulo="Vení a conocer la Primaria" />
</Base>

<style>
  .portada-sub { font-family: var(--f-frase); font-style: italic; font-size: 1.375rem; font-size: clamp(1.25rem, 1rem + 1.2vw, 2rem); color: #f6efe3; max-width: 30ch; line-height: 1.3; }

  .cita-nivel__grilla { display: grid; grid-template-columns: 1fr; grid-gap: 2.5rem; gap: 2.5rem; align-items: start; }
  .cita-nivel__trazo { width: 2.5rem; height: 3.5rem; margin-bottom: 1rem; }
  .cita-nivel__texto { font-size: 1.75rem; font-size: clamp(1.625rem, 1.1rem + 2.3vw, 3rem); max-width: 24ch; }
  .cita-nivel__firma { margin-top: 1rem; font-weight: 650; color: var(--verde-texto); }
  .cita-nivel__parrafo { font-size: 1.125rem; font-size: var(--t-md); line-height: 1.6; }
  @media (min-width: 56em) { .cita-nivel__grilla { grid-template-columns: 7fr 5fr; grid-gap: 5rem; gap: 5rem; } .cita-nivel__parrafo { margin-top: 5rem; } }

  .copete { max-width: 44rem; }
  .copete__titulo { font-size: 1.5rem; font-size: var(--t-lg); margin-bottom: 1rem; }
  .copete__texto { font-size: 1.125rem; font-size: var(--t-md); line-height: 1.6; }
  .ca__desplegable { margin-top: 2.5rem; }
  .convivencia { display: grid; grid-template-columns: 1fr; grid-gap: 2.5rem; gap: 2.5rem; align-items: start; }
  .convivencia__titulo { font-size: 1.375rem; font-size: var(--t-lg); margin-bottom: 1.25rem; max-width: 30ch; }
  .ronda-caja { padding: 2rem; padding: clamp(1.5rem, 3.5vw, 2.5rem); background: var(--verde); color: #fff; border-radius: var(--radio-lg); }
  .ronda-caja__trazo { width: 3.25rem; height: 3.25rem; margin-bottom: 1rem; color: #fff !important; }
  .ronda-caja__titulo { color: #fff; font-size: 1.625rem; font-size: var(--t-xl); margin-bottom: 1rem; }
  .ronda-caja p { color: #f2f6ee; }
  @media (min-width: 56em) { .convivencia { grid-template-columns: 7fr 5fr; grid-gap: 4rem; gap: 4rem; } }

  .areas-intro { display: grid; grid-template-columns: 1fr; grid-gap: 2.5rem; gap: 2.5rem; margin-bottom: 4rem; }
  .areas-intro__texto { font-size: 1.125rem; font-size: var(--t-md); line-height: 1.6; }
  .ciclos { display: grid; grid-template-columns: 1fr; grid-gap: 1.5rem; gap: 1.5rem; }
  .ciclo { padding: 1.5rem; background: var(--papel); border-radius: var(--radio-lg); }
  .ciclo__trazo { width: 2.5rem; height: 2.5rem; margin-bottom: 0.6rem; }
  .ciclo__titulo { font-size: 1.25rem; margin-bottom: 0.5rem; }
  @media (min-width: 56em) { .areas-intro { grid-template-columns: 6fr 5fr; grid-gap: 4rem; gap: 4rem; } }

  .area__grilla { display: grid; grid-template-columns: 1fr; grid-gap: 2rem; gap: 2rem; align-items: start; padding: 2rem; padding: clamp(1.25rem, 3vw, 2.75rem); background: var(--papel); border-radius: var(--radio-lg); }
  .area__titulo { font-size: 1.875rem; font-size: var(--t-xl); margin-bottom: 1.25rem; }
  .area__lista { margin-top: 1.25rem; padding-left: 1.1rem; }
  .area__lista li + li { margin-top: 0.6rem; }
  .area__rap { margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid rgba(35, 32, 28, 0.14); }
  .area__rap > * + * { margin-top: 1rem; }
  .area__fotos :global(.foto) { border-radius: var(--radio); }
  .area__fotos :global(figcaption) { margin-top: 0.6rem; font-size: 1.125rem; color: var(--tinta); }
  .area__fotos--dos { display: grid; grid-template-columns: 1fr 1fr; grid-gap: 1rem; gap: 1rem; align-items: start; }
  .area__fotos--dos > :global(*:nth-child(2)) { margin-top: 2.5rem; }
  .area__penas-titulo { font-family: var(--f-titulo); font-weight: 400; font-size: 1.375rem; margin-bottom: 1.25rem; }
  .area__penas :global(.galeria--pegadas) { grid-template-columns: 1fr 1fr; }
  @media (min-width: 56em) {
    .area__grilla { grid-template-columns: 6fr 5fr; grid-gap: 3.5rem; gap: 3.5rem; }
    .area__grilla--sin-foto { grid-template-columns: 1fr; }
    .area__grilla--sin-foto .area__texto { max-width: 44rem; }
  }

  .proyectos { display: grid; grid-template-columns: 1fr; grid-gap: 1.5rem; gap: 1.5rem; align-items: start; }
  @media (min-width: 56em) {
    .proyectos { grid-template-columns: 1fr 1fr; grid-gap: 2rem; gap: 2rem; }
    .proyectos > :global(*:nth-child(2n)) { margin-top: 4rem; }
  }

  .secundaria {
    position: relative;
    padding: 2.5rem 1.5rem;
    padding: clamp(2rem, 6vw, 5.5rem) clamp(1.25rem, 6vw, 5.5rem);
    background: var(--verde-claro);
    border-radius: var(--radio-lg);
  }
  .secundaria__flecha { width: 4rem; height: 2rem; margin-bottom: 1rem; }
  .secundaria__h2 { max-width: 14ch; }
  .secundaria__pregunta { margin-top: 1.5rem; font-family: var(--f-texto); font-size: 1.125rem; font-weight: 650; max-width: 40ch; }
  .habilidades { display: flex; flex-wrap: wrap; align-items: baseline; margin: 2rem 0 2.5rem; }
  .habilidad {
    margin-right: 0.45em;
    font-family: var(--f-titulo);
    font-size: 2rem;
    font-size: clamp(1.875rem, 1rem + 3.8vw, 4.5rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    font-weight: 330;
  }
  .habilidad--cursiva { font-style: italic; color: var(--verde-texto); }
  .secundaria__texto { columns: 1; }
  @media (min-width: 64em) { .secundaria__texto { column-count: 2; column-gap: 3.5rem; } .secundaria__texto :global(p) { break-inside: avoid; } }
</style>
