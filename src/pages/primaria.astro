---
import Telon from '../components/Telon.astro';
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Trazo from '../components/Trazo.astro';
import PortadaPagina from '../components/PortadaPagina.astro';
import SubNav from '../components/SubNav.astro';
import Acordeon from '../components/Acordeon.astro';
import PasaFotos from '../components/PasaFotos.astro';
import Desplegable from '../components/Desplegable.astro';
import Interludio from '../components/Interludio.astro';
import Galeria from '../components/Galeria.astro';
import TarjetaProyecto from '../components/TarjetaProyecto.astro';
import GaleriaObras from '../components/GaleriaObras.astro';
import VideoLitio from '../components/VideoLitio.astro';
import LlamadoEntrevista from '../components/LlamadoEntrevista.astro';
import { primaria as p } from '../content/primaria';
import { parrafos, enLinea, acento } from '../lib/texto';

const subnav = [
  { href: '#como-aprendemos', texto: 'Cómo aprendemos' },
  { href: '#areas', texto: 'Áreas de aprendizaje' },
  { href: '#proyectos', texto: 'Proyectos destacados' },
  { href: '#secundaria', texto: 'Preparación para la secundaria' },
];
---
<Base
  titulo="Primaria"
  descripcion="Instituto La Escuelita, Escuela Primaria de Educación a través del Arte (1997): aprendizaje por proyectos, la ronda pedagógica, áreas integradas y preparación para la secundaria."
  nivel="primaria"
  heroOscuro
  fotoOg={p.portada.foto}
  progreso
>
  <PortadaPagina titulo={p.portada.titulo} volanta="Primaria · Nivel Primario" foto={p.portada.foto}>
    <p class="portada-sub">{p.portada.subtitulo}</p>
  </PortadaPagina>

  {/* Frase de Marta Calvo en un recuadro colgando de la portada, como el párrafo del Jardín */}
  <div class="contenedor intro-nivel">
    <figure class="nota nota--verde-claro intro-nivel__nota" data-revelar>
      <blockquote><p class="t-frase intro-nivel__cita">{p.portada.cita}</p></blockquote>
      <figcaption class="intro-nivel__firma">— {p.portada.citaFirma}</figcaption>
    </figure>
  </div>

  {/* El párrafo centrado y, debajo, las solapas */}
  <section class="parrafo-nivel" aria-label="Presentación de la Primaria">
    <div class="contenedor">
      <p class="parrafo-nivel__texto" data-revelar>{p.portada.texto}</p>
    </div>
  </section>

  <SubNav items={subnav} etiqueta="Secciones de la Primaria" />

  {/* Cómo aprendemos */}
  <Telon foto="primaria-recreo-sombra-arena" rotulo="Recreo en el fondo de la escuela" alto="bajo" />

  <section class="seccion ancla" id="como-aprendemos" aria-labelledby="ca-titulo">
    <div class="contenedor ca__grilla">
      <div class="ca__texto">
      <div class="cabecera-seccion">
        <h2 id="ca-titulo" data-titulo-lineas set:html={acento(p.comoAprendemos.titulo)} />
      </div>
      <div class="copete" data-revelar>
        <h3 class="copete__titulo">{p.comoAprendemos.copeteTitulo}</h3>
        <p class="copete__texto">{p.comoAprendemos.copete}</p>
      </div>
      <div class="ca__desplegable" data-revelar>
        <Desplegable id="convivencia" boton="Seguir leyendo" botonCerrar="Cerrar" centrado={false}>
          <div class="convivencia">
            <div class="convivencia__col">
              <h3 class="convivencia__titulo">{p.comoAprendemos.convivenciaTitulo}</h3>
              <div class="prosa" set:html={parrafos(p.comoAprendemos.convivencia)} />
            </div>
            <aside class="ronda-caja">
              <h3 class="ronda-caja__titulo">{p.comoAprendemos.ronda.etiqueta}</h3>
              <p>{p.comoAprendemos.ronda.texto}</p>
            </aside>
          </div>
        </Desplegable>
      </div>
      </div>
      {/* Más fotos al lado de "Cómo aprendemos" (pedido de la escuela): galería que pasa */}
      <div class="ca__fotos" data-revelar>
        <PasaFotos items={p.comoAprendemos.fotos.map((id) => ({ id }))} etiqueta="La vida en la Primaria" ratio="4/5" />
      </div>
    </div>
  </section>

  <Interludio foto={p.interludioGrupal.foto} frase={p.interludioGrupal.frase} variante="lado" trazo="ronda" ratio="1/1" />

  {/* Áreas de aprendizaje */}
  <section class="seccion seccion--acento ancla" id="areas" aria-labelledby="areas-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <h2 id="areas-titulo" data-titulo-lineas set:html={acento(p.areas.titulo)} />
      </div>
      <div class="areas-intro">
        <p class="areas-intro__texto" data-revelar>{p.areas.intro}</p>
        <div class="ciclos">
          {p.areas.ciclos.map((c, i) => (
            <div class="ciclo" data-revelar>
              <h3 class="ciclo__titulo">{c.etiqueta}</h3>
              <p>{c.texto}</p>
            </div>
          ))}
        </div>
      </div>

      {/* Misma lógica que los lenguajes del Jardín: zigzag con las áreas desplegables (+) */}
      {p.areas.modulos.map((m, mi) => (
        <article class:list={['modulo', { 'modulo--invertido': mi % 2 === 1 }]} aria-labelledby={`modulo-${mi + 1}`}>
          <div class="modulo__foto" data-revelar>
            <Foto id={m.foto} ratio="4/5" sizes="(min-width: 56em) 42vw, 100vw" />
          </div>
          <div class="modulo__texto">
            <span class="modulo__n" aria-hidden="true">{String(mi + 1).padStart(2, '0')}</span>
            <h3 class="modulo__titulo" id={`modulo-${mi + 1}`}>{m.titulo}</h3>
            <div class="modulo__areas">
              {m.areas.map((aid) => p.areas.items.find((x) => x.id === aid)!).map((a) => (
                <Acordeon id={a.id} titulo={a.titulo} grupo={`modulo-${mi + 1}`} nivelTitulo="h4" class="area-ac">
                  <div class="prosa area__prosa" set:html={parrafos(a.texto)} />
                  {'lista' in a && a.lista && (
                    <ul class="area__lista">
                      {a.lista.map((l) => <li><strong>{l.etiqueta}:</strong> <span set:html={enLinea(l.texto)} /></li>)}
                    </ul>
                  )}
                  {'rap' in a && a.rap && (
                    <div class="area__rap">
                      <p><strong>{a.rap.etiqueta}:</strong> {a.rap.texto}</p>
                      <VideoLitio titulo={a.rap.etiqueta} />
                    </div>
                  )}
                  {a.fotos.filter((f) => f !== m.foto).length > 0 && (
                    <div class="area__fotos">
                      {a.fotos.filter((f) => f !== m.foto).map((f) => <Foto id={f} ratio="4/3" sizes="(min-width: 56em) 18vw, 45vw" />)}
                    </div>
                  )}
                  {'penas' in a && a.penas && (
                    <div class="area__penas">
                      <h5 class="area__penas-titulo">{a.penas.titulo}</h5>
                      <div class="area__fotos">
                        {a.penas.fotos.map((f) => <Foto id={f} ratio="4/3" sizes="(min-width: 56em) 18vw, 45vw" />)}
                      </div>
                    </div>
                  )}
                </Acordeon>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <Interludio foto={p.interludioAcontecimiento.foto} frase={p.interludioAcontecimiento.frase} />

  <GaleriaObras
    titulo="Obras de la"
    acento="Primaria"
    bajada="Producciones de los chicos y las chicas en los proyectos de cada grado."
    obras={[
      { id: 'obra-cordillera', rotulo: 'La cordillera', detalle: '5° grado' },
      { id: 'obra-yaguarete', rotulo: 'Animales', detalle: '1° grado' },
      { id: 'obra-quillangos-guardas', rotulo: 'Quillangos', detalle: '2° grado' },
      { id: 'obra-ave', rotulo: 'Animales', detalle: '1° grado' },
      { id: 'obra-calendario', rotulo: 'Collage', detalle: '3° grado' },
      { id: 'obra-cordillera-luz', rotulo: 'Escenografía', detalle: '5° grado' },
      { id: 'obra-lagarto', rotulo: 'Animales', detalle: '1° grado' },
      { id: 'obra-animales-carton', rotulo: 'Escultura', detalle: '1° grado' },
    ]}
  />

  {/* Proyectos destacados */}
  <section class="seccion ancla" id="proyectos" aria-labelledby="proy-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <h2 id="proy-titulo" data-titulo-lineas set:html={acento(p.proyectos.titulo)} />
      </div>
      <div class="proyectos">
        {p.proyectos.items.map((pr, i) => <TarjetaProyecto id={pr.id} titulo={pr.titulo} texto={pr.texto} foto={pr.foto} trazo={pr.trazo} indice={i} />)}
      </div>
    </div>
  </section>

  <Interludio foto={p.interludioArboles.foto} frase={p.interludioArboles.frase} variante="lado" trazo="hoja" ratio="4/5" />

  {/* Preparación para la secundaria */}
  <section class="seccion ancla" id="secundaria" aria-labelledby="sec-titulo">
    <div class="contenedor">
      <div class="secundaria">
        <h2 id="sec-titulo" class="secundaria__h2" data-titulo-lineas set:html={acento(p.secundaria.titulo)} />
        <h3 class="secundaria__pregunta" data-revelar>{p.secundaria.pregunta}</h3>
        <p class="sr-only">{p.secundaria.habilidadesTexto}</p>
        <ul class="habilidades" data-de-a-una aria-hidden="true">
          {p.secundaria.habilidades.map((h, i) => (
            <li class:list={['habilidad', { 'habilidad--cursiva': i % 2 === 1 }]} data-palabra>{h}{i < p.secundaria.habilidades.length - 1 ? (i === p.secundaria.habilidades.length - 2 ? ' y' : ',') : '.'}</li>
          ))}
        </ul>
        <div class="secundaria__texto prosa" data-revelar set:html={parrafos(p.secundaria.texto)} />
      </div>
    </div>
  </section>

  <LlamadoEntrevista nivel="primaria" foto="primaria-escribiendo-juntos" titulo="Vení a conocer la Primaria" />
</Base>

<style>
  .portada-sub { font-family: var(--f-frase); font-style: italic; font-size: 1.15rem; font-size: clamp(1.15rem, 0.82rem + 1.008vw, 1.68rem); color: #f6efe3; max-width: 30ch; line-height: 1.3; }

  /* Recuadro con la frase de Marta Calvo, colgando de la portada (como en el Jardín) */
  .intro-nivel { position: relative; z-index: 3; margin-top: -3rem; }
  .intro-nivel__nota { max-width: 42rem; margin: 0 auto; text-align: center; }
  .intro-nivel__cita { margin: 0 auto; max-width: none; font-size: 1.15rem; font-size: clamp(1.1rem, 0.95rem + 0.6vw, 1.5rem); line-height: 1.4; }
  .intro-nivel__firma { margin-top: 0.8rem; font-weight: 650; color: var(--bordo); }
  /* Párrafo centrado, antes de las solapas */
  .parrafo-nivel { padding: 3.5rem 0 3rem; text-align: center; }
  .parrafo-nivel__texto { margin: 0 auto; max-width: 44rem; font-family: var(--f-titulo); font-size: 1.2rem; font-size: clamp(1.15rem, 1rem + 0.6vw, 1.55rem); line-height: 1.5; font-weight: 350; }

  /* Cómo aprendemos: texto + galería al costado */
  .ca__grilla { display: grid; grid-template-columns: 1fr; grid-gap: 2.5rem; gap: 2.5rem; align-items: start; }
  .ca__texto, .ca__fotos { min-width: 0; }
  @media (min-width: 56em) { .ca__grilla { grid-template-columns: 7fr 5fr; grid-gap: 4rem; gap: 4rem; } .ca__fotos { position: -webkit-sticky; position: sticky; top: calc(var(--header-h) + 5rem); } }
  .copete { max-width: 44rem; }
  .copete__titulo { font-size: 1.26rem; font-size: var(--t-lg); margin-bottom: 1rem; }
  .copete__texto { font-size: 1.125rem; font-size: var(--t-md); line-height: 1.6; }
  .ca__desplegable { margin-top: 1.7rem; }
  .convivencia { display: grid; grid-template-columns: 1fr; grid-gap: 1.7rem; gap: 1.7rem; align-items: start; }
  .convivencia__titulo { font-size: 1.375rem; font-size: var(--t-lg); margin-bottom: 1.25rem; max-width: 30ch; }
  .ronda-caja { padding: 1.7rem; padding: clamp(1.275rem, 2.45vw, 1.7rem); background: var(--verde); color: #fff; border-radius: var(--radio-lg); }
  .ronda-caja__trazo { width: 2.6rem; height: 2.6rem; margin-bottom: 1rem; color: #fff !important; }
  .ronda-caja__titulo { color: #fff; font-size: 1.202rem; font-size: var(--t-xl); margin-bottom: 1rem; }
  .ronda-caja p { color: #f2f6ee; }
  @media (min-width: 56em) { .convivencia { grid-template-columns: 7fr 5fr; grid-gap: 2.72rem; gap: 2.72rem; } }

  .areas-intro { display: grid; grid-template-columns: 1fr; grid-gap: 1.7rem; gap: 1.7rem; margin-bottom: 2.72rem; }
  .areas-intro__texto { font-size: 1.125rem; font-size: var(--t-md); line-height: 1.6; }
  .ciclos { display: grid; grid-template-columns: 1fr; grid-gap: 1.275rem; gap: 1.275rem; }
  .ciclo { padding: 1.275rem; background: var(--papel); border-radius: var(--radio-lg); }
  .ciclo__trazo { width: 2rem; height: 2rem; margin-bottom: 0.6rem; }
  .ciclo__titulo { font-size: 1.25rem; margin-bottom: 0.5rem; }
  @media (min-width: 56em) { .areas-intro { grid-template-columns: 6fr 5fr; grid-gap: 2.72rem; gap: 2.72rem; } }

  /* Áreas: dos módulos en zigzag con acordeones */
  .modulo { display: grid; grid-template-columns: 1fr; grid-gap: 1.75rem; gap: 1.75rem; align-items: start; }
  .modulo + .modulo { margin-top: 4.5rem; padding-top: 4.5rem; border-top: 1px solid rgba(35, 32, 28, 0.14); }
  .modulo__foto { min-width: 0; }
  .modulo__foto :global(.foto) { box-shadow: 0 30px 60px -40px rgba(35, 32, 28, 0.6); }
  .modulo__n { display: block; font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.8125rem; letter-spacing: 0.1em; color: var(--bordo); }
  .modulo__titulo { margin-top: 0.5rem; font-size: 1.8rem; font-size: clamp(1.8rem, 1.3rem + 1.5vw, 2.7rem); font-weight: 320; letter-spacing: -0.03em; line-height: 1.04; }
  .modulo__areas { margin-top: 1.5rem; }
  .modulo__areas :global(.area-ac .acordeon__resumen) { padding: 1rem 0; }
  .modulo__areas :global(.area-ac .acordeon__titulo) { font-size: 1.15rem; font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem); }
  .modulo__areas :global(.area-ac .acordeon__signo) { width: 1.9rem; height: 1.9rem; }
  .modulo__areas :global(.area-ac .acordeon__interior) { padding-bottom: 1.5rem; }
  .area__prosa { font-size: 0.975rem; line-height: 1.65; }
  .area__lista { margin-top: 1rem; padding-left: 1.1rem; font-size: 0.975rem; }
  .area__lista li + li { margin-top: 0.6rem; }
  .area__rap { margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid rgba(35, 32, 28, 0.14); }
  .area__rap > * + * { margin-top: 1rem; }
  .area__fotos { display: grid; grid-template-columns: 1fr 1fr; grid-gap: 0.75rem; gap: 0.75rem; margin-top: 1.25rem; }
  .area__fotos :global(.foto) { border-radius: 3px; }
  .area__penas { margin-top: 1.5rem; }
  .area__penas-titulo { font-family: var(--f-titulo); font-weight: 400; font-size: 1.2rem; }
  @media (min-width: 56em) {
    .modulo { grid-template-columns: 5fr 6fr; grid-gap: 4rem; gap: 4rem; }
    .modulo--invertido { grid-template-columns: 6fr 5fr; }
    .modulo--invertido .modulo__foto { order: 2; }
    .modulo__foto { position: -webkit-sticky; position: sticky; top: calc(var(--header-h) + 5rem); }
  }

  .proyectos { display: grid; grid-template-columns: 1fr; grid-gap: 1.275rem; gap: 1.275rem; align-items: start; }
  @media (min-width: 56em) {
    .proyectos { grid-template-columns: 1fr 1fr; grid-gap: 1.7rem; gap: 1.7rem; }
    .proyectos > :global(*:nth-child(2n)) { margin-top: 2.72rem; }
  }

  .secundaria {
    position: relative;
    padding: 1.7rem 1.275rem;
    padding: clamp(1.7rem, 4.2vw, 3.74rem) clamp(1.25rem, 4.2vw, 3.74rem);
    background: var(--verde-claro);
    border-radius: var(--radio-lg);
  }
  .secundaria__flecha { width: 3.2rem; height: 1.6rem; margin-bottom: 1rem; }
  .secundaria__h2 { max-width: 14ch; }
  .secundaria__pregunta { margin-top: 1.275rem; font-family: var(--f-texto); font-size: 1.125rem; font-weight: 650; max-width: 40ch; }
  .habilidades { display: flex; flex-wrap: wrap; align-items: baseline; margin: 1.7rem 0 1.7rem; }
  .habilidad {
    margin-right: 0.45em;
    font-family: var(--f-titulo);
    font-size: 1.613rem;
    font-size: clamp(1.613rem, 0.82rem + 2.508vw, 2.97rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    font-weight: 330;
  }
  .habilidad--cursiva { font-style: italic; color: var(--bordo); }
  .secundaria__texto { columns: 1; }
  @media (min-width: 64em) { .secundaria__texto { column-count: 2; column-gap: 2.38rem; } .secundaria__texto :global(p) { break-inside: avoid; } }
</style>
