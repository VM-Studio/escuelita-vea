---
import Dibujito from '../components/Dibujito.astro';
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Trazo from '../components/Trazo.astro';
import PortadaPagina from '../components/PortadaPagina.astro';
import Boton from '../components/Boton.astro';
import Acordeon from '../components/Acordeon.astro';
import Carrusel from '../components/Carrusel.astro';
import LlamadoEntrevista from '../components/LlamadoEntrevista.astro';
import Interludio from '../components/Interludio.astro';
import VideoReel from '../components/VideoReel.astro';
import { comunidad as c } from '../content/comunidad';
import { PUBLICAR, VIDEOS } from '../config/sitio';
import { parrafos, enLinea, acento } from '../lib/texto';

// Las seis actividades del carrusel, cada una con su foto y su texto actual
const actividades = [
  ...c.salidas.hitos.map((h) => ({ id: h.id, titulo: h.etiqueta, texto: h.texto, foto: h.fotos[0] })),
  { id: 'feria-de-libros', titulo: c.talleresMuestras.items[0].etiqueta, texto: c.talleresMuestras.items[0].texto, foto: c.vida.feriaFoto },
  { id: 'muestras-didacticas', titulo: c.talleresMuestras.items[1].etiqueta, texto: c.talleresMuestras.items[1].texto, foto: c.talleresMuestras.foto },
];
const mostrarVoces = PUBLICAR.testimonios && c.voces.testimonios.length > 0;
---
<Base
  titulo="Nuestra Comunidad"
  descripcion="Talleres y muestras, salidas educativas y celebraciones, peñas, campamentos, kermese, actividades con familias y talleres extracurriculares para infancias y adultos."
  heroOscuro
  fotoOg={c.portada.foto}
  progreso
>
  <PortadaPagina titulo={c.portada.titulo} foto={c.portada.foto} volanta="La Escuelita">
    <p class="portada-bajada">{c.portada.bajada}</p>
  </PortadaPagina>

  {/* Puerta de entrada: texto a la izquierda; a la derecha, la frase (más chica) y fotos */}
  <section class="seccion intro-com" aria-label="Nuestra comunidad">
    <Dibujito nombre="paisaje-barco" lado="der" top="6%" ancho="9rem" rot={3} opacidad={0.5} />
    <div class="contenedor intro-com__grilla">
      <div class="intro-com__izq">
        <div class="prosa intro-com__texto" data-revelar set:html={parrafos(c.introduccion.texto)} />
        {/* Video enviado por la escuela para Comunidad (Instagram): cierre del ciclo lectivo */}
        <div class="intro-com__video" data-revelar>
          <VideoReel {...VIDEOS.comunidad} ancho="34rem" rot={-1} horizontal />
        </div>
      </div>
      <div class="intro-com__lado">
        <p class="t-frase intro-com__frase" data-revelar>{c.introduccion.frase}</p>
        <div class="intro-com__fotos">
          {c.introduccion.fotos.map((f, i) => (
            <div class:list={['pegada', `intro-com__foto--${i + 1}`]} style={`--rot:${i ? 2 : -1.6}deg`} data-revelar>
              <Foto id={f} ratio={i ? '3/4' : '4/3'} sizes="(min-width: 56em) 26vw, 80vw" />
            </div>
          ))}
        </div>
      </div>
    </div>
    <nav class="contenedor botonera" aria-label="Secciones de Comunidad">
      {c.botones.map((b, i) => <Boton href={b.href} variante={i === 0 ? 'rojo' : 'base'} tamano="grande">{b.texto}</Boton>)}
    </nav>
  </section>

  {/* Vida en comunidad, actividades y viajes: carrusel de actividades + tres columnas fijas */}
  <section class="seccion seccion--papel-oscuro ancla" id="vida-en-comunidad" aria-labelledby="vida-titulo">
    <div class="contenedor">
      <div class="cabeza-regla">
        <h2 id="vida-titulo" class="vida__titulo" data-titulo-lineas set:html={acento(c.vida.titulo)} />
      </div>
      <h3 class="vida__sub" data-revelar>{c.vida.actividadesTitulo}</h3>
      <Carrusel etiqueta={c.vida.actividadesTitulo} class="actividades">
        {actividades.map((a) => (
          <article class="actividad" id={a.id} aria-labelledby={`${a.id}-t`}>
            <div class="actividad__foto"><Foto id={a.foto} ratio="4/3" sizes="(min-width: 64em) 30vw, (min-width: 40em) 46vw, 82vw" /></div>
            <div class="actividad__cuerpo">
              <h4 class="actividad__titulo" id={`${a.id}-t`}>{a.titulo}</h4>
              <p class="actividad__texto" set:html={enLinea(a.texto)} />
            </div>
          </article>
        ))}
      </Carrusel>

      <div class="columnas">
        <section class="columna" aria-labelledby="efemerides-t" data-revelar>
          <h3 class="columna__titulo" id="efemerides-t">{c.vida.efemeridesTitulo}</h3>
          <div class="fechas" aria-hidden="true">
            {c.talleresMuestras.fechas.map((f) => <span class="fecha">{f}</span>)}
          </div>
          <p class="columna__texto">{c.talleresMuestras.texto}</p>
        </section>
        <section class="columna" aria-labelledby="salidas-t" data-revelar>
          <h3 class="columna__titulo" id="salidas-t">{c.salidas.salidasEducativas.etiqueta}</h3>
          <p class="columna__texto">{c.salidas.salidasEducativas.texto}</p>
          <div class="columna__acordeones">
            {c.salidas.areas.map((a, i) => (
              <Acordeon id={`salidas-${i + 1}`} titulo={a.etiqueta} grupo="salidas" nivelTitulo="h4" class="salida-ac">
                <p class="columna__texto">{a.texto}</p>
              </Acordeon>
            ))}
          </div>
        </section>
        <section class="columna" aria-labelledby="familias-t" data-revelar>
          <h3 class="columna__titulo" id="familias-t">{c.familias.titulo}</h3>
          <p class="columna__bajada">{c.familias.bajada}</p>
          <p class="columna__texto">{c.familias.texto}</p>
        </section>
      </div>
    </div>
  </section>

  <Interludio foto={c.interludio.foto} frase={c.interludio.frase} />

  {/* Voces de la comunidad: construido, OCULTO hasta tener testimonios reales */}
  {mostrarVoces && (
    <section class="seccion seccion--acento voces" aria-labelledby="voces-titulo">
      <div class="contenedor">
        <div class="cabecera-seccion">
          <p class="t-volanta">{c.voces.titulo}</p>
          <h2 id="voces-titulo" data-titulo-lineas set:html={acento(c.voces.subtitulo)} />
        </div>
        <Carrusel etiqueta={c.voces.subtitulo}>
          {c.voces.testimonios.map((t) => (
            <figure class="testimonio">
              <blockquote><p class="t-frase">{t.texto}</p></blockquote>
              <figcaption>— {t.autor}{t.rol && `, ${t.rol}`}</figcaption>
            </figure>
          ))}
        </Carrusel>
      </div>
    </section>
  )}

  {/* Talleres extracurriculares */}
  <section class="seccion seccion--tinta ancla extra" id="talleres" aria-labelledby="talleres-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <h2 id="talleres-titulo" data-titulo-lineas set:html={acento(c.extracurriculares.titulo)} />
      </div>
      <div class="extra__grupos">
        {c.extracurriculares.grupos.map((g, gi) => (
          <div class="extra__grupo">
            <h3 class="extra__grupo-titulo">{g.titulo}</h3>
            <ul class="extra__lista">
              {g.items.map((t, i) => (
                <li class="taller" data-revelar>
                  <div>
                    <p class="taller__nombre">{t.nombre}</p>
                    <p class="taller__para">{t.para}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <LlamadoEntrevista />
</Base>

<style>
  .portada-bajada { font-family: var(--f-frase); font-style: italic; font-size: 1.15rem; font-size: clamp(1.15rem, 0.82rem + 1.008vw, 1.68rem); line-height: 1.3; color: #f6efe3; max-width: 30ch; }

  /* Introducción */
  .intro-com { overflow: hidden; }
  .intro-com__grilla { display: grid; grid-template-columns: 1fr; grid-gap: 2.5rem; gap: 2.5rem; align-items: start; }
  .intro-com__texto { font-size: 1.125rem; font-size: var(--t-md); line-height: 1.65; }
  .intro-com__video { margin-top: 2.5rem; }
  .intro-com__frase { font-size: 1.15rem; font-size: clamp(1.1rem, 0.98rem + 0.45vw, 1.4rem); line-height: 1.35; max-width: 30ch; color: var(--tinta); }
  .intro-com__fotos { position: relative; margin-top: 1.5rem; display: grid; grid-template-columns: 1fr; grid-gap: 1rem; gap: 1rem; }
  .intro-com__fotos .pegada { position: relative; }
  @media (min-width: 40em) {
    .intro-com__fotos { grid-template-columns: 7fr 5fr; align-items: start; }
    .intro-com__foto--2 { margin-top: 2.5rem; }
  }
  @media (min-width: 56em) { .intro-com__grilla { grid-template-columns: 6fr 6fr; grid-gap: 4rem; gap: 4rem; } }
  .botonera { display: flex; flex-wrap: wrap; justify-content: center; margin-top: 3.5rem; padding-top: 2.5rem; border-top: 1px solid rgba(35, 32, 28, 0.15); }
  .botonera > :global(*) { margin: 0 0.5rem 0.9rem; }

  /* Vida en comunidad */
  .vida__titulo { max-width: 22ch; font-size: 1.9rem; font-size: clamp(1.8rem, 1.2rem + 1.9vw, 3rem); font-weight: 330; letter-spacing: -0.03em; line-height: 1.04; }
  .vida__sub { margin-bottom: 1.5rem; font-family: var(--f-titulo); font-style: italic; font-weight: 350; font-size: 1.35rem; font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.8rem); }
  /* Carrusel: de a 1 en celular, de a 2 en tablet, de a 3 en compu (sin asomar la siguiente) */
  :global(.actividades .carrusel__viewport) { margin-left: 0 !important; margin-right: 0 !important; padding-left: 0 !important; padding-right: 0 !important; }
  :global(.actividades .carrusel__pista) { align-items: stretch; }
  :global(.actividades .carrusel__pista > *) { flex: 0 0 100% !important; margin-right: 1.25rem; }
  @media (min-width: 40em) { :global(.actividades .carrusel__pista > *) { flex-basis: calc((100% - 1.25rem) / 2) !important; } }
  @media (min-width: 64em) { :global(.actividades .carrusel__pista > *) { flex-basis: calc((100% - 2.5rem) / 3) !important; } }
  .actividad { display: flex; flex-direction: column; height: auto; align-self: stretch; background: #fffdf8; box-shadow: 0 1px 2px rgba(35, 32, 28, 0.06), 0 18px 40px -26px rgba(35, 32, 28, 0.45); }
  .actividad__cuerpo { padding: 1.25rem 1.25rem 1.5rem; }
  .actividad__titulo { font-family: var(--f-titulo); font-weight: 400; font-size: 1.25rem; line-height: 1.2; margin-bottom: 0.6rem; }
  .actividad__texto { font-size: 0.9375rem; line-height: 1.6; color: var(--tinta-suave); }
  .columnas { display: grid; grid-template-columns: 1fr; grid-gap: 2.5rem; gap: 2.5rem; margin-top: 4rem; }
  @media (min-width: 64em) { .columnas { grid-template-columns: repeat(3, 1fr); grid-gap: 2.5rem; gap: 2.5rem; } }
  .columna { padding-top: 1.25rem; border-top: 2px solid var(--tinta); }
  .columna__titulo { font-size: 1.5rem; font-size: clamp(1.4rem, 1.2rem + 0.6vw, 1.85rem); font-weight: 380; margin-bottom: 1rem; }
  .columna__bajada { font-family: var(--f-titulo); font-style: italic; font-size: 1.0625rem; margin-bottom: 0.8rem; }
  .columna__texto { font-size: 0.975rem; line-height: 1.65; color: var(--tinta-suave); }
  .columna__acordeones { margin-top: 1.25rem; }
  .columna__acordeones :global(.salida-ac .acordeon__resumen) { padding: 0.9rem 0; }
  .columna__acordeones :global(.salida-ac .acordeon__titulo) { font-size: 1.1rem; }
  .columna__acordeones :global(.salida-ac .acordeon__signo) { width: 1.8rem; height: 1.8rem; }
  .columna__acordeones :global(.salida-ac .acordeon__interior) { padding-bottom: 1.1rem; }
  .fechas { display: flex; flex-wrap: wrap; margin-bottom: 1rem; }
  .fecha { margin: 0 0.5rem 0.5rem 0; padding: 0.3rem 0.85rem; border-radius: 999px; background: var(--bordo); color: #fff; font-weight: 650; font-size: 0.875rem; }

  .testimonio { padding: 1.7rem; background: var(--papel); border-radius: var(--radio-lg); }
  .testimonio p { font-size: 1.375rem; }
  .testimonio figcaption { margin-top: 1rem; font-weight: 600; }

  .extra__trazo { width: 6.4rem; height: 2rem; margin-bottom: 1rem; }
  .extra__grupos { display: grid; grid-template-columns: 1fr; grid-gap: 2.04rem; gap: 2.04rem; }
  .extra__grupo-titulo { color: var(--bordo); font-family: var(--f-texto); font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; margin-bottom: 1.25rem; }
  .extra__lista { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr; grid-gap: 1rem; gap: 1rem; }
  .taller { display: flex; align-items: flex-start; padding: 1.25rem; border: 1px solid rgba(35, 32, 28, 0.14); background: #f8f5ef; border-radius: var(--radio-lg); transition: background-color 0.3s, border-color 0.3s; }
  @media (hover: hover) { .taller:hover { background: #fff; border-color: rgba(35, 32, 28, 0.3); } }
  .taller__icono { flex: none; width: 1.8rem; height: 1.8rem; margin-right: 1rem; }
  .taller__icono :global(svg) { width: 100%; height: 100%; }
  .taller__nombre { font-family: var(--f-titulo); font-size: 1.375rem; color: var(--tinta); line-height: 1.2; }
  .taller__para { margin-top: 0.3rem; color: var(--tinta-suave); font-size: 0.9375rem; }
  @media (min-width: 48em) { .extra__lista { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 64em) { .extra__grupos { grid-template-columns: 3fr 2fr; grid-gap: 2.72rem; gap: 2.72rem; } .extra__grupo:last-child .extra__lista { grid-template-columns: 1fr; } }
</style>
