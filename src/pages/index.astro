---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Trazo from '../components/Trazo.astro';
import Logo from '../components/Logo.astro';
import Boton from '../components/Boton.astro';
import Puertas from '../components/Puertas.astro';
import Telon from '../components/Telon.astro';
import Dibujito from '../components/Dibujito.astro';
import Instagram from '../components/Instagram.astro';
import Constelacion from '../components/Constelacion.astro';
import GaleriaObras from '../components/GaleriaObras.astro';
import CurvaTexto from '../components/CurvaTexto.astro';
import TarjetasRebote from '../components/TarjetasRebote.astro';
import LlamadoEntrevista from '../components/LlamadoEntrevista.astro';
import Sello from '../components/Sello.astro';
import Mancha from '../components/Mancha.astro';
import Paleta from '../components/Paleta.astro';
import CarruselCircular from '../components/CarruselCircular.astro';
import RastroImagenes from '../components/RastroImagenes.astro';
import { inicio } from '../content/inicio';
import { comunidad } from '../content/comunidad';
import { parrafos, acento } from '../lib/texto';

const p = inicio;
// Precarga de la foto del hero (mismos parámetros que <Foto prioridad>)
const masters = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos/*.jpg', { eager: true });
const primera = masters[`../assets/fotos/${p.portada.fotos[0]}.jpg`].default;
const anchos = [480, 720, 960, 1280, 1600, 2000].filter((w) => w <= primera.width);
const pre = await getImage({ src: primera, widths: anchos, format: 'avif' });
const precargar = [{ srcset: pre.srcSet.attribute, sizes: '(min-width: 64em) 34vw, 86vw', type: 'image/avif' }];
---
<Base
  titulo="Inicio"
  descripcion="La Escuelita: Primer Jardín Argentino de Educación por el Arte (1959) e Instituto La Escuelita, Escuela Primaria de Educación a través del Arte (1997). Fundada por la profesora Marta Calvo. Colegiales, CABA."
  precargar={precargar}
>
  {/* ============ HERO ============ */}
  {/* Concepto: una puerta abierta (arco) al patio de La Escuelita. Alrededor, "hacer · sentir · pensar"
      (de la frase de Marta Calvo): el diseño dice lo mismo que el titular. */}
  <section class="hero" data-hero aria-labelledby="hero-titulo">
    <div class="hero__aurora" aria-hidden="true"><span></span><span></span><span></span></div>
    {/* Tres dibujos de los chicos, sueltos en los márgenes, como en una lámina colgada. El resto de los
        dibujos acompaña el recorrido del sitio (componente Dibujito). */}
    <div class="hero__dibujos" aria-hidden="true">
      <span class="hero__dibujo hero__dibujo--a" data-hero-dibujo data-vel="-14"><img src="/hero-dibujos/cara-pestanas.webp" alt="" width="387" height="396" decoding="async" /></span>
      <span class="hero__dibujo hero__dibujo--b" data-hero-dibujo data-vel="-26"><img src="/hero-dibujos/cara-anteojos.webp" alt="" width="393" height="396" decoding="async" /></span>
      <span class="hero__dibujo hero__dibujo--c" data-hero-dibujo data-vel="-8"><img src="/hero-dibujos/cuerpo-musculos.webp" alt="" width="367" height="395" decoding="async" /></span>
    </div>
    <div class="hero__grilla contenedor">
      <div class="hero__texto">
        <h1 id="hero-titulo" class="hero__titular" data-hero-titular>El niño es cuerpo que siente y al <em class="acento">sentir, piensa.</em></h1>
        <p class="hero__bajada" data-hero-resto>{p.portada.bajada}</p>
        <div class="hero__acciones" data-hero-resto>
          <Boton href="/contacto/#entrevista" variante="rojo" tamano="grande">Pedí una entrevista</Boton>
          <Boton href="/proyecto-pedagogico/" tamano="grande">Conocé nuestra mirada</Boton>
        </div>
      </div>

      <div class="hero__escena">
        <svg class="hero__arco-trazo" viewBox="0 0 400 520" aria-hidden="true" data-hero-trazo>
          <g filter="url(#crayon)" fill="none" stroke="var(--rojo-vivo)" stroke-width="2.6" stroke-linecap="round">
            <path d="M18 512 L 16 210 C 14 92, 110 10, 202 12 C 300 14, 386 96, 384 214 L 382 508" />
          </g>
        </svg>
        <div class="hero__arco" data-hero-secuencia>
          {[p.portada.fotos[0], p.portada.fotos[1], p.portada.fotos[2], p.portada.fotos[3]].map((id, i) => (
            <div class:list={['hero__capa', { 'is-activa': i === 0 }]} data-hero-capa>
              <Foto id={id} ratio="4/5" sizes="(min-width: 64em) 34vw, 86vw" prioridad={i === 0} alt={i === 0 ? undefined : ''} />
            </div>
          ))}
        </div>

        <ul class="hero__palabras" aria-label="Hacer, sentir y pensar">
          <li class="hero__palabra hero__palabra--a" data-hero-resto>hacer</li>
          <li class="hero__palabra hero__palabra--b" data-hero-resto>sentir</li>
          <li class="hero__palabra hero__palabra--c" data-hero-resto>pensar</li>
        </ul>
        <div class="hero__sello" data-hero-resto><Sello tamano={104} color="tinta" /></div>
      </div>
    </div>
    <a href="#presentacion" class="hero__scroll" aria-label="Bajar a la presentación" data-hero-trazo>
      <Trazo nombre="scroll" color="actual" grosor={2} dibujar={false} crayon={false} />
    </a>
  </section>

  {/* ============ PRESENTACIÓN CON LOGOS ============ */}
  <section class="presentacion seccion" id="presentacion" aria-labelledby="presentacion-titulo">
    <Dibujito nombre="cara-pelo-largo" lado="izq" top="10%" ancho="7rem" rot={-6} />
    <Dibujito nombre="cara-ojos" lado="der" top="46%" ancho="6.5rem" rot={8} />
    <div class="contenedor">
      <div class="presentacion__cabeza">
        <Trazo nombre="sol" class="presentacion__sol" grosor={2.6} />
        <h2 id="presentacion-titulo" class="presentacion__nombre" data-titulo-lineas set:html={acento(p.presentacion.nombre)} />
        <p class="presentacion__fundada" data-revelar>{p.presentacion.fundada}</p>
        <p class="presentacion__trayectoria" data-revelar>
          <span class="subrayable">{p.presentacion.trayectoria}<Trazo nombre="subrayado" grosor={3} /></span>
        </p>
        <p class="presentacion__descripcion" data-revelar>{p.presentacion.descripcion}</p>
        <Paleta class="presentacion__paleta" />
      </div>

      {/* Orden expreso de la escuela: Jardín a la izquierda, Primaria a la derecha, VEA abajo. */}
      <div class="presentacion__niveles">
        <a href="/jardin/" class="nivel nivel--jardin" data-revelar>
          <Logo nivel="jardin" alto={116} decorativo />
          <span class="nivel__texto">{p.presentacion.jardin.texto}</span>
          <span class="nivel__anio t-cifra" data-contador={p.presentacion.jardin.anio} data-desde="1900">{p.presentacion.jardin.anio}</span>
          <span class="nivel__ir">Conocé el Jardín <span aria-hidden="true">→</span></span>
        </a>
        <span class="presentacion__division" aria-hidden="true"><Trazo nombre="ola" color="arena" grosor={2} /></span>
        <a href="/primaria/" class="nivel nivel--primaria" data-revelar>
          <Logo nivel="primaria" alto={92} decorativo />
          <span class="nivel__texto">{p.presentacion.primaria.texto}</span>
          <span class="nivel__anio t-cifra" data-contador={p.presentacion.primaria.anio} data-desde="1940">{p.presentacion.primaria.anio}</span>
          <span class="nivel__ir">Conocé la Primaria <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <Telon foto="jardin-ronda-arena-arboles" rotulo="El patio de La Escuelita" alto="bajo" />

  {/* ============ BIENVENIDA ============ */}
  <section class="bienvenida seccion seccion--papel-oscuro" aria-label="Bienvenida">
    <div class="contenedor">
      <Constelacion items={[
        { id: p.bienvenida.foto }, { id: 'jardin-hojas-crayon' }, { id: 'primaria-leyenda-ronda' }, { id: 'jardin-libro-cara' },
        { id: 'jardin-arcilla-figuras' }, { id: 'patio-tres-nenas-arena' }, { id: 'primaria-escribiendo-juntos' }, { id: 'jardin-musica-guitarra' },
      ]} etiqueta="La vida en La Escuelita">
        <Paleta class="bienvenida__paleta" />
        <p class="bienvenida__parrafo" data-revelar>{p.bienvenida.texto}</p>
      </Constelacion>
    </div>
  </section>

  {/* ============ INTERLUDIO ============ */}
  <section class="juego-arte seccion" aria-label="El juego y el arte">
    <div class="contenedor juego-arte__cabeza">
      <Paleta class="juego-arte__paleta" />
      <p class="t-frase juego-arte__frase" data-frase>{p.interludio.frase}</p>
    </div>
    <CarruselCircular ids={p.interludio.fotos} etiqueta="Juego y arte en La Escuelita" cardWidth={200} aspectRatio={0.78} gap={22} />
    <p class="juego-arte__ayuda" aria-hidden="true">Arrastrá para girar</p>
  </section>

  {/* ============ LÍNEA DE TIEMPO ============ */}
  <section class="tiempo seccion" aria-labelledby="tiempo-titulo" data-linea-tiempo>
    <Dibujito nombre="arbol" lado="der" top="6%" ancho="8rem" rot={3} opacidad={0.45} />
    <div class="contenedor">
      <div class="tiempo__cabeza">
        <p class="tiempo__cifra t-cifra" aria-hidden="true"><span data-contador="67" data-desde="0">67</span></p>
        <div>
          {/* El "67" rojo grande es el comienzo del título (no se repite) */}
          <h2 id="tiempo-titulo" class="tiempo__titulo" data-revelar set:html={'<span class="sr-only">67 </span>' + acento(p.lineaDeTiempo.titulo.replace(/^67\s+/, ''))} />
          <p class="tiempo__frase t-frase" data-revelar>{p.lineaDeTiempo.frase}</p>
          <p class="tiempo__bajada" data-revelar>{p.lineaDeTiempo.bajada}</p>
          <div class="tiempo__boton" data-revelar><Boton href="/la-escuelita/historia/" variante="rojo">Conocé nuestra historia</Boton></div>
        </div>
      </div>

      <div class="tiempo__cuerpo">
      <span class="tiempo__linea" data-linea aria-hidden="true"></span>
      <ol class="tiempo__hitos">
        {p.lineaDeTiempo.hitos.map((h, i) => (
          <li class:list={['hito', `hito--${i === 0 ? 'a' : 'b'}`]}>
            <span class="hito__punto" aria-hidden="true"></span>
            <div class="hito__texto" data-revelar>
              <p class="hito__anio t-cifra"><span data-contador={h.anio} data-desde={i === 0 ? '1900' : '1959'}>{h.anio}</span></p>
              <p class="hito__desc">{h.texto}</p>
            </div>
            <div class="hito__fotos">
              {h.fotos.map((f, j) => (
                <div class:list={['pegada', 'hito__foto', `hito__foto--${j}`]} style={`--rot:${j ? 2.4 : -1.8}deg`} data-revelar>
                  <span class="cinta" aria-hidden="true"></span>
                  <Foto id={f} ratio={j ? '4/3' : '4/5'} sizes="(min-width: 56em) 26vw, 70vw" />
                </div>
              ))}
            </div>
          </li>
        ))}
      </ol>
      </div>
    </div>
  </section>

  <Telon foto="taller-pintura-mesa" rotulo="El taller, todos los días" alto="medio" />

  {/* ============ EJES PEDAGÓGICOS ============ */}
  <section class="ejes seccion seccion--papel-oscuro" aria-labelledby="ejes-titulo">
    <Dibujito nombre="esqueleto" lado="izq" top="38%" ancho="5rem" rot={-4} />
    <div class="contenedor">
      <div class="ejes__cabeza">
        <h2 id="ejes-titulo" data-titulo-lineas set:html={acento(p.ejes.titulo)} />
        <Trazo nombre="flecha-curva" class="ejes__flecha" grosor={2.4} />
      </div>
      {p.ejes.items.map((e, i) => (
        <article class:list={['eje', { 'eje--invertido': i % 2 === 1 }]}>
          <div class="eje__foto con-mancha">
            <Mancha forma={(['a', 'c', 'd', 'b'] as const)[i]} color={(['arena', 'verde', 'rosa', 'azul'] as const)[i]} class={`eje__mancha eje__mancha--${i % 2 ? 'b' : 'a'}`} />
            <Foto id={e.foto} ratio={i % 2 ? '1/1' : '4/3'} sizes="(min-width: 56em) 34vw, 100vw" revelar class={i % 2 ? 'forma-arco' : ''} />
          </div>
          <div class="eje__texto">
            <span class="eje__marca" aria-hidden="true"><Trazo nombre={(['sol', 'lazos', 'espiral', 'hoja'] as const)[i]} grosor={2.4} color={i % 2 ? 'verde' : 'ocre'} /></span>
            <h3 class="eje__titulo" data-titulo-lineas>{e.titulo}</h3>
            <div class="prosa eje__prosa" data-revelar set:html={parrafos(e.texto)} />
          </div>
        </article>
      ))}
      <div class="ejes__mas" data-revelar>
        <Boton href="/proyecto-pedagogico/">Conocé el proyecto pedagógico</Boton>
      </div>
    </div>
  </section>

  {/* ============ DOS PUERTAS ============ */}
  <Puertas />

  <GaleriaObras
    titulo="Obras del"
    acento="taller"
    bajada="Producciones de los chicos y las chicas en los talleres de La Escuelita."
    obras={[
      { id: 'obra-yaguarete', rotulo: 'Animales', detalle: '1° grado' },
      { id: 'obra-cordillera', rotulo: 'La cordillera', detalle: '5° grado' },
      { id: 'obra-pez', rotulo: 'Animales', detalle: '1° grado' },
      { id: 'obra-quillango-sol', rotulo: 'Quillangos', detalle: '2° grado' },
      { id: 'obra-mariposas', rotulo: 'Animales', detalle: '1° grado' },
      { id: 'obra-calendario', rotulo: 'Collage', detalle: '3° grado' },
      { id: 'obra-tucan', rotulo: 'Animales', detalle: '1° grado' },
      { id: 'obra-animales-carton', rotulo: 'Escultura', detalle: '1° grado' },
    ]}
    enlace={{ href: '/primaria/#areas', texto: 'Conocé las áreas de la Primaria' }}
  />

  {/* ============ MARQUESINA DE MATERIALES ============ */}
  <CurvaTexto items={p.materiales} etiqueta="Materiales del taller: crayones, masa, témpera, arcilla, tinta china, anilinas y collage" />

  {/* ============ COMUNIDAD (ADELANTO) ============ */}
  <section class="adelanto seccion" aria-labelledby="adelanto-titulo">
    <Dibujito nombre="paisaje-barco" lado="izq" top="8%" ancho="9rem" rot={-3} opacidad={0.5} />
    <div class="contenedor">
      <div class="adelanto__cabeza">
        <h2 id="adelanto-titulo" data-titulo-lineas set:html={acento(comunidad.portada.titulo)} />
        <p class="t-lead" data-revelar>{comunidad.portada.bajada}</p>
        <div data-revelar><Boton href="/comunidad/">Conocé nuestra comunidad</Boton></div>
      </div>
      <div class="adelanto__fotos con-mancha">
        <Mancha forma="d" color="verde" class="adelanto__mancha" opacidad={0.7} />
        <TarjetasRebote ids={p.comunidadFotos} ancho={540} alto={300} tamano={190} spread={95} />
      </div>
    </div>
  </section>

  <Instagram />

  <LlamadoEntrevista foto={p.cierreFoto} />
</Base>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative; overflow: hidden;
    padding-top: calc(var(--header-h) + 2.5rem);
    padding-bottom: 3rem;
    background: var(--papel);
  }
  @media (min-width: 64em) { .hero { min-height: 100vh; min-height: min(100vh, 58rem); display: flex; align-items: center; padding-top: calc(var(--header-h) + 1.5rem); padding-bottom: 2.5rem; } }
  /* Aurora de pintura: manchas de color muy suaves (CSS, sin WebGL) */
  .hero__aurora { position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none; overflow: hidden; }
  .hero__aurora span { position: absolute; border-radius: 50%; }
  .hero__aurora span:nth-child(1) { width: 60vw; height: 60vw; right: -18vw; top: -20vw; background: radial-gradient(closest-side, rgba(242, 201, 168, 0.75), rgba(242, 201, 168, 0)); }
  .hero__aurora span:nth-child(2) { width: 50vw; height: 50vw; right: 10vw; bottom: -26vw; background: radial-gradient(closest-side, rgba(207, 224, 196, 0.8), rgba(207, 224, 196, 0)); }
  .hero__aurora span:nth-child(3) { width: 40vw; height: 40vw; left: -18vw; top: 14%; background: radial-gradient(closest-side, rgba(246, 220, 212, 0.7), rgba(246, 220, 212, 0)); }
  @media (min-width: 64em) and (prefers-reduced-motion: no-preference) {
    .hero__aurora span:nth-child(1) { animation: aurora-a 22s ease-in-out infinite alternate; }
    .hero__aurora span:nth-child(2) { animation: aurora-b 26s ease-in-out infinite alternate; }
    .hero__aurora span:nth-child(3) { animation: aurora-a 30s ease-in-out infinite alternate-reverse; }
  }
  @keyframes aurora-a { to { transform: translate3d(-4vw, 3vw, 0) scale(1.08); } }
  @keyframes aurora-b { to { transform: translate3d(3vw, -4vw, 0) scale(0.94); } }
  :global(html.liviano) .hero__aurora span { animation: none; }

  .hero__grilla { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr; grid-gap: 2.5rem; gap: 2.5rem; align-items: center; }
  @media (min-width: 64em) { .hero__grilla { grid-template-columns: 1.05fr 1fr; grid-gap: 3rem; gap: 3rem; } }
  .hero__texto { pointer-events: none; }
  .hero__texto > * { pointer-events: auto; }
  .hero__titular {
    margin-top: 1.25rem;
    max-width: 13ch;
    font-size: 2.6rem;
    font-size: clamp(2.6rem, 1.2rem + 4.6vw, 5.4rem);
    font-weight: 330;
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--tinta);
  }
  .hero__titular .acento { color: var(--rojo); font-weight: 300; }
  .hero__bajada { margin-top: 1.4rem; max-width: 34rem; font-size: 1.0625rem; font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem); line-height: 1.55; color: var(--tinta-suave); }
  .hero__acciones { display: flex; flex-wrap: wrap; align-items: center; margin-top: 1.9rem; }
  .hero__acciones > :global(*) { margin: 0 0.75rem 0.75rem 0; }

  /* Dibujos sueltos: pocos, con aire, en los márgenes y nunca detrás del texto */
  .hero__dibujos { position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 1; pointer-events: none; }
  .hero__dibujo { position: absolute; display: block; }
  .hero__dibujo img { display: block; width: 100%; height: auto; mix-blend-mode: multiply; opacity: 0.62; transform: rotate(var(--rot, 0deg)); animation: hero-dibujo-cuadro 1.8s steps(1) infinite; }
  .hero__dibujo--a { width: 8.5rem; left: 45%; top: calc(var(--header-h) + 1.5rem); --rot: -7deg; }
  .hero__dibujo--b { width: 8rem; right: 1.25rem; top: 17%; --rot: 7deg; }
  .hero__dibujo--b img { animation-delay: -0.6s; }
  .hero__dibujo--c { width: 6.5rem; right: 1.5rem; bottom: 4%; --rot: 5deg; }
  .hero__dibujo--c img { opacity: 0.5; animation-delay: -1.2s; }
  /* "Stop motion" muy leve, como el resto de los dibujitos del sitio */
  @keyframes hero-dibujo-cuadro {
    0% { transform: rotate(var(--rot, 0deg)) translate(0, 0); }
    33% { transform: rotate(calc(var(--rot, 0deg) + 2deg)) translate(1px, -2px); }
    66% { transform: rotate(calc(var(--rot, 0deg) - 1.5deg)) translate(-1px, 1px); }
  }
  @media (prefers-reduced-motion: reduce) { .hero__dibujo img { animation: none; } }
  :global(html.liviano) .hero__dibujo img { animation: none; }
  /* Entre 64em y 80em el margen derecho es chico: queda solo el del medio */
  @media (max-width: 79.99em) { .hero__dibujo--b, .hero__dibujo--c { display: none; } }
  @media (max-width: 63.99em) {
    .hero__dibujo--a { width: 5.5rem; left: auto; right: 1rem; top: calc(var(--header-h) + 0.5rem); }
    .hero__dibujo--a img { opacity: 0.45; }
  }

  /* Escena: arco-ventana con fotos */
  .hero__escena { position: relative; width: 100%; max-width: 30rem; margin: 0 auto; padding: 1.5rem 0 2rem; }
  .hero__arco { position: relative; overflow: hidden; border-radius: 999px 999px 18px 18px; box-shadow: 0 30px 60px -30px rgba(60, 40, 20, 0.5); background: var(--papel-hondo); isolation: isolate; }
  .hero__arco::before { content: ''; display: block; padding-top: 125%; }
  .hero__capa { position: absolute; top: 0; left: 0; right: 0; bottom: 0; opacity: 0; transition: opacity 2.2s var(--ease-suave); }
  .hero__capa.is-activa { opacity: 1; }
  .hero__capa + .hero__capa { display: none; }
  .hero.is-secuencia .hero__capa { display: block; }
  .hero__capa :global(.foto) { height: 100%; }
  .hero__capa :global(.foto--recorte::before) { display: none; }
  .hero__capa :global(img) { transform: scale(1.04); transition: transform 9s linear, opacity 0.7s var(--ease-suave); }
  .hero__capa.is-activa :global(img) { transform: scale(1.12); }
  :global(html.reducido) .hero__capa :global(img), :global(html.liviano) .hero__capa :global(img) { transform: none; }
  .hero__arco-trazo { position: absolute; left: -5%; top: 0.4rem; width: 110%; height: auto; z-index: 0; overflow: visible; transform: rotate(-2.5deg); }
  .hero__arco { z-index: 1; }
  /* Lámina de dibujos en crayón: detalle de fondo detrás del arco */
  .hero__palabras { list-style: none; margin: 0; padding: 0; }
  .hero__palabra {
    position: absolute; z-index: 4;
    padding: 0;
    font-family: 'Manuscrita', var(--f-titulo); font-size: 2rem; line-height: 1; color: var(--tinta);
    animation: palabra-flota 6s ease-in-out infinite;
  }
  .hero__palabra--a { color: var(--ocre-texto); }
