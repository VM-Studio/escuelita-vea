---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Logo from '../components/Logo.astro';
import Boton from '../components/Boton.astro';
import PortadaPagina from '../components/PortadaPagina.astro';
import Declaracion from '../components/Declaracion.astro';
import Indice from '../components/Indice.astro';
import Puertas from '../components/Puertas.astro';
import CurvaTexto from '../components/CurvaTexto.astro';
import TarjetasRebote from '../components/TarjetasRebote.astro';
import LlamadoEntrevista from '../components/LlamadoEntrevista.astro';
import Paleta from '../components/Paleta.astro';
import CarruselCircular from '../components/CarruselCircular.astro';
import { inicio } from '../content/inicio';
import { comunidad } from '../content/comunidad';
import { acento } from '../lib/texto';

const p = inicio;
const video = { mp4: '/video/portada.mp4', poster: '/video/portada-poster.jpg' };
const precargar = [{ srcset: `${video.poster} 1280w`, sizes: '100vw', type: 'image/jpeg' }];
---
<Base
  titulo="Inicio"
  descripcion="La Escuelita: Primer Jardín Argentino de Educación por el Arte (1959) e Instituto La Escuelita, Escuela Primaria de Educación a través del Arte (1997). Fundada por la profesora Marta Calvo. Colegiales, CABA."
  precargar={precargar}
>
  {/* ============ HERO: video a sangre, título enorme (SiteInspire: Collective Gallery) ============ */}
  <PortadaPagina titulo={p.portada.titular} video={video} volanta={`${p.presentacion.jardin.texto} — ${p.presentacion.jardin.anio}`} rotulo="Colegiales · Buenos Aires" tamano="enorme">
    <span slot="titulo">El niño es cuerpo que siente y al <em class="acento">sentir, piensa.</em></span>
    <p class="hero-bajada">{p.portada.bajada}</p>
    <div class="hero-acciones">
      <Boton href="/contacto/#entrevista" variante="rojo">Pedí una entrevista</Boton>
      <Boton href="/proyecto-pedagogico/" variante="claro">Conocé nuestra mirada</Boton>
    </div>
  </PortadaPagina>

  {/* ============ PRESENTACIÓN (minimal, tipo fundación de arte) ============ */}
  <section class="presentacion" id="presentacion" aria-labelledby="presentacion-titulo">
    <div class="contenedor">
      <div class="presentacion__fila">
        <p class="rotulo">{p.presentacion.fundada}</p>
        <p class="rotulo presentacion__der">{p.presentacion.descripcion}</p>
      </div>
      <h2 id="presentacion-titulo" class="presentacion__nombre" data-revelar set:html={acento(p.presentacion.nombre)} />
      <p class="presentacion__trayectoria" data-revelar>{p.presentacion.trayectoria}</p>

      {/* Orden expreso de la escuela: Jardín a la izquierda, Primaria a la derecha. */}
      <div class="presentacion__niveles">
        <a href="/jardin/" class="nivel" data-revelar>
          <Logo nivel="jardin" alto={108} decorativo />
          <span class="nivel__anio t-cifra">{p.presentacion.jardin.anio}</span>
          <span class="nivel__texto">{p.presentacion.jardin.texto}</span>
          <span class="enlace-flecha">Conocé el Jardín</span>
        </a>
        <a href="/primaria/" class="nivel" data-revelar>
          <Logo nivel="primaria" alto={84} decorativo />
          <span class="nivel__anio t-cifra">{p.presentacion.primaria.anio}</span>
          <span class="nivel__texto">{p.presentacion.primaria.texto}</span>
          <span class="enlace-flecha">Conocé la Primaria</span>
        </a>
      </div>
    </div>
  </section>

  {/* ============ BIENVENIDA: declaración con fotos entre las palabras (SiteInspire: Albers) ============ */}
  <section class="bienvenida" aria-label="Bienvenida">
    <div class="contenedor">
      <Declaracion
        texto={p.bienvenida.texto}
        tamano="xl"
        imagenes={[
          { id: p.bienvenida.foto, despues: 'un espacio', forma: 'pastilla' },
          { id: 'taller-pintura-mesa', despues: 'aprendizaje', forma: 'circulo' },
          { id: 'patio-abrazo-arbol', despues: 'entrañables.', forma: 'arco' },
        ]}
      />
    </div>
  </section>

  {/* ============ JUEGO Y ARTE: carrusel circular ============ */}
  <section class="juego-arte" aria-label="El juego y el arte">
    <div class="contenedor juego-arte__cabeza">
      <Paleta class="juego-arte__paleta" />
      <p class="t-frase juego-arte__frase" data-frase>{p.interludio.frase}</p>
    </div>
    <CarruselCircular ids={p.interludio.fotos} etiqueta="Juego y arte en La Escuelita" cardWidth={200} aspectRatio={0.78} gap={22} />
    <p class="rotulo juego-arte__ayuda" aria-hidden="true">Arrastrá para girar</p>
  </section>

  {/* ============ LÍNEA DE TIEMPO (tipográfica) ============ */}
  <section class="tiempo" aria-labelledby="tiempo-titulo">
    <div class="contenedor">
      <div class="tiempo__cabeza">
        <p class="tiempo__cifra t-cifra" aria-hidden="true"><span data-contador="67" data-desde="0">67</span></p>
        <div>
          <h2 id="tiempo-titulo" class="tiempo__titulo" data-revelar set:html={'<span class="sr-only">67 </span>' + acento(p.lineaDeTiempo.titulo.replace(/^67\s+/, ''))} />
          <p class="tiempo__frase t-frase" data-revelar>{p.lineaDeTiempo.frase}</p>
          <p class="tiempo__bajada" data-revelar>{p.lineaDeTiempo.bajada}</p>
        </div>
      </div>
      <div class="tiempo__hitos">
        {p.lineaDeTiempo.hitos.map((h, i) => (
          <figure class:list={['hito', { 'hito--b': i === 1 }]} data-revelar>
            <Foto id={h.fotos[0]} ratio="4/3" sizes="(min-width: 56em) 40vw, 90vw" revelar />
            <figcaption>
              <p class="hito__anio t-cifra">{h.anio}</p>
              <p class="hito__desc">{h.texto}</p>
            </figcaption>
          </figure>
        ))}
      </div>
      <div class="tiempo__mas" data-revelar><a href="/la-escuelita/historia/" class="enlace-flecha">Conocé nuestra historia</a></div>
    </div>
  </section>

  {/* ============ EJES: índice editorial (SiteInspire: Olivia Plender) ============ */}
  <section class="ejes" aria-labelledby="ejes-titulo">
    <div class="contenedor">
      <div class="ejes__cabeza">
        <h2 id="ejes-titulo" data-revelar set:html={acento(p.ejes.titulo)} />
        <a href="/proyecto-pedagogico/" class="enlace-flecha" data-revelar>Conocé el proyecto pedagógico</a>
      </div>
      <Indice items={p.ejes.items.map((e) => ({ titulo: e.titulo, texto: e.texto, foto: e.foto }))} />
    </div>
  </section>

  <Puertas />

  <CurvaTexto items={p.materiales} etiqueta="Materiales del taller: crayones, masa, témpera, arcilla, tinta china, anilinas y collage" />

  {/* ============ COMUNIDAD (centrado) ============ */}
  <section class="adelanto" aria-labelledby="adelanto-titulo">
    <div class="contenedor adelanto__caja">
      <h2 id="adelanto-titulo" data-revelar set:html={acento(comunidad.portada.titulo)} />
      <p class="adelanto__bajada" data-revelar>{comunidad.portada.bajada}</p>
      <TarjetasRebote ids={p.comunidadFotos} ancho={720} alto={320} tamano={210} spread={130} />
      <a href="/comunidad/" class="enlace-flecha" data-revelar>Conocé nuestra comunidad</a>
    </div>
  </section>

  <LlamadoEntrevista foto={p.cierreFoto} />
</Base>

<style>
  /* Hero */
  .hero-bajada { max-width: 34rem; font-size: 1rem; font-size: clamp(1rem, 0.95rem + 0.25vw, 1.15rem); line-height: 1.55; color: rgba(250, 246, 238, 0.9); margin: 0 2rem 1rem 0; }
  .hero-acciones { display: flex; flex-wrap: wrap; }
  .hero-acciones > :global(*) { margin: 0 0.6rem 0.6rem 0; }

  /* Presentación */
  .presentacion { padding: 4rem 0 4.5rem; padding: clamp(3rem, 2rem + 4vw, 6.5rem) 0; }
  .presentacion__fila { display: flex; flex-wrap: wrap; justify-content: space-between; border-bottom: 1px solid rgba(35, 32, 28, 0.14); padding-bottom: 0.9rem; }
  .presentacion__fila .rotulo { margin-bottom: 0.4rem; }
  .presentacion__der { max-width: 30ch; text-align: right; }
  .presentacion__nombre { margin-top: 2.5rem; font-size: 3.2rem; font-size: clamp(3.2rem, 1rem + 9vw, 11rem); font-weight: 300; letter-spacing: -0.05em; line-height: 0.85; }
  .presentacion__trayectoria { margin-top: 1rem; font-family: var(--f-titulo); font-size: 1.4rem; font-size: clamp(1.3rem, 1rem + 1.2vw, 2.2rem); font-weight: 330; letter-spacing: -0.02em; }
  .presentacion__niveles { display: grid; grid-template-columns: 1fr; margin-top: 3rem; border-top: 1px solid rgba(35, 32, 28, 0.14); }
  .nivel { display: grid; grid-template-columns: auto 1fr; grid-template-areas: 'logo anio' 'logo texto' 'logo ir'; grid-gap: 0.25rem 1.5rem; gap: 0.25rem 1.5rem; align-items: center; padding: 1.75rem 0; text-decoration: none; border-bottom: 1px solid rgba(35, 32, 28, 0.14); transition: background-color 0.4s; }
  .nivel :global(.logo) { grid-area: logo; }
  .nivel__anio { grid-area: anio; font-size: 2.6rem; font-size: clamp(2.4rem, 1.6rem + 2.6vw, 4.2rem); line-height: 1; }
  .nivel__texto { grid-area: texto; font-family: var(--f-titulo); font-size: 1.1rem; line-height: 1.3; max-width: 28ch; }
  .nivel .enlace-flecha { grid-area: ir; margin-top: 0.5rem; font-size: 0.875rem; }
  @media (hover: hover) { .nivel:hover { background: rgba(255, 253, 248, 0.6); } .nivel:hover .nivel__anio { color: var(--rojo); } }
  @media (min-width: 56em) {
    .presentacion__niveles { grid-template-columns: 1fr 1fr; }
    .nivel { padding: 2.25rem 2rem 2.25rem 0; }
    .nivel + .nivel { border-left: 1px solid rgba(35, 32, 28, 0.14); padding-left: 2.5rem; }
  }

  /* Bienvenida */
  .bienvenida { padding: 3rem 0 4rem; padding: clamp(2.5rem, 1.5rem + 4vw, 6rem) 0 clamp(3rem, 2rem + 4vw, 7rem); background: var(--papel-oscuro); }

  /* Juego y arte */
  .juego-arte { overflow: hidden; padding: 4rem 0 2.5rem; padding: clamp(3rem, 2rem + 4vw, 6rem) 0 2.5rem; }
  .juego-arte__cabeza { text-align: center; }
  .juego-arte__paleta { margin: 0 auto 1.25rem; }
  .juego-arte__frase { margin: 0 auto; max-width: 20ch; font-size: 1.9rem; font-size: clamp(1.9rem, 1.1rem + 3vw, 3.5rem); line-height: 1.08; }
  .juego-arte__ayuda { margin-top: 0.5rem; text-align: center; }
  :global(html:not(.js)) .juego-arte__ayuda, :global(html.liviano) .juego-arte__ayuda { display: none; }
  .juego-arte :global(.cc-envoltura) { margin-top: 1rem; }
  .juego-arte :global(.cc-simple) { max-width: 76rem; margin: 2rem auto 0; padding: 0 var(--gutter); }

  /* Línea de tiempo */
  .tiempo { padding: 4rem 0; padding: clamp(3rem, 2rem + 4vw, 6.5rem) 0; border-top: 1px solid rgba(35, 32, 28, 0.12); }
  .tiempo__cabeza { display: grid; grid-template-columns: auto 1fr; grid-gap: 1rem 1.5rem; gap: 1rem 1.5rem; align-items: center; margin-bottom: 3rem; }
  .tiempo__cifra { font-size: 5.5rem; font-size: clamp(5.5rem, 2.5rem + 11vw, 13rem); color: var(--rojo); line-height: 0.78; letter-spacing: -0.06em; }
  .tiempo__titulo { max-width: 14ch; font-size: 1.7rem; font-size: clamp(1.6rem, 1rem + 2.4vw, 3.4rem); }
  .tiempo__frase { margin-top: 1rem; font-size: 1.2rem; font-size: var(--t-lg); }
  .tiempo__bajada { margin-top: 0.5rem; color: var(--tinta-suave); }
  .tiempo__hitos { display: grid; grid-template-columns: 1fr; grid-gap: 2.5rem; gap: 2.5rem; }
  .hito { margin: 0; }
  .hito :global(.foto) { border-radius: 3px; }
  .hito figcaption { display: grid; grid-template-columns: auto 1fr; grid-gap: 1.25rem; gap: 1.25rem; align-items: baseline; margin-top: 1rem; border-top: 1px solid rgba(35, 32, 28, 0.18); padding-top: 0.9rem; }
  .hito__anio { font-size: 2.4rem; font-size: clamp(2.2rem, 1.6rem + 2vw, 3.6rem); line-height: 1; }
  .hito__desc { font-family: var(--f-titulo); font-size: 1.05rem; line-height: 1.3; }
  @media (min-width: 56em) { .tiempo__hitos { grid-template-columns: 1fr 1fr; grid-gap: 4rem; gap: 4rem; } .hito--b { margin-top: 6rem; } }
  .tiempo__mas { margin-top: 2.5rem; }

  /* Ejes */
  .ejes { padding: 4rem 0; padding: clamp(3rem, 2rem + 4vw, 6.5rem) 0; }
  .ejes__cabeza { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; margin-bottom: 2rem; }
  .ejes__cabeza h2 { max-width: 12ch; font-size: 2rem; font-size: clamp(1.9rem, 1rem + 3.6vw, 4.6rem); font-weight: 300; letter-spacing: -0.04em; line-height: 0.95; margin-right: 2rem; }

  /* Comunidad */
  .adelanto { padding: 4rem 0; padding: clamp(3rem, 2rem + 4vw, 6.5rem) 0; overflow: hidden; }
  .adelanto__caja { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .adelanto__caja h2 { font-size: 2.2rem; font-size: clamp(2.2rem, 1rem + 4.4vw, 5.4rem); font-weight: 300; letter-spacing: -0.04em; line-height: 0.95; }
  .adelanto__bajada { margin: 1rem auto 1.5rem; max-width: 34rem; color: var(--tinta-suave); font-size: 1.05rem; }
  .adelanto__caja :global(.bounce-cards) { margin: 1rem auto 2rem; }
</style>
