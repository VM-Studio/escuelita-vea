---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import FotoPortada from '../components/FotoPortada.astro';
import Trazo from '../components/Trazo.astro';
import Boton from '../components/Boton.astro';
import Puertas from '../components/Puertas.astro';
import Telon from '../components/Telon.astro';
import Instagram from '../components/Instagram.astro';
import PasaFotos from '../components/PasaFotos.astro';
import Topografia from '../components/Topografia.astro';
import TarjetasRebote from '../components/TarjetasRebote.astro';
import LlamadoEntrevista from '../components/LlamadoEntrevista.astro';
import Sello from '../components/Sello.astro';
import Mancha from '../components/Mancha.astro';
import CarruselCircular from '../components/CarruselCircular.astro';
import { inicio } from '../content/inicio';
import { comunidad } from '../content/comunidad';
import { parrafos, acento } from '../lib/texto';

const p = inicio;
// Precarga de la primera foto del hero, en sus dos encuadres (mismos parámetros que <FotoPortada>)
const versiones = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos-portada/*.jpg', { eager: true });
const esc = versiones[`../assets/fotos-portada/${p.portadaFondo[0]}-escritorio.jpg`]?.default;
const cel = versiones[`../assets/fotos-portada/${p.portadaFondo[0]}-celular.jpg`]?.default;
const juego = async (src: ImageMetadata, anchos: number[]) => (await getImage({ src, widths: anchos.filter((a) => a <= src.width), format: 'avif', quality: 68 })).srcSet.attribute;
const precargar = esc && cel ? [
  { srcset: await juego(cel, [600, 828, 1080, 1200]), sizes: '100vw', type: 'image/avif', media: '(max-aspect-ratio: 3/4)' },
  { srcset: await juego(esc, [960, 1280, 1600, 1920, 2560]), sizes: '100vw', type: 'image/avif', media: '(min-aspect-ratio: 3.0001/4)' },
] : [];
---
<Base
  titulo="Inicio"
  descripcion="La Escuelita: Primer Jardín Argentino de Educación por el Arte (1959) e Instituto La Escuelita, Escuela Primaria de Educación a través del Arte (1997). Fundada por la profesora Marta Calvo. Colegiales, CABA."
  precargar={precargar}
>
  {/* ============ HERO PRINCIPAL ============ */}
  {/* Fotos a pantalla completa que se van pasando cada 4 segundos; el nombre arriba, con velo y sombra
      para que el texto se lea siempre. */}
  <section class="portada" data-hero data-portada data-portada-intervalo="5500" aria-labelledby="portada-titulo">
    <div class="portada__fondo" aria-hidden="true">
      {p.portadaFondo.map((id, i) => (
        <div class:list={['portada__capa', { 'is-activa': i === 0 }]} data-portada-capa>
          <FotoPortada id={id} prioridad={i === 0} />
        </div>
      ))}
    </div>
    <div class="portada__velo" aria-hidden="true"></div>
    <div class="portada__contenido contenedor" data-portada-texto>
      {/* "La Escuelita" con la letra del logo (pedido de la escuela): es la palabra del logo original, recortada sin
          redibujar ni recolorear, sobre una etiqueta de papel para que se lea sobre cualquier foto. */}
      <h1 id="portada-titulo" class="portada__titulo" data-hero-resto>
        <span class="portada__etiqueta">
          <span class="cinta" aria-hidden="true"></span>
          <picture>
            <source srcset="/logos/la-escuelita-palabra.webp" type="image/webp" />
            <img src="/logos/la-escuelita-palabra.png" alt={p.presentacion.nombre} width="1400" height="279" decoding="async" fetchpriority="high" />
          </picture>
        </span>
      </h1>
      <p class="portada__bajada" data-hero-resto>{p.presentacion.bajadaPortada}</p>
      <p class="portada__frase" data-hero-resto>{p.presentacion.frasePortada}</p>
    </div>
    <ol class="portada__marcas" aria-hidden="true">
      {p.portadaFondo.map((_, i) => <li class:list={['portada__marca', { 'is-activa': i === 0 }]} data-portada-marca><span></span></li>)}
    </ol>
    <a href="#mirada" class="portada__bajar" aria-label="Bajar">
      <Trazo nombre="scroll" color="actual" grosor={2} dibujar={false} crayon={false} />
    </a>
  </section>

  {/* ============ MIRADA (antes hero) ============ */}
  {/* Una puerta abierta al patio: la "pill" sale desde el borde derecho de la página. Alrededor,
      "hacer · sentir · pensar" (de la frase de Marta Calvo). */}
  <section class="hero" id="mirada" aria-labelledby="hero-titulo">
    <div class="hero__aurora" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="hero__grilla contenedor">
      <div class="hero__texto">
        <h2 id="hero-titulo" class="hero__titular" data-titulo-lineas>El niño es cuerpo que siente y al <em class="acento">sentir, piensa.</em></h2>
        <p class="hero__bajada" data-revelar>{p.portada.bajada}</p>
        <p class="hero__bajada hero__bajada--2" data-revelar>{p.bienvenida.texto}</p>
      </div>
    </div>

    <div class="hero__escena">
      <span class="hero__pill-trazo" aria-hidden="true"></span>
      <div class="hero__pill" data-hero-secuencia>
        {p.portada.fotos.map((id, i) => (
          <div class:list={['hero__capa', { 'is-activa': i === 0 }]} data-hero-capa>
            <Foto id={id} ratio="4/3" sizes="(min-width: 64em) 46vw, 92vw" alt={i === 0 ? undefined : ''} />
          </div>
        ))}
      </div>
      <ul class="hero__palabras" aria-label="Hacer, sentir y pensar">
        <li class="hero__palabra hero__palabra--a" data-revelar>hacer</li>
        <li class="hero__palabra hero__palabra--b" data-revelar>sentir</li>
        <li class="hero__palabra hero__palabra--c" data-revelar>pensar</li>
      </ul>
      <div class="hero__sello" data-revelar><Sello tamano={104} color="tinta" /></div>
    </div>
  </section>

  <Telon foto="jardin-ronda-arena-arboles" rotulo="El patio de La Escuelita" alto="bajo" />

  {/* ============ BIENVENIDA ============ */}
  {/* El párrafo "La escuela es un espacio…" subió debajo de "El niño es cuerpo…" (rev. 25-11-2026); acá quedan las fotos que pasan. */}
  <section class="bienvenida seccion seccion--papel-oscuro" aria-label="La vida en La Escuelita">
    <div class="contenedor bienvenida__grilla">
      <div class="bienvenida__fotos" data-revelar>
        <PasaFotos items={[
          { id: p.bienvenida.foto }, { id: 'jardin-hojas-crayon' }, { id: 'primaria-leyenda-ronda' }, { id: 'jardin-libro-cara' },
          { id: 'jardin-arcilla-figuras' }, { id: 'patio-tres-nenas-arena' }, { id: 'primaria-escribiendo-juntos' }, { id: 'jardin-musica-guitarra' },
        ]} etiqueta="La vida en La Escuelita" />
      </div>
    </div>
  </section>

  {/* ============ INTERLUDIO ============ */}
  <section class="juego-arte seccion" aria-label="El juego y el arte">
    <Topografia semilla={5} />
    <div class="contenedor juego-arte__cabeza">
      <p class="t-frase juego-arte__frase" data-frase>{p.interludio.frase}</p>
    </div>
    <CarruselCircular ids={p.interludio.fotos} etiqueta="Juego y arte en La Escuelita" cardWidth={250} aspectRatio={0.78} gap={34} alto="clamp(20rem, 38vw, 33rem)" />
    <p class="juego-arte__ayuda" aria-hidden="true">Arrastrá para girar</p>
  </section>

  <Telon foto="taller-pintura-mesa" rotulo="El taller, todos los días" alto="medio" />

  {/* ============ EJES PEDAGÓGICOS ============ */}
  <section class="ejes seccion seccion--papel-oscuro" aria-labelledby="ejes-titulo">
    <div class="contenedor">
      <div class="ejes__cabeza cabeza-regla">
        <h2 id="ejes-titulo" data-titulo-lineas set:html={acento(p.ejes.titulo)} />
      </div>
      {p.ejes.items.map((e, i) => (
        <article class:list={['eje', { 'eje--invertido': i % 2 === 1 }]}>
          <div class="eje__foto">
            <Foto id={e.foto} ratio="16/10" sizes="(min-width: 56em) 55vw, 100vw" revelar />
          </div>
          <div class="eje__texto">
            <h3 class="eje__titulo" data-titulo-lineas>{e.titulo}</h3>
            <div class="prosa eje__prosa" data-revelar set:html={parrafos(e.texto)} />
          </div>
        </article>
      ))}
      <div class="ejes__mas" data-revelar>
        <Boton href="/proyecto-pedagogico/" variante="rojo" tamano="grande" class="ejes__boton">Conocé el proyecto pedagógico</Boton>
      </div>
    </div>
  </section>

  {/* ============ DOS PUERTAS ============ */}
  <Puertas />

  {/* ============ COMUNIDAD (ADELANTO) ============ */}
  <section class="adelanto seccion" aria-labelledby="adelanto-titulo">
    <div class="contenedor adelanto__grilla">
      <div class="adelanto__fotos" data-revelar>
        <PasaFotos items={p.comunidadFotos.map((id) => ({ id }))} etiqueta="La comunidad de La Escuelita" ratio="3/2" />
      </div>
      <div class="adelanto__cabeza">
        <h2 id="adelanto-titulo" class="adelanto__titulo" data-titulo-lineas set:html={acento(comunidad.portada.titulo)} />
        <p class="t-lead" data-revelar>{comunidad.portada.bajada}</p>
        <div class="adelanto__boton" data-revelar><Boton href="/comunidad/" variante="rojo">Conocé nuestra comunidad</Boton></div>
      </div>
    </div>
  </section>

  <Instagram />

  <LlamadoEntrevista foto={p.cierreFoto} />
</Base>

<style>
  /* ---------- HERO PRINCIPAL ---------- */
  .portada { position: relative; overflow: hidden; height: 100vh; height: 100svh; min-height: 32rem; max-height: 68rem; background: var(--tinta); color: #fff; display: flex; align-items: center; justify-content: center; text-align: center; }
  .portada__fondo { position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 0; } /* las capas quedan debajo del velo */
  /* Fundido cruzado (rev. 25-11-2026, "que sea fluido"):
     · la que entra aparece encima en 2,4 s con una curva suave; la que sale queda quieta y opaca debajo;
     · el zoom es una animación continua desde que la foto entra hasta que termina de taparla la siguiente
       (misma velocidad todo el tiempo: no se frena ni salta al cambiar de foto);
     · solo las dos capas visibles se componen en la GPU (en celulares, cinco capas a pantalla completa trababan). */
  .portada__capa { position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 0; opacity: 0; visibility: hidden; }
  .portada__capa.is-previa { z-index: 1; opacity: 1; visibility: visible; will-change: opacity; }
  .portada__capa.is-activa { z-index: 2; opacity: 1; visibility: visible; will-change: opacity; transition: opacity 2.4s cubic-bezier(0.37, 0, 0.63, 1); }
  .portada__capa + .portada__capa { display: none; }
  .portada.is-secuencia .portada__capa { display: block; }
  .portada__capa :global(.foto) { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
  .portada__capa :global(picture), .portada__capa :global(img) { display: block; width: 100%; height: 100%; }
  .portada__capa :global(img) { object-fit: cover; -webkit-backface-visibility: hidden; backface-visibility: hidden; }
  .portada__capa.is-activa :global(img), .portada__capa.is-previa :global(img) { will-change: transform; animation: portada-zoom 9s linear both; }
  @keyframes portada-zoom { from { transform: scale(1.001); } to { transform: scale(1.07); } }
  /* La foto de la portada aparece sin el fundido de carga de las demás fotos */
  .portada__capa :global(.foto__lqip) { display: none; }
  :global(html.reducido) .portada__capa :global(img), :global(html.liviano) .portada__capa :global(img) { animation: none; transform: none; }
  /* Velo liviano (las fotos se veían oscuras en el celular): apenas en el centro y la base, para que el texto se lea */
  .portada__velo { position: absolute; z-index: 1; top: 0; left: 0; right: 0; bottom: 0; background: radial-gradient(ellipse 60% 45% at 50% 50%, rgba(20, 16, 12, 0.24), rgba(20, 16, 12, 0) 75%), linear-gradient(180deg, rgba(20, 16, 12, 0.12) 0%, rgba(20, 16, 12, 0) 30%, rgba(20, 16, 12, 0) 62%, rgba(20, 16, 12, 0.32) 100%); }
  .portada__contenido { position: relative; z-index: 2; padding-top: var(--header-h); }
  .portada__titulo { margin: 0; color: #fff; font-size: 3.4rem; font-size: clamp(3.4rem, 1.4rem + 8vw, 9rem); font-weight: 330; line-height: 0.95; letter-spacing: -0.035em; }
  /* Etiqueta de papel con la palabra del logo */
  .portada__etiqueta {
    position: relative; display: inline-block;
    width: 82vw; max-width: 46rem;
    padding: 1.1rem 1.6rem 1.25rem;
    padding: clamp(0.9rem, 2.2vw, 1.8rem) clamp(1.2rem, 3.2vw, 2.8rem) clamp(1rem, 2.4vw, 2rem);
    background-color: var(--papel);
    background-image: url('/textura-papel.png');
    box-shadow: 0 2px 3px rgba(20, 16, 12, 0.18), 0 30px 60px -24px rgba(20, 16, 12, 0.6);
    transform: rotate(-1.6deg);
  }
  .portada__etiqueta img { display: block; width: 100%; height: auto; }
  .portada__etiqueta .cinta { top: -0.6rem; }
  .portada__bajada { margin: 1.3rem auto 0; max-width: 34ch; color: #fff; font-size: 0.8125rem; font-size: clamp(0.8125rem, 0.72rem + 0.35vw, 1.0625rem); font-weight: 650; letter-spacing: 0.12em; text-transform: uppercase; line-height: 1.5; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45), 0 2px 18px rgba(0, 0, 0, 0.5); }
  .portada__frase { margin: 0.8rem auto 0; max-width: 30ch; color: #fff; font-family: var(--f-titulo); font-style: italic; font-size: 1.2rem; font-size: clamp(1.2rem, 0.95rem + 0.9vw, 1.75rem); line-height: 1.3; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4), 0 4px 24px rgba(0, 0, 0, 0.5); }
  /* Marcas de avance: una rayita por foto */
  .portada__marcas { position: absolute; z-index: 2; left: 50%; bottom: 2rem; transform: translateX(-50%); display: flex; list-style: none; margin: 0; padding: 0; }
  .portada__marca { width: 2.25rem; height: 2px; margin: 0 0.25rem; background: rgba(255, 255, 255, 0.35); overflow: hidden; }
  .portada__marca span { display: block; width: 100%; height: 100%; background: #fff; transform: scaleX(0); transform-origin: 0 50%; }
  .portada__marca.is-activa span { transform: scaleX(1); transition: transform 5.5s linear; }
  .portada__marca.is-hecha span { transform: scaleX(1); }
  :global(html.reducido) .portada__marcas, :global(html.liviano) .portada__marcas { display: none; }
  .portada__bajar { position: absolute; z-index: 2; right: var(--gutter); bottom: 1.5rem; width: 1.2rem; height: 2.6rem; color: #fff; opacity: 0.85; }
  .portada__bajar :global(svg) { width: 100%; height: 100%; }
  @media (max-width: 47.99em) { .portada__bajar { display: none; } .portada__marcas { bottom: 1.5rem; } }


  /* ---------- MIRADA (hero anterior) ---------- */
  .hero {
    position: relative; overflow: hidden;
    padding: 4.5rem 0 3rem;
    background: var(--papel);
  }
  @media (min-width: 64em) { .hero { min-height: 44rem; display: flex; align-items: center; padding: 6rem 0; } }
  /* Aurora de pintura: manchas de color muy suaves (CSS, sin WebGL) */
  .hero__aurora { position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none; overflow: hidden; }
  .hero__aurora span { position: absolute; border-radius: 50%; }
  .hero__aurora span:nth-child(1) { width: 60vw; height: 60vw; right: -18vw; top: -20vw; background: radial-gradient(closest-side, rgba(242, 201, 168, 0.75), rgba(242, 201, 168, 0)); }
  .hero__aurora span:nth-child(2) { width: 50vw; height: 50vw; right: 10vw; bottom: -26vw; background: radial-gradient(closest-side, rgba(207, 224, 196, 0.8), rgba(207, 224, 196, 0)); }
  .hero__aurora span:nth-child(3) { width: 40vw; height: 40vw; left: -18vw; top: 14%; background: radial-gradient(closest-side, rgba(246, 220, 212, 0.7), rgba(246, 220, 212, 0)); }
  @media (min-width: 64em) and (prefers-reduced-motion: no-preference) {
    .hero__aurora span:nth-child(1) { animation: aurora-a 22s ease-in-out infinite alternate; }
    .hero__aurora span:nth-child(2) { animation: aurora-b 26s ease-in-out infinite alternate; }
    .hero__aurora span:nth-child(3) { animation: aurora-a 30s ease-in-out infinite alternate-reverse; }
  }
  @keyframes aurora-a { to { transform: translate3d(-4vw, 3vw, 0) scale(1.08); } }
  @keyframes aurora-b { to { transform: translate3d(3vw, -4vw, 0) scale(0.94); } }
  :global(html.liviano) .hero__aurora span { animation: none; }

  .hero__grilla { position: relative; z-index: 2; width: 100%; }
  .hero__texto { max-width: 36rem; }
  @media (min-width: 64em) { .hero__texto { width: 48%; max-width: 40rem; } }
  .hero__titular {
    max-width: 14ch;
    font-size: 2.25rem;
    font-size: clamp(2.25rem, 1.15rem + 3.5vw, 4.35rem);
    font-weight: 330;
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--tinta);
  }
  .hero__titular .acento { color: var(--bordo); font-weight: 300; }
  .hero__bajada { margin-top: 1.4rem; max-width: 34rem; font-size: 1.0625rem; font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem); line-height: 1.55; color: var(--tinta-suave); }
  .hero__bajada.hero__bajada--2 { margin-top: 1rem; }

  /* Escena: "pill" acostada que sale del borde derecho (borde recto contra el borde de la página) */
  .hero__escena { position: relative; z-index: 1; width: 92%; margin: 2.5rem 0 0 auto; }
  @media (min-width: 64em) {
    .hero__escena { position: absolute; right: 0; top: 50%; width: 44vw; margin: 0; transform: translateY(-50%); }
  }
  .hero__pill { position: relative; z-index: 1; overflow: hidden; border-radius: 999px 0 0 999px; background: var(--papel-hondo); box-shadow: 0 30px 60px -30px rgba(60, 40, 20, 0.5); isolation: isolate; }
  .hero__pill::before { content: ''; display: block; padding-top: 72%; }
  @media (min-width: 64em) { .hero__pill::before { padding-top: 78%; } }
  .hero__pill-trazo { position: absolute; z-index: 0; top: -0.7rem; left: -0.8rem; right: -2rem; bottom: 0.6rem; border: 2.5px solid var(--rojo-vivo); border-right: 0; border-radius: 999px 0 0 999px; transform: rotate(-1.5deg); filter: url(#crayon); }
  .hero__capa { position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 0; opacity: 0; }
  .hero__capa.is-previa { z-index: 1; opacity: 1; }
  .hero__capa.is-activa { z-index: 2; opacity: 1; transition: opacity 2.2s ease-in-out; }
  .hero__capa + .hero__capa { display: none; }
  .hero.is-secuencia .hero__capa { display: block; }
  .hero__capa :global(.foto) { height: 100%; }
  .hero__capa :global(.foto--recorte::before) { display: none; }
  .hero__capa :global(img) { transform: scale(1.04); transition: transform 9s linear, opacity 0.7s var(--ease-suave); }
  .hero__capa.is-activa :global(img), .hero__capa.is-previa :global(img) { transform: scale(1.12); }
  :global(html.reducido) .hero__capa :global(img), :global(html.liviano) .hero__capa :global(img) { transform: none; }
  .hero__palabras { list-style: none; margin: 0; padding: 0; }
  .hero__palabra {
    position: absolute; z-index: 4;
    padding: 0.05rem 0.6rem 0.2rem; border-radius: 999px; background: rgba(250, 246, 238, 0.92);
    font-family: 'Manuscrita', var(--f-titulo); font-size: 1.6rem; line-height: 1; color: var(--tinta);
    animation: palabra-flota 6s ease-in-out infinite;
  }
  .hero__palabra--a, .hero__palabra--b, .hero__palabra--c { color: var(--bordo); }
  .hero__palabra--a { left: 4%; top: 4%; animation-delay: -1s; }
  .hero__palabra--b { left: -4%; top: 44%; animation-delay: -3s; }
  .hero__palabra--c { left: 6%; bottom: 6%; animation-delay: -5s; }
  @media (min-width: 64em) {
    .hero__palabra { font-size: 2rem; }
    .hero__palabra--a { left: 2%; top: -3%; }
    .hero__palabra--b { left: -6.5rem; top: 46%; }
    .hero__palabra--c { left: 3%; bottom: -3%; }
  }
  @keyframes palabra-flota { 0%, 100% { transform: translate3d(0, 0, 0) rotate(-3deg); } 50% { transform: translate3d(0, -8px, 0) rotate(2deg); } }
  @media (prefers-reduced-motion: reduce) { .hero__palabra { animation: none; } }
  :global(html.liviano) .hero__palabra { animation: none; }
  .hero__sello { position: absolute; left: 30%; bottom: -2.5rem; z-index: 4; padding: 6px; border-radius: 50%; background: rgba(250, 246, 238, 0.92); }
  @media (max-width: 47.99em) { .hero__sello { display: none; } }

  /* ---------- BIENVENIDA ---------- */
  .bienvenida { overflow: hidden; }
  .bienvenida__paleta { margin: 0 0 1.5rem; }
  .bienvenida, .ejes { overflow: hidden; }
  .bienvenida__grilla { display: grid; grid-template-columns: 1fr; grid-gap: 1.7rem; gap: 1.7rem; align-items: center; }
  .abanico { position: relative; width: 100%; max-width: 36rem; margin: 0 auto; }
  .abanico::before { content: ''; display: block; padding-top: 78%; }
  .abanico__foto, .abanico__mini {
    position: absolute; margin: 0;
    background: #fffdf8; padding: 0.4rem 0.4rem 0.6rem;
    box-shadow: 0 2px 3px rgba(60, 40, 20, 0.08), 0 22px 40px -18px rgba(60, 40, 20, 0.45);
    transform: rotate(var(--r, 0deg));
    transition: transform 0.7s var(--ease-out);
  }
  .abanico__foto--centro { width: 62%; left: 19%; top: 10%; z-index: 3; }
