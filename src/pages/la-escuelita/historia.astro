---
// NUESTRA HISTORIA — orden pedido por la escuela (rev. 19-11-2026):
//   1. Nuestra historia (con el reconocimiento a Marta Calvo: texto a la izquierda, 4 fotos a la derecha)
//   2. V.E.A.
//   3. Hitos culturales (uno debajo del otro, con viñeta bordó, sin las fechas 1979-1990)
// La cronología completa queda como botón opcional (/la-escuelita/cronologia/).
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import Logo from '../../components/Logo.astro';
import Boton from '../../components/Boton.astro';
import Sello from '../../components/Sello.astro';
import Desplegable from '../../components/Desplegable.astro';
import Galeria from '../../components/Galeria.astro';
import Dibujito from '../../components/Dibujito.astro';
import { inicio } from '../../content/inicio';
import { laEscuelita as e } from '../../content/la-escuelita';
import { parrafos, enLinea, acento } from '../../lib/texto';
const [f1, f2, f3] = e.historia.collage;
const archivo = e.historia.fotos.filter((f) => !e.historia.collage.includes(f));
---
<Base
  titulo="Nuestra historia"
  descripcion="La Escuelita nació en 1959 como un proyecto innovador de la profesora Marta Calvo. Su historia, el reconocimiento a su trayectoria, la Asociación Civil V.E.A. y los hitos culturales."
  fotoOg="historica-dibujo-pared"
  progreso
>
  {/* ============ 1. NUESTRA HISTORIA ============ */}
  <section class="h-hero" data-hero aria-labelledby="h-titulo">
    <div class="contenedor h-hero__grilla">
      <div class="h-hero__texto">
        <p class="t-volanta" data-hero-resto>La Escuelita</p>
        <h1 id="h-titulo" class="h-hero__titulo" data-hero-titular set:html={acento(e.historia.titulo)} />
        <p class="h-hero__frase t-frase" data-hero-resto>{inicio.lineaDeTiempo.frase}</p>
        <p class="h-hero__bajada" data-hero-resto>{inicio.lineaDeTiempo.bajada}</p>
        <p class="h-hero__parrafo" data-hero-resto>{e.historia.texto}</p>
        <div class="h-hero__acciones" data-hero-resto>
          <Boton href="/la-escuelita/cronologia/" variante="rojo">Recorrer la cronología</Boton>
        </div>
      </div>
      <div class="h-hero__collage" aria-hidden="true">
        <div class="pegada h-hero__f1" style="--rot:-4deg"><span class="cinta"></span><Foto id={f1} ratio="3/4" sizes="(min-width: 64em) 22vw, 50vw" prioridad /></div>
        <div class="pegada h-hero__f2" style="--rot:5deg"><Foto id={f2} ratio="4/3" sizes="(min-width: 64em) 20vw, 46vw" /></div>
        <div class="pegada h-hero__f3" style="--rot:-2deg"><Foto id={f3} ratio="4/3" sizes="(min-width: 64em) 18vw, 42vw" /></div>
        <div class="h-hero__sello"><Sello tamano={110} color="tinta" /></div>
      </div>
    </div>
  </section>

  <section class="archivo seccion seccion--papel-oscuro" aria-label="Archivo fotográfico">
    <div class="contenedor">
      <Galeria ids={archivo} variante="pegadas" sizes="(min-width: 48em) 30vw, 46vw" />
    </div>
  </section>

  {/* Reconocimiento a Marta Calvo: texto a la izquierda, fotos a la derecha */}
  <section class="seccion reconocimiento ancla" id="reconocimiento" aria-labelledby="rec-titulo">
    <div class="contenedor reconocimiento__grilla">
      <div class="reconocimiento__texto-col">
        <p class="reconocimiento__fecha" data-revelar>22 · 08 · 2024</p>
        <h2 id="rec-titulo" class="reconocimiento__titulo" data-titulo-lineas set:html={acento(e.reconocimiento.titulo)} />
        <p class="reconocimiento__texto" data-revelar>{e.reconocimiento.texto}</p>
        <div class="carta-desplegable" data-revelar>
          <Desplegable id="carta" boton={e.reconocimiento.boton} botonCerrar="Cerrar la carta" centrado={false}>
            <article class="carta" aria-label="Carta de agradecimiento de Marta Calvo">
              <p class="carta__fecha">{e.carta.lugarFecha}</p>
              {e.carta.parrafos.map((par) => <p set:html={enLinea(par)} />)}
              <footer class="carta__firma">
                <p class="carta__nombre">{e.carta.firma}</p>
                {e.carta.cargos.map((c) => <p class="carta__cargo">{c}</p>)}
              </footer>
            </article>
          </Desplegable>
        </div>
      </div>
      <ul class="marta" aria-label="Fotos de Marta Calvo">
        {e.reconocimiento.fotos.map((f, i) => (
          <li class:list={['marta__foto', 'pegada', `marta__foto--${i + 1}`]} style={`--rot:${[-2.2, 1.8, 1.4, -1.6][i]}deg`} data-revelar>
            {i === 0 && <span class="cinta" aria-hidden="true"></span>}
            <Foto id={f} ratio="4/5" sizes="(min-width: 56em) 20vw, 44vw" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ============ 2. V.E.A. ============ */}
  <section class="seccion seccion--papel-oscuro vea ancla" id="vea" aria-labelledby="vea-titulo">
    <Dibujito nombre="cara-pelo-largo" lado="der" top="8%" ancho="6.5rem" rot={6} />
    <div class="contenedor">
      <div class="vea__grilla">
        <div class="vea__logo" data-revelar>
          <Logo nivel="vea" alto={150} />
          <p class="vea__anio t-cifra" aria-hidden="true"><span data-contador="1992" data-desde="1959">1992</span></p>
        </div>
        <div class="vea__texto">
          <h2 id="vea-titulo" class="vea__titulo" data-titulo-lineas set:html={acento(e.vea.titulo)} />
          <div class="prosa" data-revelar set:html={parrafos(e.vea.texto)} />
        </div>
      </div>
      <h3 class="vea__ejes-titulo" data-titulo-lineas>{e.vea.ejesTitulo}</h3>
      <ul class="vea__ejes">
        {e.vea.ejes.map((x) => (
          <li class="vea-eje" data-revelar>
            <h4 class="vea-eje__titulo">{x.etiqueta}</h4>
            <p>{x.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ============ 3. HITOS CULTURALES ============ */}
  <section class="seccion hitos ancla" id="hitos" aria-labelledby="hitos-titulo">
    <div class="contenedor hitos__grilla">
      <div class="hitos__cabeza">
        <h2 id="hitos-titulo" data-titulo-lineas set:html={acento(e.hitos.titulo)} />
        <p class="hitos__intro" data-revelar>{e.hitos.intro}</p>
      </div>
      <ul class="hitos__lista">
        {e.hitos.items.map((h) => (
          <li class="hito-l" data-revelar>
            <h3 class="hito-l__titulo">{h.etiqueta}</h3>
            <p class="hito-l__texto">{h.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="seccion seccion--ceñida equipo-link">
    <div class="contenedor equipo-link__caja">
      <p class="equipo-link__texto" data-revelar>Nuestro equipo</p>
      <Boton href="/la-escuelita/equipo/">Conocé al equipo</Boton>
    </div>
  </section>
</Base>

<style>
  /* ----- Portada (estilo de la cronología) ----- */
  .h-hero { position: relative; overflow: hidden; padding-top: calc(var(--header-h) + 2.5rem); padding-bottom: 2.5rem; background: radial-gradient(60vw 40vw at 85% 10%, rgba(242, 201, 168, 0.45), rgba(242, 201, 168, 0)), radial-gradient(50vw 40vw at 10% 90%, rgba(207, 224, 196, 0.5), rgba(207, 224, 196, 0)), var(--papel); }
  .h-hero__grilla { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr; grid-gap: 2.5rem; gap: 2.5rem; align-items: center; }
  @media (min-width: 64em) { .h-hero__grilla { grid-template-columns: 1fr 1fr; min-height: 38rem; } }
  .h-hero__titulo { margin-top: 1rem; font-size: 2.8rem; font-size: clamp(2.8rem, 1.4rem + 5vw, 6rem); font-weight: 320; line-height: 0.95; letter-spacing: -0.04em; max-width: 9ch; }
  .h-hero__frase { margin-top: 1.25rem; font-size: 1.26rem; font-size: var(--t-lg); color: var(--tinta); }
  .h-hero__bajada { margin-top: 0.5rem; color: var(--tinta-suave); }
  .h-hero__parrafo { margin-top: 1.25rem; font-size: 1.0625rem; font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.2rem); line-height: 1.6; color: var(--tinta-suave); max-width: 36rem; }
  .h-hero__acciones { display: flex; flex-wrap: wrap; margin-top: 1.75rem; }
  .h-hero__acciones > :global(*) { margin: 0 0.75rem 0.75rem 0; }
  .h-hero__collage { position: relative; min-height: 22rem; }
  .h-hero__collage .pegada { position: absolute; }
  .h-hero__f1 { width: 46%; left: 6%; top: 4%; z-index: 2; }
  .h-hero__f2 { width: 44%; right: 2%; top: 14%; z-index: 1; }
  .h-hero__f3 { width: 40%; right: 16%; bottom: 0; z-index: 3; }
  .h-hero__sello { position: absolute; left: 0; bottom: 6%; z-index: 4; }
  @media (max-width: 63.99em) { .h-hero__collage { min-height: 0; height: 26rem; } }
  @media (max-width: 30em) { .h-hero__collage { height: 20rem; } .h-hero__sello { transform: scale(0.7); transform-origin: 0 100%; } }

  /* ----- Reconocimiento: texto a la izquierda, fotos de Marta Calvo a la derecha ----- */
  .reconocimiento__grilla { display: grid; grid-template-columns: 1fr; grid-gap: 2.5rem; gap: 2.5rem; align-items: start; }
  @media (min-width: 56em) { .reconocimiento__grilla { grid-template-columns: 6fr 5fr; grid-gap: 4rem; gap: 4rem; } }
  .reconocimiento__fecha { margin: 0 0 1rem; font-weight: 700; letter-spacing: 0.2em; color: var(--bordo); font-size: 0.875rem; }
  .reconocimiento__titulo { margin: 0; max-width: 16ch; }
  .reconocimiento__texto { margin: 1.275rem 0 0; font-size: 1.125rem; font-size: var(--t-md); }
  .carta-desplegable { margin-top: 1.7rem; }
  .marta { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; grid-gap: 1.25rem; gap: 1.25rem; }
  .marta__foto { position: relative; margin: 0; }
  .marta__foto--2, .marta__foto--4 { margin-top: 1.75rem; }
  .marta__foto--3 { margin-top: -0.5rem; }

  /* La carta: papel, márgenes amplios, serif, firma */
  .carta {
    position: relative;
    max-width: 44rem;
    margin: 0;
    padding: 1.7rem 1.275rem;
    padding: clamp(1.7rem, 4.2vw, 3.4rem) clamp(1.275rem, 4.9vw, 3.74rem);
    background-color: #fffdf8;
    background-image: url('/textura-papel.png'), linear-gradient(rgba(140, 90, 18, 0.06) 1px, transparent 1px);
    background-size: 160px 160px, 100% 2.1rem;
    box-shadow: var(--sombra-papel-alta);
    transform: rotate(-0.4deg);
    font-family: var(--f-titulo);
    font-size: 0.978rem;
    font-size: clamp(0.978rem, 0.82rem + 0.294vw, 1.05rem);
    line-height: 1.75;
    color: #2b2620;
  }
  .carta p { max-width: none; }
  .carta p + p { margin-top: 1.1em; }
  .carta__fecha { text-align: right; font-style: italic; color: var(--tinta-suave); margin-bottom: 1.7rem; }
  .carta__firma { margin-top: 1.7rem; padding-top: 1.275rem; border-top: 1px solid rgba(35, 32, 28, 0.15); }
  .carta__nombre { font-style: italic; font-size: 1.48rem; line-height: 1.1; color: var(--bordo); }
  .carta__cargo { margin-top: 0.6rem !important; font-family: var(--f-texto); font-size: 0.875rem; line-height: 1.5; color: var(--tinta-suave); }

  /* ----- V.E.A. ----- */
  .vea { overflow: hidden; }
  .vea__grilla { display: grid; grid-template-columns: 1fr; grid-gap: 1.7rem; gap: 1.7rem; align-items: center; margin-bottom: 2.72rem; }
  .vea__logo { display: flex; flex-direction: column; align-items: flex-start; }
  .vea__anio { margin-top: 1.25rem; font-size: 3.01rem; font-size: clamp(3.01rem, 1.64rem + 3.6vw, 4.2rem); color: var(--rojo); }
  .vea__titulo { font-size: 1.387rem; font-size: var(--t-xl); margin-bottom: 1.275rem; max-width: 22ch; }
  .vea__ejes-titulo { font-size: 1.26rem; font-size: var(--t-lg); margin-bottom: 1.7rem; }
  .vea__ejes { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr; grid-gap: 1.25rem; gap: 1.25rem; }
  .vea-eje { padding: 1.275rem; border: 1px solid rgba(35, 32, 28, 0.14); border-radius: var(--radio-lg); background: #fffdf8; }
  .vea-eje__titulo { font-family: var(--f-titulo); font-weight: 450; font-size: 1.25rem; margin-bottom: 0.5rem; }
  @media (min-width: 48em) { .vea__ejes { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 64em) { .vea__ejes { grid-template-columns: repeat(6, 1fr); } .vea-eje { grid-column: span 2; } .vea-eje:nth-child(4) { grid-column: 2 / span 2; } }
  @media (min-width: 56em) { .vea__grilla { grid-template-columns: 4fr 7fr; grid-gap: 3.4rem; gap: 3.4rem; } }

  /* ----- Hitos: uno debajo del otro, viñeta bordó ----- */
  .hitos__grilla { display: grid; grid-template-columns: 1fr; grid-gap: 2rem; gap: 2rem; }
  @media (min-width: 56em) { .hitos__grilla { grid-template-columns: 5fr 7fr; grid-gap: 4rem; gap: 4rem; align-items: start; } .hitos__cabeza { position: -webkit-sticky; position: sticky; top: calc(var(--header-h) + 3rem); } }
  .hitos__intro { margin-top: 1rem; color: var(--tinta-suave); font-size: 1.125rem; font-size: var(--t-md); }
  .hitos__lista { list-style: none; padding: 0; margin: 0; }
  .hito-l { position: relative; padding: 0 0 1.75rem 2rem; }
  .hito-l + .hito-l { padding-top: 1.75rem; border-top: 1px solid rgba(35, 32, 28, 0.12); }
  .hito-l::before { content: ''; position: absolute; left: 0.1rem; top: 0.45rem; width: 0.75rem; height: 0.75rem; border-radius: 50%; background: var(--bordo); }
  .hito-l + .hito-l::before { top: 2.2rem; }
  .hito-l__titulo { color: var(--tinta); font-size: 1.26rem; font-size: var(--t-lg); margin-bottom: 0.6rem; }
  .hito-l__texto { color: var(--tinta-suave); }

  .equipo-link__caja { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; border-top: 1px solid rgba(35, 32, 28, 0.15); padding-top: 1.7rem; }
  .equipo-link__texto { font-family: var(--f-titulo); font-size: 1.48rem; font-size: var(--t-xl); margin: 0 1.7rem 1rem 0; }
</style>
