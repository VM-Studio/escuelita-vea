---
// NUESTRA IDENTIDAD — primer desplegable de "La Escuelita" (pedido de la escuela, rev. 19-11-2026):
// frase de Marta Calvo (con su firma), texto de identidad, collage de fotos y los pilares fundamentales.
import Dibujito from '../../components/Dibujito.astro';
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import Boton from '../../components/Boton.astro';
import Interludio from '../../components/Interludio.astro';
import { laEscuelita as e } from '../../content/la-escuelita';
import { parrafos, acento } from '../../lib/texto';
const id = e.identidad;
---
<Base
  titulo="Nuestra identidad"
  descripcion="La Escuelita es una institución de educación por el arte centrada en el desarrollo integral y humano de cada niño y niña. Nuestra identidad y nuestros pilares fundamentales."
  fotoOg={id.collage[0]}
  progreso
>
  <section class="identidad" data-hero aria-labelledby="id-titulo">
    <div class="contenedor identidad__grilla">
      <div class="identidad__texto-col">
        <p class="t-volanta" data-hero-resto>La Escuelita</p>
        <h1 id="id-titulo" class="identidad__titulo" data-hero-titular set:html={acento(id.titulo)} />
        <figure class="identidad__cita" data-hero-resto>
          <blockquote><p class="t-frase identidad__frase">{id.frase}</p></blockquote>
          <figcaption class="identidad__firma">— {id.fraseFirma}</figcaption>
        </figure>
        <p class="identidad__texto" data-hero-resto>{id.texto}</p>
      </div>
      <ul class="collage" aria-label="Fotos de La Escuelita" data-hero-resto>
        {id.collage.map((f, i) => (
          <li class:list={['collage__item', `collage__item--${i + 1}`]}>
            <Foto id={f} ratio="4/3" sizes={i === 0 ? '(min-width: 56em) 30vw, 92vw' : '(min-width: 56em) 16vw, 46vw'} prioridad={i === 0} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="seccion seccion--papel-oscuro pilares-sec" aria-labelledby="pilares-titulo">
    <div class="contenedor">
      <h2 id="pilares-titulo" class="pilares__intro" data-revelar>{id.pilaresIntro}</h2>
      <ul class="pilares">
        {id.pilares.map((x) => (
          <li class="pilar" data-revelar>
            <h3 class="pilar__titulo">{x.etiqueta}</h3>
            <p class="pilar__texto">{x.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ¿Por qué educar a través del arte? */}
  <section class="seccion porque" aria-labelledby="porque-titulo">
    <Dibujito nombre="esqueleto" lado="izq" top="10%" ancho="5rem" rot={-5} />
    <div class="contenedor contenedor--ancho porque__grilla">
      <h2 id="porque-titulo" class="porque__titulo" data-titulo-lineas set:html={acento(e.porQue.titulo)} />
      <div class="prosa porque__texto" data-revelar set:html={parrafos(e.porQue.texto)} />
    </div>
  </section>

  <Interludio foto={e.interludioCierre.foto} frase={e.interludioCierre.frase} firma={e.interludioCierre.firma} variante="lado" trazo="sol" ratio="1/1" />

  <section class="seccion seccion--ceñida siguiente">
    <div class="contenedor siguiente__caja">
      <Boton href="/la-escuelita/historia/">Nuestra historia</Boton>
      <Boton href="/la-escuelita/equipo/">Nuestro equipo</Boton>
    </div>
  </section>
</Base>

<style>
  .identidad { padding-top: calc(var(--header-h) + 2.5rem); padding-bottom: 3.5rem; overflow: hidden; }
  .identidad__grilla { display: grid; grid-template-columns: 1fr; grid-gap: 2.5rem; gap: 2.5rem; align-items: center; }
  @media (min-width: 56em) { .identidad__grilla { grid-template-columns: 6fr 6fr; grid-gap: 4rem; gap: 4rem; } }
  .identidad__titulo { margin-top: 1rem; font-size: 2.58rem; font-size: clamp(2.58rem, 1.312rem + 3.6vw, 4.8rem); font-weight: 300; letter-spacing: -0.04em; line-height: 0.95; }
  .identidad__cita { margin: 2rem 0 0; padding-left: 1.25rem; border-left: 3px solid var(--bordo); }
  .identidad__frase { max-width: 30ch; font-size: 1.35rem; font-size: clamp(1.35rem, 1rem + 1.2vw, 2rem); line-height: 1.25; }
  .identidad__firma { margin-top: 0.8rem; font-weight: 650; color: var(--bordo); }
  .identidad__texto { margin-top: 1.75rem; font-size: 1.125rem; font-size: var(--t-md); line-height: 1.65; }

  /* Collage: mosaico de cinco fotos */
  .collage { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; grid-gap: 0.75rem; gap: 0.75rem; }
  .collage__item { margin: 0; min-width: 0; }
  .collage__item--1 { grid-column: 1 / -1; }
  .collage__item :global(.foto) { border-radius: 3px; }
  @media (min-width: 56em) {
    .collage { grid-template-columns: repeat(6, 1fr); grid-template-rows: repeat(7, 3.6rem); grid-gap: 0.9rem; gap: 0.9rem; }
    .collage__item :global(.foto) { height: 100%; }
    .collage__item :global(.foto--recorte::before) { display: none; }
    .collage__item--1 { grid-column: 1 / 5; grid-row: 1 / 5; }
    .collage__item--2 { grid-column: 5 / 7; grid-row: 1 / 4; }
    .collage__item--3 { grid-column: 5 / 7; grid-row: 4 / 8; }
    .collage__item--4 { grid-column: 1 / 3; grid-row: 5 / 8; }
    .collage__item--5 { grid-column: 3 / 5; grid-row: 5 / 8; }
  }
  @media (min-width: 75em) { .collage { grid-template-rows: repeat(7, 4.4rem); } }

  /* Pilares: letra más grande y títulos en bordó (pedido de la escuela) */
  .pilares__intro { margin: 0 0 2.25rem; font-family: var(--f-titulo); font-style: italic; font-weight: 350; font-size: 1.6rem; font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.5rem); letter-spacing: -0.015em; }
  .pilares { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr; grid-gap: 2.25rem; gap: 2.25rem; }
  .pilar { padding-top: 1.4rem; border-top: 2px solid var(--tinta); }
  .pilar__titulo { color: var(--bordo); font-size: 1.6rem; font-size: clamp(1.5rem, 1.2rem + 0.9vw, 2.05rem); font-weight: 420; line-height: 1.12; margin-bottom: 0.8rem; }
  .pilar__texto { font-size: 1.125rem; font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem); line-height: 1.55; }
  @media (min-width: 48em) { .pilares { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 75em) { .pilares { grid-template-columns: repeat(4, 1fr); grid-gap: 2.5rem; gap: 2.5rem; } }

  .porque__grilla { display: grid; grid-template-columns: 1fr; grid-gap: 1.7rem; gap: 1.7rem; }
  .porque__titulo { max-width: 12ch; }
  .porque__texto { font-size: 1.125rem; font-size: var(--t-md); }
  @media (min-width: 56em) { .porque__grilla { grid-template-columns: 5fr 7fr; grid-gap: 2.72rem; gap: 2.72rem; } }

  .siguiente__caja { display: flex; flex-wrap: wrap; justify-content: center; border-top: 1px solid rgba(35, 32, 28, 0.15); padding-top: 1.7rem; }
  .siguiente__caja > :global(*) { margin: 0 0.5rem 0.75rem; }
</style>
