---
// CRONOLOGÍA — cronología completa (texto tal cual la web anterior) con diseño editorial y animado.
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import LlamadoEntrevista from '../../components/LlamadoEntrevista.astro';
import Boton from '../../components/Boton.astro';
import { cronologia } from '../../content/cronologia';
import { laEscuelita } from '../../content/la-escuelita';
import { acento } from '../../lib/texto';

// Agrupar por década
const decadas = new Map<string, typeof cronologia>();
for (const h of cronologia) {
  const d = `${h.anio.slice(0, 3)}0`;
  if (!decadas.has(d)) decadas.set(d, []);
  decadas.get(d)!.push(h);
}
const lista = [...decadas.entries()];
// Fotos de ambiente por década (no ilustran un hecho puntual; son del archivo y de la escuela hoy)
const fotosDecada: Record<string, string[]> = {
  '1950': ['historica-dibujo-pared'],
  '1960': ['historica-ronda-taller', 'historica-flautas'],
  '1970': ['historica-manos-pintura', 'historica-aros'],
  '1980': ['historica-mesa', 'historica-rincon'],
  '1990': ['mural-la-escuelita'],
  '2000': ['plastica-hojas-cenital'],
  '2010': ['musica-patio-familias'],
  '2020': ['primaria-primer-dia'],
};
const anios = [...new Set(cronologia.map((h) => h.anio))];
const primero = anios[0];
const ultimo = anios[anios.length - 1];
---
<Base
  titulo="Cronología · Nuestra historia"
  descripcion={`Cronología de La Escuelita desde ${primero}: exposiciones, reconocimientos, la Asociación Civil V.E.A., la Escuela Primaria y más de seis décadas de Educación por el Arte.`}
  fotoOg="historica-dibujo-pared"
  progreso
>
  {/* Cronología completa: botón opcional desde "Nuestra historia" (pedido de la escuela, rev. 19-11-2026) */}
  <section class="c-cabeza" data-hero aria-labelledby="h-titulo">
    <div class="contenedor">
      <a class="c-cabeza__volver enlace-trazo" href="/la-escuelita/historia/" data-hero-resto><span aria-hidden="true">←</span> Nuestra historia</a>
      <h1 id="h-titulo" class="c-cabeza__titulo" data-hero-titular><em class="acento">Cronología</em></h1>
    </div>
  </section>

  <div class="cronologia">
    {lista.map(([d, hitos], di) => (
      <section class:list={['decada', { 'decada--alt': di % 2 === 1 }]} id={`decada-${d}`} aria-labelledby={`decada-${d}-t`} data-linea-tiempo>
        <div class="decada__fondo" aria-hidden="true"><span data-parallax="10">{d.slice(2)}</span></div>
        <div class="contenedor decada__grilla">
          <header class="decada__cabeza">
            <h2 class="decada__titulo" id={`decada-${d}-t`}>Década del <em class="acento">{d.slice(2)}</em></h2>
            <p class="decada__rango">{hitos[0].anio}{hitos.length > 1 && hitos[hitos.length - 1].anio !== hitos[0].anio ? ` — ${hitos[hitos.length - 1].anio}` : ''}</p>
            <div class="decada__fotos">
              {(fotosDecada[d] || []).map((f, i) => (
                <div class="pegada decada__foto" style={`--rot:${i % 2 ? 3 : -2.5}deg`} data-revelar>
                  {i === 0 && <span class="cinta" aria-hidden="true"></span>}
                  <Foto id={f} ratio={i % 2 ? '4/3' : '4/5'} sizes="(min-width: 64em) 22vw, 70vw" />
                </div>
              ))}
            </div>
          </header>

          <div class="hitos-envoltura">
          <span class="hitos-lista__linea" data-linea aria-hidden="true"></span>
          <ol class="hitos-lista">
            {hitos.map((h) => (
              <li class:list={['hito-h', { 'hito-h--destacado': h.destacado }]} data-revelar>
                <span class="hito-h__punto" aria-hidden="true"></span>
                <p class="hito-h__anio t-cifra">{h.destacado ? <span data-contador={h.anio} data-desde={String(Number(h.anio) - 30)}>{h.anio}</span> : h.anio}</p>
                <div class="hito-h__cuerpo">
                  <h3 class="hito-h__titulo">{h.titulo}</h3>
                  <p class="hito-h__texto">{h.texto}</p>
                </div>
              </li>
            ))}
          </ol>
          </div>
        </div>
      </section>
    ))}
  </div>

  <section class="seccion h-cierre">
    <div class="contenedor h-cierre__caja">
      <p class="t-frase h-cierre__frase" set:html={acento(laEscuelita.reconocimiento.titulo)} />
      <div class="h-cierre__acciones">
        <Boton href="/la-escuelita/historia/#carta" variante="rojo">{laEscuelita.reconocimiento.boton}</Boton>
        <Boton href="/proyecto-pedagogico/">Conocé el proyecto pedagógico</Boton>
      </div>
    </div>
  </section>

  <LlamadoEntrevista foto="historica-ronda-taller" />
</Base>

<style>
  .c-cabeza { padding-top: calc(var(--header-h) + 2.5rem); padding-bottom: 1rem; }
  .c-cabeza__volver { font-weight: 600; font-size: 0.9375rem; text-decoration: none; }
  .c-cabeza__titulo { margin-top: 1rem; font-size: 2.8rem; font-size: clamp(2.8rem, 1.4rem + 5vw, 6rem); font-weight: 320; line-height: 0.95; letter-spacing: -0.04em; }

  /* ----- Décadas ----- */
  .decada { position: relative; overflow: hidden; padding: 3.5rem 0; padding: clamp(2.5rem, 1.5rem + 4vw, 5.5rem) 0; }
  .decada--alt { background: var(--papel-oscuro); }
  .decada__fondo { position: absolute; top: 0; right: -2vw; bottom: 0; display: flex; align-items: center; pointer-events: none; }
  .decada__fondo span { display: block; font-family: var(--f-titulo); font-weight: 300; font-size: 40vw; line-height: 0.8; letter-spacing: -0.06em; color: transparent; -webkit-text-stroke: 1.5px rgba(35, 32, 28, 0.08); }
  @supports not (-webkit-text-stroke: 1px black) { .decada__fondo span { color: rgba(35, 32, 28, 0.04); } }
  .decada__grilla { position: relative; display: grid; grid-template-columns: 1fr; grid-gap: 2rem; gap: 2rem; }
  @media (min-width: 64em) { .decada__grilla { grid-template-columns: 4fr 7fr; grid-gap: 4rem; gap: 4rem; align-items: start; } .decada__cabeza { position: -webkit-sticky; position: sticky; top: calc(var(--header-h) + 5rem); } }
  .decada__titulo { font-size: 1.9rem; font-size: clamp(1.9rem, 1.2rem + 2.6vw, 3.4rem); font-weight: 330; letter-spacing: -0.03em; }
  .decada__rango { margin-top: 0.4rem; font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.16em; color: var(--bordo); }
  .decada__fotos { display: flex; margin-top: 1.5rem; }
  .decada__foto { position: relative; width: 58%; max-width: 15rem; }
  .decada__foto + .decada__foto { width: 52%; margin-left: -12%; margin-top: 3rem; }

  .hitos-envoltura { position: relative; }
  .hitos-lista { position: relative; list-style: none; margin: 0; padding: 0 0 0 1.75rem; }
  .hitos-lista__linea { position: absolute; left: 0.35rem; top: 0.6rem; bottom: 0.6rem; width: 2px; background: var(--rojo); transform-origin: 50% 0; border-radius: 2px; }
  .hito-h { position: relative; display: grid; grid-template-columns: 1fr; grid-gap: 0.25rem; gap: 0.25rem; padding: 1.1rem 0 1.4rem; border-bottom: 1px solid rgba(35, 32, 28, 0.1); }
  .hito-h:last-child { border-bottom: 0; }
  @media (min-width: 40em) { .hito-h { grid-template-columns: 6.5rem 1fr; grid-gap: 1.5rem; gap: 1.5rem; } }
  .hito-h__punto { position: absolute; left: -1.75rem; top: 1.55rem; width: 0.85rem; height: 0.85rem; margin-left: 0.07rem; border-radius: 50%; background: var(--papel); border: 2px solid var(--rojo); transition: background-color 0.3s, transform 0.4s var(--ease-out); }
  .hito-h:hover .hito-h__punto { background: var(--rojo); transform: scale(1.2); }
  .hito-h__anio { font-size: 1.9rem; color: var(--tinta); line-height: 1; transition: color 0.3s; }
  .hito-h:hover .hito-h__anio { color: var(--rojo); }
  .hito-h__titulo { font-size: 1.15rem; font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem); font-weight: 450; line-height: 1.25; margin-bottom: 0.4rem; }
  .hito-h__texto { font-size: 0.9375rem; line-height: 1.65; color: var(--tinta-suave); max-width: 42rem; }
  /* Hitos destacados: tarjeta de color */
  .hito-h--destacado { margin: 1rem 0; padding: 1.5rem 1.5rem 1.6rem; border: 0; border-radius: 14px; background: var(--piedra); color: var(--tinta); box-shadow: none; }
  .hito-h--destacado .hito-h__punto { left: calc(-1.75rem - 0px); background: var(--rojo); }
  .hito-h--destacado .hito-h__anio { font-size: 2.8rem; font-size: clamp(2.6rem, 1.8rem + 3vw, 4.2rem); color: var(--rojo); }
  .hito-h--destacado .hito-h__titulo { color: var(--tinta); font-size: 1.35rem; font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.7rem); }
  .hito-h--destacado .hito-h__texto { color: var(--tinta-suave); }
  .hito-h__estrella { position: absolute; right: 1rem; top: 1rem; width: 2rem; height: 2rem; color: var(--rojo-vivo); }
  @media (min-width: 40em) { .hito-h--destacado { grid-template-columns: 9rem 1fr; } }

  /* ----- Cierre ----- */
  .h-cierre__caja { text-align: center; max-width: 46rem; }
  .h-cierre__sol { width: 3rem; height: 3rem; margin: 0 auto 1rem; }
  .h-cierre__frase { margin: 0 auto; font-size: 1.75rem; font-size: clamp(1.6rem, 1.1rem + 2vw, 2.75rem); max-width: 20ch; }
  .h-cierre__acciones { display: flex; flex-wrap: wrap; justify-content: center; margin-top: 1.75rem; }
  .h-cierre__acciones > :global(*) { margin: 0 0.4rem 0.75rem; }
</style>
