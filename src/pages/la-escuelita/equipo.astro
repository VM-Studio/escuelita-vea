---
import Base from '../../layouts/Base.astro';
import Trazo from '../../components/Trazo.astro';
import Foto from '../../components/Foto.astro';
import LlamadoEntrevista from '../../components/LlamadoEntrevista.astro';
import { equipo as e } from '../../content/equipo';
import { parrafos, acento } from '../../lib/texto';
---
<Base
  titulo="Nuestro equipo"
  descripcion="El equipo de La Escuelita: fundadora, asesora institucional y los equipos de conducción de Jardín y Primaria. Compromiso docente y perfiles pedagógicos."
>
  <section class="cabeza" data-hero>
    <div class="contenedor">
      <p class="t-volanta" data-hero-resto>La Escuelita</p>
      <h1 class="cabeza__titulo" data-hero-titular>{e.titulo}</h1>
      <div class="cabeza__foto" data-hero-resto>
        <Foto id="equipo-docente-hoy" ratio="21/9" sizes="(min-width: 76em) 72rem, 94vw" prioridad celular />
      </div>
    </div>
  </section>

  {/* Organigrama cálido: tipografía y trazos, sin avatares */}
  <section class="organigrama seccion" aria-label="Organigrama">
    <div class="contenedor">
      <div class="organigrama__cima">
        <div class="persona persona--fundadora" data-revelar>
          <p class="persona__cargo">{e.fundadora.cargo}</p>
          <p class="persona__nombre">{e.fundadora.nombre}</p>
        </div>
        <div class="persona persona--asesora" data-revelar>
          <p class="persona__cargo">{e.asesora.cargo}</p>
          <p class="persona__nombre">{e.asesora.nombre}</p>
        </div>
      </div>
      <svg class="organigrama__ramas" viewBox="0 0 600 90" preserveAspectRatio="none" aria-hidden="true" data-dibujar>
        <g filter="url(#crayon)" fill="none" stroke="var(--tinta-tenue)" stroke-width="1.6" stroke-linecap="round" vector-effect="non-scaling-stroke">
          <path d="M300 4 C 300 30, 302 40, 300 48" vector-effect="non-scaling-stroke" />
          <path d="M300 48 C 230 50, 160 46, 150 86" vector-effect="non-scaling-stroke" />
          <path d="M300 48 C 370 46, 440 50, 450 86" vector-effect="non-scaling-stroke" />
        </g>
      </svg>
      <div class="organigrama__niveles">
        {e.niveles.map((n) => (
          <div class:list={['nivel-eq', `nivel-eq--${n.clave}`]} data-revelar>
            <h2 class="nivel-eq__titulo">{n.nivel}</h2>
            <dl class="nivel-eq__lista">
              {n.personas.map((x) => (
                <div class="nivel-eq__fila">
                  <dt>{x.cargo}</dt>
                  <dd>{x.nombre}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion seccion--papel-oscuro compromiso" aria-labelledby="comp-titulo">
    <div class="contenedor contenedor--ancho compromiso__grilla">
      <h2 id="comp-titulo" data-titulo-lineas set:html={acento(e.compromiso.titulo)} />
      <div class="prosa compromiso__texto" data-revelar set:html={parrafos(e.compromiso.texto)} />
    </div>
  </section>

  <section class="seccion perfiles" aria-labelledby="perf-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <h2 id="perf-titulo" data-titulo-lineas set:html={acento(e.perfiles.titulo)} />
      </div>
      <div class="alternador" data-alternador>
        <ul class="copetes">
          {e.perfiles.items.map((x, i) => (
            <li class="copete-p" data-revelar>
              <h3 class="copete-p__titulo">{x.copeteEtiqueta}</h3>
              <p>{x.copete}</p>
              <button type="button" class="boton copete-p__boton" data-alternar={x.id} aria-expanded="false" aria-controls={x.id}>
                <span>{x.boton}</span>
                <span class="copete-p__signo" aria-hidden="true"></span>
              </button>
            </li>
          ))}
        </ul>
        {e.perfiles.items.map((x) => (
          <article class="perfil ancla" id={x.id} data-alternado aria-labelledby={`${x.id}-t`}>
            <h3 class="perfil__titulo" id={`${x.id}-t`}>{x.titulo}</h3>
            <p class="perfil__intro">{x.intro}</p>
            <dl class="perfil__puntos">
              {x.puntos.map((pt) => (
                <div class="perfil__punto">
                  <dt>{pt.etiqueta}</dt>
                  <dd>{pt.texto}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <LlamadoEntrevista />
</Base>

<style>
  .cabeza { padding-top: calc(var(--header-h) + 2.72rem); }
  .cabeza__titulo { margin-top: 1rem; font-size: 2.58rem; font-size: clamp(2.58rem, 1.312rem + 3.6vw, 4.5rem); font-weight: 300; letter-spacing: -0.04em; }
  .cabeza__paleta { margin-top: 1rem; }
  .cabeza__foto { margin-top: 2rem; }
  /* En el celular: la versión vertical de la foto del equipo, en un recuadro más alto para que se vean las caras */
  @media (max-aspect-ratio: 3/4) {
    .cabeza__foto :global(.foto--recorte) { --pt: 105% !important; }
    .cabeza__foto :global(.foto img) { object-position: 50% 72% !important; }
  }
  .cabeza__foto :global(.foto) { border-radius: 3px; box-shadow: 0 30px 60px -40px rgba(35, 32, 28, 0.6); }
  .cabeza__trazo { width: 60%; max-width: 24rem; height: 1.3rem; margin-top: 0.75rem; }
  .cabeza__trazo :global(svg) { width: 100%; height: 100%; }

  .organigrama__cima { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .persona { position: relative; padding: 0.5rem 1rem; }
  .persona__cargo { margin: 0 auto; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--tinta-suave); }
  .persona__nombre { margin: 0.35rem auto 0; font-family: var(--f-titulo); line-height: 1.1; }
  .persona--fundadora .persona__nombre { font-size: 1.72rem; font-size: clamp(1.72rem, 0.984rem + 2.376vw, 2.64rem); font-style: italic; font-weight: 320; }
  .persona__aro { position: relative; display: inline-block; padding: 0.55em 0.9em 0.6em; }
  .persona__circulo { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
  .persona--fundadora .persona__cargo { margin-bottom: 0.4rem; }
  .persona--asesora { margin-top: 1.488rem; }
  .persona--asesora .persona__nombre { font-size: 1.26rem; font-size: var(--t-lg); }
  .organigrama__ramas { display: block; width: 100%; max-width: 40rem; height: 3.6rem; margin: 1.25rem auto 0; overflow: visible; }
  .organigrama__niveles { display: grid; grid-template-columns: 1fr; grid-gap: 1.275rem; gap: 1.275rem; }
  .nivel-eq { padding: 1.7rem 1.275rem; padding: clamp(1.275rem, 2.1vw, 1.7rem); border-radius: var(--radio-lg); }
  .nivel-eq--jardin { background: var(--arena-claro); }
  .nivel-eq--primaria { background: var(--verde-claro); }
  .nivel-eq__titulo { font-size: 1.202rem; font-size: var(--t-xl); margin-bottom: 1.275rem; }
  .nivel-eq__fila { padding: 0.9rem 0; border-top: 1px solid rgba(35, 32, 28, 0.14); }
  .nivel-eq__fila dt { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--tinta-suave); }
  .nivel-eq__fila dd { margin: 0.25rem 0 0; font-family: var(--f-titulo); font-size: 1.375rem; line-height: 1.25; }
  @media (min-width: 48em) { .organigrama__niveles { grid-template-columns: 1fr 1fr; grid-gap: 1.7rem; gap: 1.7rem; } }
  @media (max-width: 47.99em) { .organigrama__ramas { display: none; } .organigrama__niveles { margin-top: 1.7rem; } }

  .compromiso__grilla { display: grid; grid-template-columns: 1fr; grid-gap: 1.7rem; gap: 1.7rem; }
  .compromiso__texto { font-size: 1.125rem; font-size: var(--t-md); }
  @media (min-width: 56em) { .compromiso__grilla { grid-template-columns: 5fr 7fr; grid-gap: 2.72rem; gap: 2.72rem; } }

  .copetes { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr; grid-gap: 1.25rem; gap: 1.25rem; }
  .copete-p { display: flex; flex-direction: column; align-items: flex-start; padding: 1.488rem 1.275rem; border: 1px solid rgba(35, 32, 28, 0.14); border-radius: var(--radio-lg); background: #fffdf8; }
  .copete-p__trazo { width: 2.2rem; height: 2.2rem; margin-bottom: 0.9rem; }
  .copete-p__titulo { font-size: 1.375rem; margin-bottom: 0.6rem; }
  .copete-p p { flex: 1; }
  .copete-p__boton { display: none; margin-top: 1.275rem; }
  .alternador.is-js .copete-p__boton { display: inline-flex; }
  .copete-p__boton[aria-expanded='true'] { color: var(--papel); }
  .copete-p__boton[aria-expanded='true']::before { transform: translateX(0) skewX(-12deg); }
  .copete-p__signo { position: relative; width: 0.85rem; height: 0.85rem; margin-left: 0.7rem; transition: transform 0.4s var(--ease-out); }
  .copete-p__signo::before, .copete-p__signo::after { content: ''; position: absolute; top: 50%; left: 0; width: 100%; height: 1.6px; margin-top: -0.8px; background: currentColor; }
  .copete-p__signo::after { transform: rotate(90deg); }
  .copete-p__boton[aria-expanded='true'] .copete-p__signo { transform: rotate(135deg); }
  @media (min-width: 56em) { .copetes { grid-template-columns: repeat(3, 1fr); } }

  .perfil { margin-top: 1.7rem; padding: 1.7rem 1.275rem; padding: clamp(1.488rem, 2.8vw, 2.38rem); background: var(--papel-oscuro); border-radius: var(--radio-lg); }
  .alternador.is-js .perfil.is-activo { animation: perfil-entra 0.6s var(--ease-out); }
  @keyframes perfil-entra { from { opacity: 0; transform: translate3d(0, 14px, 0); } to { opacity: 1; transform: none; } }
  .perfil__titulo { font-size: 1.387rem; font-size: var(--t-xl); margin-bottom: 1.25rem; }
  .perfil__intro { font-size: 1.125rem; font-size: var(--t-md); line-height: 1.6; max-width: 44rem; }
  .perfil__puntos { display: grid; grid-template-columns: 1fr; grid-gap: 1.275rem; gap: 1.275rem; margin-top: 1.7rem; }
  .perfil__punto dt { display: flex; align-items: center; font-family: var(--f-titulo); font-size: 1.25rem; margin-bottom: 0.4rem; }
  .perfil__tilde { width: 1.4rem; height: 1.2rem; margin-right: 0.5rem; flex: none; }
  .perfil__punto dd { margin: 0; }
  @media (min-width: 56em) { .perfil__puntos { grid-template-columns: repeat(3, 1fr); grid-gap: 1.7rem; gap: 1.7rem; } }
</style>
