---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Interludio from '../components/Interludio.astro';
import Puertas from '../components/Puertas.astro';
import Acordeon from '../components/Acordeon.astro';
import { proyecto as p } from '../content/proyecto';
import { parrafos, enLinea, acento } from '../lib/texto';
// Color de la notita de cada eje (tonos suaves de la paleta)
const notas = ['arena', 'verde-claro', 'rosa', 'azul'] as const;
---
<Base
  titulo="Proyecto pedagógico"
  descripcion="La dinámica de taller como forma cotidiana de aprendizaje: la concepción del niño, la Educación por el Arte, la expresión-aprendizaje y el rol del docente en La Escuelita."
  fotoOg={p.fotoApertura}
  progreso
>
  {/* Apertura: fotos que van pasando detrás del título (pedido de la escuela) y una "notita" colgando con el primer párrafo */}
  <section class="apertura" data-hero data-portada data-portada-intervalo="4500" aria-labelledby="apertura-titulo">
    <div class="apertura__foto" aria-hidden="true">
      {p.fotosApertura.map((id, i) => (
        <div class:list={['apertura__capa', { 'is-activa': i === 0 }]} data-portada-capa>
          <Foto id={id} sizes="100vw" prioridad={i === 0} alt="" />
        </div>
      ))}
    </div>
    <div class="apertura__velo" aria-hidden="true"></div>
    <div class="contenedor apertura__contenido">
      <p class="apertura__volanta" data-hero-resto>La Escuelita</p>
      <h1 id="apertura-titulo" class="apertura__titulo" data-hero-titular>{p.titulo}</h1>
    </div>
  </section>
  <div class="contenedor apertura__nota-caja">
    <div class="nota nota--verde apertura__nota" data-hero-resto>
      <p class="apertura__lead" set:html={enLinea(p.intro[0])} />
    </div>
  </div>

  {/* Sin el título "Introducción y metodología": los párrafos a la izquierda y, a la derecha, la botonera de los ejes */}
  <section class="intro seccion" aria-label="Nuestra metodología">
    <div class="contenedor intro__grilla">
      <div class="prosa intro__texto" data-revelar set:html={parrafos(p.intro.slice(1))} />
      <nav class="ejes-caja" aria-labelledby="ejes-titulo">
        <h2 id="ejes-titulo" class="ejes-caja__titulo" data-titulo-lineas set:html={acento(p.ejesTitulo)} />
        <p class="ejes-caja__intro" data-revelar>{p.ejesIntro}</p>
        <ol class="ejes-indice" data-revelar>
          {p.ejes.map((e, i) => <li><a href={`#${e.id}`}><span class="ejes-indice__n">{String(i + 1).padStart(2, '0')}</span>{e.titulo}<span class="ejes-indice__flecha" aria-hidden="true">→</span></a></li>)}
        </ol>
      </nav>
    </div>
  </section>

  {p.ejes.map((e, i) => (
    <>
      <article class:list={['capitulo', { 'capitulo--invertido': i % 2 === 1 }]} id={e.id} aria-labelledby={`${e.id}-titulo`}>
        <div class="contenedor capitulo__escena">
          <div class="capitulo__foto" data-revelar>
            <Foto id={e.foto} ratio="4/3" sizes="(min-width: 56em) 60vw, 100vw" foco={e.foto === 'juego-dramatico-capas' ? '50% 60%' : undefined} />
          </div>
          <div class:list={['nota', `nota--${notas[i]}`, 'capitulo__nota']} data-revelar>
            <span class="capitulo__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h2 id={`${e.id}-titulo`} class="capitulo__titulo" set:html={acento(e.titulo)} />
            <div class="prosa capitulo__prosa" set:html={parrafos(e.texto)} />
          </div>
        </div>
        {/* Rol del docente: las tres partes en acordeón interactivo (pedido de la escuela) */}
        {'apartados' in e && e.apartados && (
          <div class="contenedor apartados">
            {e.apartados.map((a, k) => (
              <Acordeon id={`${e.id}-${k + 1}`} titulo={a.etiqueta} grupo="rol-docente" abierto={k === 0}>
                <p class="apartado__texto">{a.texto}</p>
              </Acordeon>
            ))}
          </div>
        )}
      </article>
      {p.interludios.filter((x) => x.despuesDe === e.id).map((x, j) => (
        <Interludio foto={x.foto} frase={x.frase} variante={j % 2 || i > 1 ? 'lado' : 'sobre'} trazo="sol" />
      ))}
    </>
  ))}

  <Puertas titulo="Jardín y Primaria" />
</Base>

<style>
  /* ---------- Apertura ---------- */
  .apertura { position: relative; overflow: hidden; height: 72vh; min-height: 28rem; max-height: 46rem; margin-top: var(--header-h); background: var(--tinta); color: #fff; display: flex; align-items: flex-end; }
  .apertura__foto { position: absolute; top: 0; left: 0; right: 0; bottom: 0; }
  .apertura__capa { position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 0; opacity: 0; will-change: opacity; }
  .apertura__capa.is-previa { z-index: 1; opacity: 1; }
  .apertura__capa.is-activa { z-index: 2; opacity: 1; transition: opacity 2s cubic-bezier(0.45, 0, 0.55, 1); }
  .apertura__capa + .apertura__capa { display: none; }
  .apertura.is-secuencia .apertura__capa { display: block; }
  .apertura__capa :global(.foto) { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
  .apertura__capa :global(picture), .apertura__capa :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .apertura__capa :global(img) { transform: scale(1.02); transition: transform 7s linear; }
  .apertura__capa.is-activa :global(img), .apertura__capa.is-previa :global(img) { transform: scale(1.08); }
  .apertura__capa:not(.is-activa):not(.is-previa) :global(img) { transition: none; }
  .apertura__capa :global(.foto__lqip) { display: none; }
  :global(html.reducido) .apertura__capa :global(img), :global(html.liviano) .apertura__capa :global(img) { transform: none; transition: none; }
  .apertura__velo { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(90deg, rgba(20, 16, 12, 0.72) 0%, rgba(20, 16, 12, 0.45) 38%, rgba(20, 16, 12, 0) 70%), linear-gradient(0deg, rgba(20, 16, 12, 0.35), rgba(20, 16, 12, 0) 40%); }
  .apertura__contenido { position: relative; z-index: 2; padding-bottom: 5.5rem; }
  .apertura__volanta { margin: 0; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255, 255, 255, 0.85); }
  .apertura__titulo { margin-top: 0.9rem; max-width: 11ch; color: #fff; font-size: 2.8rem; font-size: clamp(2.8rem, 1.4rem + 4.4vw, 5.6rem); font-weight: 320; line-height: 0.98; letter-spacing: -0.035em; text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35); }
  @media (min-width: 56em) { .apertura__contenido { padding-bottom: 6rem; } .apertura__titulo { max-width: 14ch; } }

  /* ---------- Notita "enganchada": caja de color con borde inferior ondulado ---------- */
  .nota { position: relative; padding: 1.6rem 1.5rem 1.4rem; color: var(--tinta); background: var(--papel); box-shadow: 0 24px 50px -32px rgba(35, 32, 28, 0.55); }
  .nota::after { content: ''; position: absolute; left: 0; right: 0; top: 100%; height: 1.1rem; margin-top: -1px; background: inherit; -webkit-mask: url('/onda-nota.svg') 0 0 / 100% 100% no-repeat; mask: url('/onda-nota.svg') 0 0 / 100% 100% no-repeat; }
  @media (min-width: 56em) { .nota { padding: 1.7rem 1.9rem 1.6rem; } }
  .nota--verde { background: var(--verde); color: #fff; }
  .nota--arena { background: var(--arena-claro); }
  .nota--verde-claro { background: var(--verde-claro); }
  .nota--rosa { background: #f4dfd6; }
  .nota--azul { background: #dce5ee; }

  .apertura__nota-caja { position: relative; z-index: 3; margin-top: -3.5rem; }
  .apertura__nota { max-width: 30rem; margin: 0 auto; text-align: center; }
  .apertura__lead { margin: 0 auto; max-width: none; font-family: var(--f-titulo); font-style: italic; font-size: 1.02rem; font-size: clamp(1rem, 0.9rem + 0.35vw, 1.2rem); line-height: 1.45; color: #fff; }
  .apertura__lead :global(a) { color: inherit; }

  /* ---------- Introducción: párrafos a la izquierda, botonera de ejes a la derecha ---------- */
  .intro__grilla { display: grid; grid-template-columns: 1fr; grid-gap: 2.5rem; gap: 2.5rem; align-items: start; }
  .intro__texto { font-size: 1.0625rem; font-size: var(--t-md); }
  @media (min-width: 56em) { .intro__grilla { grid-template-columns: 7fr 5fr; grid-gap: 4.5rem; gap: 4.5rem; } .ejes-caja { position: -webkit-sticky; position: sticky; top: calc(var(--header-h) + 2rem); } }
  .ejes-caja { padding: 1.75rem 1.5rem 1.25rem; background: var(--papel-oscuro); }
  .ejes-caja__titulo { font-size: 1.8rem; font-size: clamp(1.8rem, 1.3rem + 1.6vw, 2.6rem); font-weight: 330; letter-spacing: -0.025em; }
  .ejes-caja__intro { margin-top: 0.9rem; font-size: 0.975rem; color: var(--tinta-suave); }
  .ejes-indice { list-style: none; padding: 0; margin: 1.25rem 0 0 !important; border-top: 1px solid rgba(35, 32, 28, 0.16); }
  .ejes-indice li { border-bottom: 1px solid rgba(35, 32, 28, 0.16); }
  .ejes-indice a { display: flex; align-items: baseline; padding: 1rem 0; font-family: var(--f-titulo); font-size: 1.25rem; font-size: clamp(1.2rem, 1.05rem + 0.4vw, 1.45rem); text-decoration: none; transition: color 0.3s; }
  .ejes-indice a:hover { color: var(--bordo); }
  .ejes-indice__n { margin-right: 0.85rem; font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.75rem; letter-spacing: 0.08em; color: var(--tinta-suave); }
  .ejes-indice__flecha { margin-left: auto; padding-left: 0.75rem; transition: transform 0.4s var(--ease-out); }
  .ejes-indice a:hover .ejes-indice__flecha { transform: translateX(4px); }

  /* ---------- Capítulos: foto grande + notita superpuesta ---------- */
  .capitulo { padding: 3rem 0 4.5rem; }
  .capitulo__escena { position: relative; }
  .capitulo__foto :global(.foto) { box-shadow: 0 30px 60px -40px rgba(35, 32, 28, 0.6); }
  .capitulo__nota { margin: -2rem 1rem 0; z-index: 2; }
  .capitulo__n { display: block; font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.75rem; letter-spacing: 0.1em; color: var(--tinta-suave); }
  .capitulo__titulo { margin-top: 0.5rem; font-size: 1.6rem; font-size: clamp(1.6rem, 1.15rem + 1.2vw, 2.3rem); font-weight: 320; letter-spacing: -0.03em; line-height: 1.02; max-width: 14ch; }
  .capitulo__prosa { margin-top: 0.9rem; font-size: 0.9375rem; line-height: 1.6; }
  @media (min-width: 56em) {
    .capitulo { padding: 4.5rem 0 6rem; }
    .capitulo__escena { display: grid; grid-template-columns: repeat(12, 1fr); align-items: start; }
    .capitulo__escena { align-items: end; }
    .capitulo__foto { grid-column: 5 / 13; grid-row: 1; }
    .capitulo__nota { grid-column: 1 / 6; grid-row: 1; margin: 0 0 -3rem; }
    .capitulo--invertido .capitulo__foto { grid-column: 1 / 9; }
    .capitulo--invertido .capitulo__nota { grid-column: 8 / 13; }
  }

  /* ---------- Rol docente: acordeón ---------- */
  .apartados { margin-top: 4.5rem; max-width: 58rem; }
  .apartado__texto { margin: 0; font-size: 1rem; line-height: 1.65; color: var(--tinta-suave); max-width: 46rem; }
</style>
