---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Interludio from '../components/Interludio.astro';
import Puertas from '../components/Puertas.astro';
import PortadaPagina from '../components/PortadaPagina.astro';
import Declaracion from '../components/Declaracion.astro';
import { proyecto as p } from '../content/proyecto';
import { parrafos, acento } from '../lib/texto';
---
<Base
  titulo="Proyecto pedagógico"
  descripcion="La dinámica de taller como forma cotidiana de aprendizaje: la concepción del niño, la Educación por el Arte, la expresión-aprendizaje y el rol del docente en La Escuelita."
  fotoOg={p.fotoApertura}
  progreso
>
  <PortadaPagina titulo={p.titulo} foto={p.fotoApertura} volanta="La Escuelita" rotulo="Jardín y Primaria" tamano="enorme" />

  {/* Introducción: declaración + dos columnas */}
  <section class="intro" aria-labelledby="intro-titulo">
    <div class="contenedor">
      <h2 id="intro-titulo" class="rotulo intro__rotulo">{p.introTitulo}</h2>
      <Declaracion
        texto={p.intro[0]}
        tamano="l"
        imagenes={[
          { id: 'taller-pintura-mesa', despues: 'el arte', forma: 'pastilla' },
          { id: 'jardin-risas-patio', despues: 'las infancias.', forma: 'circulo' },
        ]}
      />
      <div class="intro__columnas prosa" data-revelar set:html={parrafos(p.intro.slice(1))} />
    </div>
  </section>

  {/* Índice de ejes */}
  <section class="ejes-cabeza" aria-labelledby="ejes-titulo">
    <div class="contenedor">
      <h2 id="ejes-titulo" class="ejes-cabeza__titulo" data-revelar set:html={acento(p.ejesTitulo)} />
      <p class="ejes-cabeza__intro" data-revelar>{p.ejesIntro}</p>
      <nav class="ejes-nav" aria-label="Ejes" data-revelar>
        {p.ejes.map((e) => <a href={`#${e.id}`}><span>{e.titulo}</span></a>)}
      </nav>
    </div>
  </section>

  {/* Capítulos: título centrado, foto a lo ancho, texto en columnas (sin foto/texto a los costados) */}
  {p.ejes.map((e, i) => (
    <>
      <article class:list={['capitulo', { 'capitulo--oscuro': i === 3 }]} id={e.id} aria-labelledby={`${e.id}-titulo`}>
        <div class="contenedor">
          <h2 id={`${e.id}-titulo`} class="capitulo__titulo" data-revelar set:html={acento(e.titulo)} />
        </div>
        <div class="capitulo__banda" data-revelar>
          <Foto id={e.foto} ratio="21/9" sizes="100vw" revelar />
        </div>
        <div class="contenedor">
          <div class="capitulo__texto prosa" data-revelar set:html={parrafos(e.texto)} />
          {'apartados' in e && e.apartados && (
            <dl class="apartados">
              {e.apartados.map((a) => (
                <div class="apartado" data-revelar>
                  <dt class="apartado__titulo">{a.etiqueta}</dt>
                  <dd class="apartado__texto">{a.texto}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </article>
      {p.interludios.filter((x) => x.despuesDe === e.id).map((x) => (
        <Interludio foto={x.foto} frase={x.frase} variante={i === 0 ? 'sobre' : 'centro'} />
      ))}
    </>
  ))}

  <Puertas titulo="Jardín y Primaria" />
</Base>

<style>
  .intro { padding: 4rem 0; padding: clamp(3rem, 2rem + 4vw, 6.5rem) 0; }
  .intro__rotulo { margin-bottom: 1.5rem; padding-bottom: 0.75rem; border-bottom: 1px solid rgba(35, 32, 28, 0.14); }
  .intro__columnas { margin-top: 2.5rem; color: var(--tinta-suave); }
  .intro__columnas :global(p) { max-width: none; }
  @media (min-width: 56em) { .intro__columnas { column-count: 3; column-gap: 2.5rem; } .intro__columnas :global(p) { break-inside: avoid; } }

  .ejes-cabeza { padding: 3rem 0 2rem; border-top: 1px solid rgba(35, 32, 28, 0.12); text-align: center; }
  .ejes-cabeza__titulo { font-size: 2.2rem; font-size: clamp(2.2rem, 1rem + 4.6vw, 5.6rem); font-weight: 300; letter-spacing: -0.045em; line-height: 0.95; }
  .ejes-cabeza__intro { margin: 1rem auto 0; color: var(--tinta-suave); max-width: 36rem; }
  .ejes-nav { display: flex; flex-wrap: wrap; justify-content: center; margin-top: 2rem; }
  .ejes-nav a { margin: 0.3rem; padding: 0.55rem 1.05rem; border: 1px solid rgba(35, 32, 28, 0.2); border-radius: 999px; text-decoration: none; font-family: var(--f-titulo); font-style: italic; font-size: 1.05rem; transition: background-color 0.3s, color 0.3s, border-color 0.3s; }
  .ejes-nav a:hover { background: var(--tinta); color: var(--papel); border-color: var(--tinta); }

  .capitulo { padding: 4rem 0; padding: clamp(3rem, 2rem + 4vw, 6.5rem) 0; }
  .capitulo--oscuro { background: var(--tinta); color: var(--papel); }
  .capitulo--oscuro .capitulo__titulo, .capitulo--oscuro .apartado__titulo { color: var(--papel); }
  .capitulo--oscuro .capitulo__texto, .capitulo--oscuro .apartado__texto { color: #e3dacb; }
  .capitulo--oscuro .apartado { border-color: rgba(250, 246, 238, 0.2); }
  .capitulo__titulo { text-align: center; margin: 0 auto 2rem; max-width: 14ch; font-size: 2.6rem; font-size: clamp(2.5rem, 1rem + 5.6vw, 7rem); font-weight: 300; letter-spacing: -0.045em; line-height: 0.92; }
  .capitulo__banda { padding: 0 var(--gutter); max-width: 96rem; margin: 0 auto; }
  .capitulo__banda :global(.foto) { border-radius: 4px; }
  .capitulo__texto { margin: 2.5rem auto 0; font-size: 1.05rem; }
  .capitulo__texto :global(p) { max-width: none; }
  @media (min-width: 56em) { .capitulo__texto { column-count: 2; column-gap: 3.5rem; max-width: 62rem; } .capitulo__texto :global(p) { break-inside: avoid; } }
  .apartados { display: grid; grid-template-columns: 1fr; grid-gap: 1.75rem; gap: 1.75rem; margin: 3rem auto 0; max-width: 62rem; }
  .apartado { border-top: 1px solid rgba(35, 32, 28, 0.2); padding-top: 1rem; }
  .apartado__titulo { font-family: var(--f-titulo); font-size: 1.35rem; font-weight: 400; margin-bottom: 0.6rem; }
  .apartado__texto { margin: 0; font-size: 0.95rem; color: var(--tinta-suave); }
  @media (min-width: 56em) { .apartados { grid-template-columns: repeat(3, 1fr); grid-gap: 2.5rem; gap: 2.5rem; } }
</style>
