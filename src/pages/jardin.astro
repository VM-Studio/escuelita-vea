---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import PortadaPagina from '../components/PortadaPagina.astro';
import SubNav from '../components/SubNav.astro';
import Tabs from '../components/Tabs.astro';
import Desplegable from '../components/Desplegable.astro';
import Interludio from '../components/Interludio.astro';
import Galeria from '../components/Galeria.astro';
import PasaFotos from '../components/PasaFotos.astro';
import LlamadoEntrevista from '../components/LlamadoEntrevista.astro';
import { jardin as j } from '../content/jardin';
import { parrafos, acento } from '../lib/texto';

const subnav = [
  { href: '#que-nos-diferencia', texto: '¿Qué nos diferencia?' },
  { href: '#propuesta', texto: 'Propuesta pedagógica' },
  { href: '#salas', texto: 'Nuestras salas' },
  { href: '#lenguajes', texto: 'Nuestros lenguajes' },
  { href: '#patio', texto: 'El patio' },
  { href: '#adaptacion', texto: 'Adaptación' },
  { href: '#horarios', texto: 'Horarios' },
];
---
<Base
  titulo="Jardín"
  descripcion="Primer Jardín Argentino de Educación por el Arte (1959). Talleres de 2 a 5 años, lenguajes artísticos, el patio de arena y una adaptación artesanal y amorosa."
  nivel="jardin"
  heroOscuro
  fotoOg={j.portada.foto}
  progreso
>
  <PortadaPagina titulo={j.portada.titulo} volanta="Jardín · Nivel Inicial" foto={j.portada.foto}>
    <figure class="portada-cita">
      <blockquote><p class="t-frase portada-cita__texto">{j.portada.cita}</p></blockquote>
      <figcaption class="portada-cita__firma">— {j.portada.citaFirma}</figcaption>
    </figure>
  </PortadaPagina>

  {/* Presentación: notita colgando del hero */}
  <div class="contenedor intro-nivel">
    <div class="nota nota--arena intro-nivel__nota" data-revelar>
      <p class="intro-nivel__texto">{j.portada.texto}</p>
    </div>
  </div>

  <SubNav items={subnav} etiqueta="Secciones del Jardín" />

  {/* ¿Qué nos diferencia? — tarjetas sobrias */}
  <section class="seccion ancla" id="que-nos-diferencia" aria-labelledby="dif-titulo">
    <div class="contenedor">
      <div class="cabeza-regla cabeza">
        <h2 id="dif-titulo" class="cabeza__titulo" data-titulo-lineas set:html={acento(j.diferencias.titulo)} />
        <p class="cabeza__bajada" data-revelar>{j.diferencias.intro}</p>
      </div>
      <ul class="dif">
        {j.diferencias.items.map((d) => (
          <li class="dif__item" data-revelar>
            <article class="tarjeta">
              <div class="tarjeta__foto"><Foto id={d.foto} ratio="4/3" sizes="(min-width: 64em) 30vw, (min-width: 48em) 46vw, 92vw" /></div>
              <div class="tarjeta__cuerpo">
                <h3 class="tarjeta__titulo">{d.etiqueta}</h3>
                <p class="tarjeta__texto">{d.texto}</p>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Propuesta pedagógica — cuatro conceptos numerados + el gesto espontáneo con fotos que pasan */}
  <section class="seccion seccion--papel-oscuro ancla" id="propuesta" aria-labelledby="prop-titulo">
    <div class="contenedor">
      <div class="cabeza-regla cabeza">
        <h2 id="prop-titulo" class="cabeza__titulo" data-titulo-lineas set:html={acento(j.propuesta.titulo)} />
      </div>
      <ol class="bloques bloques--4">
        {j.propuesta.items.map((c, i) => (
          <li class="bloque" data-revelar>
            <span class="bloque__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="bloque__titulo">{c.etiqueta}</h3>
            <p class="bloque__texto">{c.texto}</p>
          </li>
        ))}
      </ol>
      <div class="gesto">
        <div class="gesto__fotos" data-revelar>
          <PasaFotos items={[
            { id: 'jardin-hojas-crayon' }, { id: 'jardin-arcilla-figuras' }, { id: 'jardin-tiza-negro' }, { id: 'jardin-collage-corazon' },
            { id: 'jardin-pintura-mesa-azul' }, { id: 'jardin-tiza-piso' }, { id: 'jardin-mesa-roja-masa' }, { id: 'jardin-construccion-amarilla' },
          ]} etiqueta="Las materias del taller" />
        </div>
        <div class="gesto__texto">
          <h3 class="gesto__titulo" data-revelar>{j.propuesta.gesto.titulo}</h3>
          <div class="prosa" data-revelar set:html={parrafos(j.propuesta.gesto.texto)} />
        </div>
      </div>
    </div>
  </section>

  <Interludio foto={j.interludioSocial.foto} frase={j.interludioSocial.frase} />

  {/* Nuestras salas */}
  <section class="seccion ancla" id="salas" aria-labelledby="salas-titulo">
    <div class="contenedor">
      <div class="cabeza-regla cabeza">
        <h2 id="salas-titulo" class="cabeza__titulo" data-titulo-lineas set:html={acento(j.salas.titulo)} />
      </div>
      <Tabs items={j.salas.items.map((s) => ({ id: s.id, texto: s.nombre, sub: s.subtitulo }))} etiqueta="Salas del Jardín">
        {j.salas.items.map((s) => (
          <section class="tabs__panel sala" id={s.id} data-panel aria-labelledby={`${s.id}-h`}>
            <div class="escena sala__escena">
              <div class="escena__foto"><Foto id={s.foto} ratio="16/9" sizes="(min-width: 56em) 60vw, 100vw" /></div>
              <div class="nota nota--arena escena__nota">
                <h3 class="escena__titulo" id={`${s.id}-h`}>{s.nombre}</h3>
                <p class="sala__sub">{s.subtitulo}</p>
                <p class="escena__texto">{s.intro}</p>
              </div>
            </div>
            <dl class:list={['bloques', s.apartados.length === 5 ? 'bloques--5' : 'bloques--4', 'sala__bloques']}>
              {s.apartados.map((a, i) => (
                <div class="bloque">
                  <dt class="bloque__titulo"><span class="bloque__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{a.etiqueta}</dt>
                  <dd class="bloque__texto">{a.texto}</dd>
                </div>
              ))}
            </dl>
          </section>
        ))}
      </Tabs>
    </div>
  </section>

  {/* Nuestros lenguajes — cada taller: foto grande + notita, y sus apartados numerados */}
  <section class="seccion seccion--papel-oscuro ancla" id="lenguajes" aria-labelledby="leng-titulo">
    <div class="contenedor">
      <div class="cabeza-regla cabeza">
        <h2 id="leng-titulo" class="cabeza__titulo" data-titulo-lineas set:html={acento(j.lenguajes.titulo)} />
        <nav class="leng-indice" aria-label="Talleres" data-revelar>
          {j.lenguajes.items.map((l) => <a href={`#${l.id}`}>{l.titulo}</a>)}
        </nav>
      </div>
      {j.lenguajes.items.map((l, i) => (
        <article class="lenguaje ancla" id={l.id} aria-labelledby={`${l.id}-t`}>
          <div class:list={['escena', { 'escena--invertida': i % 2 === 1 }]}>
            <div class="escena__foto" data-revelar>
              <Foto id={l.foto} ratio="16/9" sizes="(min-width: 56em) 60vw, 100vw" pie={'frase' in l ? l.frase : undefined} />
            </div>
            <div class:list={['nota', 'escena__nota', `nota--${(['blanca', 'verde-claro', 'rosa', 'azul', 'arena'] as const)[i % 5]}`]} data-revelar>
              <span class="escena__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="escena__titulo" id={`${l.id}-t`}>{l.titulo}</h3>
              <p class="escena__texto">{l.intro}</p>
            </div>
          </div>
          <dl class:list={['bloques', ({ 3: 'bloques--3', 4: 'bloques--4', 5: 'bloques--5' } as Record<number, string>)[l.apartados.length] ?? 'bloques--3', 'lenguaje__bloques']}>
            {l.apartados.map((a) => (
              <div class="bloque" data-revelar>
                <dt class="bloque__titulo">{a.etiqueta}</dt>
                <dd class="bloque__texto">{a.texto}</dd>
              </div>
            ))}
          </dl>
        </article>
      ))}
    </div>
  </section>

  <Interludio foto={j.interludioGrupal.foto} frase={j.interludioGrupal.frase} variante="lado" trazo="espiral" ratio="1/1" />

  {/* El patio */}
  <section class="seccion patio ancla" id="patio" aria-labelledby="patio-titulo">
    <div class="contenedor">
      <div class="cabeza-regla cabeza">
        <h2 id="patio-titulo" class="cabeza__titulo" data-titulo-lineas set:html={acento(j.patio.titulo)} />
        <p class="cabeza__bajada" data-revelar>{j.patio.intro}</p>
      </div>
    </div>
    <div class="patio__galeria">
      <div class="contenedor">
        <Galeria ids={j.patio.galeria} variante="tira" sizes="(min-width: 64em) 26vw, (min-width: 48em) 36vw, 72vw" />
        <p class="patio__frase t-frase" data-revelar>{j.patio.frase}</p>
      </div>
    </div>
    <div class="contenedor">
      <ol class="bloques bloques--5 patio__bloques">
        {j.patio.items.map((it, i) => (
          <li class="bloque" data-revelar>
            <span class="bloque__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="bloque__titulo">{it.etiqueta}</h3>
            <p class="bloque__texto">{it.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Interludio foto={j.interludioAdaptacion.foto} frase={j.interludioAdaptacion.frase} />

  {/* Adaptación */}

  <section class="seccion ancla" id="adaptacion" aria-labelledby="adap-titulo">
    <div class="contenedor adaptacion">
      <h2 id="adap-titulo" class="adaptacion__titulo" data-titulo-lineas set:html={acento(j.adaptacion.titulo)} />
      <div class="adaptacion__cuerpo">
        <div class="adaptacion__intro prosa" data-revelar set:html={parrafos(j.adaptacion.intro)} />
        <div class="adaptacion__desplegable" data-revelar>
          <Desplegable id="adaptacion-en-detalle" boton={j.adaptacion.boton} botonCerrar="Cerrar el detalle">
            <ol class="bloques adaptacion__pasos">
              {j.adaptacion.detalle.map((d, i) => (
                <li class="bloque">
                  <span class="bloque__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="bloque__titulo">{d.etiqueta}</h3>
                  <p class="bloque__texto">{d.texto}</p>
                </li>
              ))}
            </ol>
          </Desplegable>
        </div>
      </div>
    </div>
  </section>

  {/* Horarios */}
  <section class="seccion seccion--papel-oscuro ancla" id="horarios" aria-labelledby="hor-titulo">
    <div class="contenedor">
      <div class="cabeza-regla cabeza">
        <h2 id="hor-titulo" class="cabeza__titulo" data-titulo-lineas set:html={acento(j.horarios.titulo)} />
      </div>
      <div class="horarios-grilla">
        <table class="horarios" data-revelar>
          <thead>
            <tr>{j.horarios.columnas.map((c) => <th scope="col">{c}</th>)}</tr>
          </thead>
          <tbody>
            {j.horarios.filas.map((f) => (
              <tr>
                <th scope="row" data-etiqueta={j.horarios.columnas[0]}>{f[0]}</th>
                <td data-etiqueta={j.horarios.columnas[1]}>{f[1]}</td>
                <td data-etiqueta={j.horarios.columnas[2]}>{f[2]}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <aside class="nota nota--arena beneficio" data-revelar aria-labelledby="beneficio-titulo">
          <h3 id="beneficio-titulo" class="beneficio__titulo">{j.horarios.beneficio.titulo}</h3>
          <p class="beneficio__intro">{j.horarios.beneficio.intro}</p>
          <ul class="beneficio__lista">
            {j.horarios.beneficio.items.map((b) => (
              <li><strong class="beneficio__etiqueta">{b.etiqueta}</strong> <span>{b.texto}</span></li>
            ))}
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <LlamadoEntrevista nivel="jardin" foto="sala2-tunel-arena" titulo="Vení a conocer el Jardín" />
</Base>

<script>
  import { iniciarInclinaciones } from '../scripts/reactbits/inclinacion';
  iniciarInclinaciones();
</script>

<style>
  .portada-cita__texto { font-size: 1.093rem; font-size: clamp(1.093rem, 0.779rem + 0.84vw, 1.47rem); max-width: 36ch; color: #f6efe3; }
  .portada-cita__firma { margin-top: 0.6rem; font-weight: 600; font-size: 0.9375rem; color: var(--arena); }

  /* Presentación: notita centrada colgando del hero */
  .intro-nivel { position: relative; z-index: 3; margin-top: -3rem; margin-bottom: 3.5rem; }
  .intro-nivel__nota { max-width: 40rem; margin: 0 auto; text-align: center; }
  .intro-nivel__texto { margin: 0 auto; max-width: none; font-family: var(--f-titulo); font-size: 1.06rem; font-size: clamp(1.02rem, 0.9rem + 0.4vw, 1.25rem); line-height: 1.5; }

  /* Encabezado de cada sección: título + bajada al costado, con la línea fina debajo */
  .cabeza__titulo { max-width: 18ch; font-size: 1.9rem; font-size: clamp(1.8rem, 1.2rem + 1.9vw, 3rem); font-weight: 330; letter-spacing: -0.03em; line-height: 1.04; margin-right: 2rem; }
  .cabeza__bajada { max-width: 30rem; font-size: 0.9875rem; line-height: 1.6; color: var(--tinta-suave); }

  /* Diferencias: 3 + 2 tarjetas */
  .dif { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr; grid-gap: 1.25rem; gap: 1.25rem; }
  @media (min-width: 48em) { .dif { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64em) {
    .dif { grid-template-columns: repeat(6, 1fr); grid-gap: 1.5rem; gap: 1.5rem; }
    .dif__item { grid-column: span 2; }
    .dif__item:nth-child(4) { grid-column: 2 / span 2; }
  }

  /* El gesto espontáneo: fotos que pasan + texto al costado */
  .gesto { display: grid; grid-template-columns: 1fr; grid-gap: 2rem; gap: 2rem; align-items: center; margin-top: 4.5rem; padding-top: 3.5rem; border-top: 1px solid rgba(35, 32, 28, 0.18); }
  .gesto__fotos { min-width: 0; }
  .gesto__titulo { font-size: 1.6rem; font-size: clamp(1.5rem, 1.1rem + 1.3vw, 2.3rem); font-style: italic; font-weight: 320; margin-bottom: 1.1rem; padding-bottom: 0.9rem; border-bottom: 1px solid rgba(35, 32, 28, 0.45); }
  .gesto__texto .prosa { font-size: 0.975rem; }
  @media (min-width: 56em) { .gesto { grid-template-columns: 7fr 5fr; grid-gap: 4.5rem; gap: 4.5rem; } }

  /* Salas */
  .sala__sub { margin: 0.35rem 0 0; font-family: var(--f-titulo); font-style: italic; color: var(--acento-texto); }
  .sala__escena { margin-top: 1.5rem; }
  .sala__bloques { margin-top: 6.5rem; margin-bottom: 1.5rem; }
  .sala__bloques .bloque__n { display: block; }

  /* Lenguajes */
  .leng-indice { display: flex; flex-wrap: wrap; }
  .leng-indice a { margin: 0 1.25rem 0.35rem 0; font-size: 0.875rem; text-decoration: none; border-bottom: 1px solid rgba(35, 32, 28, 0.3); }
  .leng-indice a:hover { color: var(--acento-texto); border-color: currentColor; }
  .lenguaje + .lenguaje { margin-top: 7.5rem; }
  .lenguaje__bloques { margin-top: 6.5rem; }

  /* Patio */
  .patio { overflow: hidden; }
  .patio__galeria { margin-bottom: 3rem; }
  .patio__frase { margin-top: 1.5rem; text-align: center; font-size: 1.26rem; font-size: var(--t-lg); color: var(--verde-texto); }
  .patio__frase { max-width: none; }

  /* Adaptación: título a la izquierda, texto a la derecha */
  .adaptacion { display: grid; grid-template-columns: 1fr; grid-gap: 1.5rem; gap: 1.5rem; }
  .adaptacion__titulo { font-size: 1.9rem; font-size: clamp(1.8rem, 1.2rem + 1.9vw, 3rem); font-weight: 330; letter-spacing: -0.03em; line-height: 1.04; padding-bottom: 1rem; border-bottom: 1px solid rgba(35, 32, 28, 0.55); align-self: start; }
  .adaptacion__intro { font-size: 1.0625rem; }
  .adaptacion__desplegable { margin-top: 2rem; }
  .adaptacion__pasos { margin-top: 1.5rem; }
  @media (min-width: 56em) {
    .adaptacion { grid-template-columns: 4fr 7fr; grid-gap: 4.5rem; gap: 4.5rem; }
    .adaptacion__titulo { position: -webkit-sticky; position: sticky; top: calc(var(--header-h) + 4rem); }
  }

  /* Horarios: tabla + notita del beneficio */
  .horarios-grilla { display: grid; grid-template-columns: 1fr; grid-gap: 2.5rem; gap: 2.5rem; align-items: start; }
  @media (min-width: 64em) { .horarios-grilla { grid-template-columns: 8fr 4fr; grid-gap: 3rem; gap: 3rem; } }
  .horarios { width: 100%; border-collapse: collapse; background: #fff; box-shadow: 0 18px 40px -30px rgba(35, 32, 28, 0.45); }
  .horarios th, .horarios td { text-align: left; padding: 1.1rem 1.25rem; border-bottom: 1px solid rgba(35, 32, 28, 0.1); vertical-align: top; }
  .horarios thead th { font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--tinta-suave); font-weight: 700; border-bottom: 2px solid var(--tinta); }
  .horarios tbody th { font-family: var(--f-titulo); font-weight: 400; font-size: 1.2rem; white-space: nowrap; }
  @media (min-width: 48em) { .horarios td:nth-of-type(1) { white-space: nowrap; } }
  .horarios tbody tr:last-child th, .horarios tbody tr:last-child td { border-bottom: 0; }
  @media (max-width: 47.99em) {
    .horarios, .horarios tbody, .horarios tr, .horarios th, .horarios td { display: block; width: 100%; }
    .horarios { background: none; box-shadow: none; }
    .horarios thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .horarios tr { background: #fff; margin-bottom: 1rem; padding: 0.5rem 0; }
    .horarios th, .horarios td { border: 0; padding: 0.5rem 1.25rem; }
    .horarios td::before { content: attr(data-etiqueta); display: block; font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--tinta-suave); font-weight: 700; margin-bottom: 0.15rem; }
    .horarios tbody th { font-size: 1.2rem; padding-top: 0.9rem; }
  }
  .beneficio__titulo { font-size: 1.2rem; line-height: 1.25; margin-bottom: 0.75rem; }
  .beneficio__intro { font-size: 0.9375rem; color: var(--tinta-suave); }
  .beneficio__lista { list-style: none; padding: 0; margin: 1.1rem 0 0; }
  .beneficio__lista li { padding: 0.7rem 0; border-top: 1px solid rgba(35, 32, 28, 0.18); font-size: 0.9375rem; }
  .beneficio__etiqueta { display: block; font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ocre-texto); }
</style>
